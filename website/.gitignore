# No trailing slash: also ignores a node_modules symlink, such as one pointing a worktree at another's packages.
node_modules
.astro/
# litestar-vite dev-server handoff file (host/port/paths), regenerated on every `make dev`.
.litestar.json

# Design-build scratch: captures, diffs, crops, candidate plates and third-party reference screenshots.
# Regenerated by the impeccable build; the approved comps, spec, state and shipped plates stay tracked.
.impeccable/review/
.impeccable/refs/
.impeccable/build-comp-a/
.impeccable/build/plate-work/
.impeccable/build/plate-work-c/
.impeccable/build/map-inspections/

# Playwright output (screenshots, traces, the HTML report); regenerated by every `make web-e2e`.
test-results/
playwright-report/
