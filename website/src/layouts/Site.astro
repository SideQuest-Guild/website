---
import { getImage } from "astro:assets";
import "../styles/site.css";
import "../styles/citadel.css";
import Sprites from "../components/Sprites.astro";
import groundPlate from "../../assets/plates/strip-ground.png";
import guildLogo from "../../assets/brand/sidequest-logo.png";
import heroArt from "../../assets/plates/hero-art.png";
import displayFont from "../fonts/LibertinusSerifDisplay.woff2?url";
import bodyFont from "../fonts/EBGaramond.woff2?url";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Falls back to the WebSettings default origin so previews build correctly before `site` is wired
// up in astro.config.mjs from SITE_URL.
const origin = Astro.site ?? new URL("http://localhost:8000");
const canonicalUrl = new URL(Astro.url.pathname, origin).toString();
// The ground tiles at 512px; one 1024px WebP covers 2x screens. It always sits under a 42%+ wash (more on the
// night rooms), so quality 62 loses nothing visible and saves ~100 KB on every first visit. AVIF smears its grain.
const ground = await getImage({ src: groundPlate, width: 1024, format: "webp", quality: 62 });
const favicon = await getImage({ src: guildLogo, width: 32, format: "png" });
const touchIcon = await getImage({ src: guildLogo, width: 180, format: "png" });
const ogImage = await getImage({
  src: heroArt,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "centre",
  format: "jpeg",
  quality: 78,
});
const ogImageUrl = new URL(ogImage.src, origin).toString();
const speculationRules = {
  prerender: [
    {
      where: {
        and: [
          { href_matches: "/*" },
          { not: { href_matches: ["/api/*", "/auth/*", "/schema/*", "/health/*"] } },
          { not: { selector_matches: "[download], [target=_blank]" } },
        ],
      },
      eagerness: "moderate",
    },
  ],
};
---

<!doctype html>
<html lang="en" style={`--ground: url(${ground.src})`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151515" />
    <meta name="sq-build" content={SQ_BUILD} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SideQuest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <!-- Every page asks /api/me (the Officers link, and the member pages); start it with the HTML instead of after
         the scripts load. crossorigin="anonymous" matches apiFetch's same-origin credentials, so the fetch reuses it. -->
    <link rel="preload" as="fetch" href="/api/me" crossorigin="anonymous" />
    <slot name="head" />
    <!-- Chromium browsers prerender a page when a link to it is hovered or pressed, so walking between rooms is
         instant; others ignore this. Never for the API, sign-in/out or docs. -->
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />
    <!-- Lets CSS collapse the mobile menu only when the script that opens it will run, and shows the Officers
         link before first paint for a browser that was an officer last visit (site-chrome.ts re-checks /api/me). -->
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        if (localStorage.getItem("sq-officer") === "1") document.documentElement.classList.add("officer");
      } catch {}
    </script>
  </head>
  <body>
    <Sprites />
    <a class="skip" href="#top">
      Skip to content
    </a>
    <slot />
    <a class="to-top" href="#top" data-to-top>
      <span class="to-top-chevron" aria-hidden="true"></span>
      <span class="sr-only">Back to top</span>
    </a>
    <script>
      import "../scripts/site-chrome";
    </script>
  </body>
</html>
