---
// The guild's written pages (Rules, Privacy, Terms): a painted plate dissolving into the ground behind the title,
// then numbered articles on the reading panel with a contents rail that follows along on wide screens.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Site from "./Site.astro";
import PageHeader from "../components/PageHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { toRoman } from "../scripts/roman";

export type CharterArticle = { id: string; title: string };

interface Props {
  title: string;
  description: string;
  heading: string;
  lede: string;
  /** Shown as "In effect since …"; bump it whenever the text changes in substance. */
  effective: string;
  art: ImageMetadata;
  /** CSS object-position for the plate, so each painting's subject stays in frame. */
  artPosition?: string;
  articles: CharterArticle[];
}

const { title, description, heading, lede, effective, art, artPosition = "50% 40%", articles } = Astro.props;
---

<Site title={title} description={description}>
  <PageHeader />
  <main id="top" tabindex="-1" class="charter">
    <header class="charter-head">
      <Image
        class="charter-art"
        src={art}
        widths={[640, 1024, 1600, 2048]}
        sizes="100vw"
        loading="eager"
        alt=""
        style={`object-position: ${artPosition}`}
      />
      <div class="charter-title wrap">
        <div class="heading">
          <span class="rule" aria-hidden="true"></span>
          <h1 class="shade">{heading}</h1>
          <span class="rule flip" aria-hidden="true"></span>
        </div>
        <p class="charter-lede shade">{lede}</p>
        <p class="charter-date caps">In effect since {effective}</p>
      </div>
    </header>

    <div class="charter-body wrap">
      <nav class="charter-toc" aria-label="Contents">
        <ol>
          {articles.map((article, index) => (
            <li>
              <a href={`#${article.id}`} data-toc={article.id}>
                <span class="charter-num" aria-hidden="true">
                  {toRoman(index + 1)}
                </span>
                <span>{article.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="charter-text">
        <slot />
      </div>
    </div>
  </main>
  <SiteFooter />
</Site>

<script>
  import "../scripts/charter";
</script>
