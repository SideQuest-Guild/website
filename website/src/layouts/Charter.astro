---
// The guild's written pages (Rules, Privacy, Terms) hang in the citadel's Great Hall: the hall's painting opens the
// page, and the articles are read in one framed chamber with a contents rail that follows along on wide screens.
import type { ImageMetadata } from "astro";
import Room from "./Room.astro";
import greatHall from "../../assets/rooms/great-hall.webp";
import { toRoman } from "../scripts/roman";

export type CharterArticle = { id: string; title: string };

interface Props {
  title: string;
  description: string;
  heading: string;
  lede: string;
  /** Shown as "In effect since …" when given; omitted entirely for pages with no effective date (e.g. a guide). */
  effective?: string;
  /** Defaults to the Great Hall; every charter hangs there. */
  art?: ImageMetadata;
  artPosition?: string;
  articles: CharterArticle[];
  current?: "events" | "heroes" | "addons" | "officers" | "account" | "raids" | "guild" | "rules";
  /** Heading above the contents rail; defaults to "The Charter". */
  chamberTitle?: string;
}

const {
  title,
  description,
  heading,
  lede,
  effective,
  art = greatHall,
  artPosition = "50% 40%",
  articles,
  current,
  chamberTitle = "The Charter",
} = Astro.props;
---

<Room
  title={title}
  description={description}
  heading={heading}
  lede={lede}
  art={art}
  artPosition={artPosition}
  current={current}
>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  {effective && (
    <p slot="title" class="charter-date caps shade">
      In effect since {effective}
    </p>
  )}

  <div class="chamber charter-body">
    <h2 class="chamber-title">{chamberTitle}</h2>
    <nav class="charter-toc" aria-label="Contents">
      <ol>
        {articles.map((article, index) => (
          <li>
            <a href={`#${article.id}`} data-toc={article.id}>
              <span class="charter-num" aria-hidden="true">
                {toRoman(index + 1)}
              </span>
              <span>{article.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="charter-text">
      <slot />
    </div>
  </div>
</Room>

<script>
  import "../scripts/charter";
</script>
