---
// Every page past the homepage is a room of the citadel from the hero: its own painting opens the page under the
// nav, the title sits in the painting's lower calm, and the page continues in the same moonlit night below.
// The painting carries a shared view-transition name, so walking between rooms crossfades the art.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Site from "./Site.astro";
import PageHeader from "../components/PageHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  /** One italic line under the title. Omit for pages whose title says it all. */
  lede?: string;
  art: ImageMetadata;
  /** CSS object-position for the painting, so each room's subject stays in frame. */
  artPosition?: string;
  current?: "events" | "addons" | "officers" | "account";
  /** Runtime-titled pages (event detail): the h1 may run to a sentence, so it wraps in smaller caps. */
  longTitle?: boolean;
}

const { title, description, heading, lede, art, artPosition = "50% 45%", current, longTitle = false } = Astro.props;

// AVIF at quality 42 matches WebP at 62 by eye on these paintings at about 60% of the bytes (88 KB vs 150 KB for
// the full-width ledger chamber). One `quality` can't serve both, so the <picture> is built by hand.
const widths = [640, 960, 1280, 1698];
const [avif, webp] = await Promise.all([
  getImage({ src: art, widths, format: "avif", quality: 42 }),
  getImage({ src: art, widths, format: "webp", quality: 62 }),
]);

// A 32px copy of each painting, inlined into the page (about 200 bytes), sits behind the real one: the room opens
// with its painting already there, soft, and sharpens as the full image arrives, instead of a blank head and a pop.
// Regenerate with `cwebp -resize 32 0 -q 45 -m 6 assets/rooms/<room>.webp -o assets/rooms/lqip/<room>.webp`.
const placeholders = import.meta.glob<string>("../../assets/rooms/lqip/*.webp", {
  query: "?inline",
  import: "default",
  eager: true,
});
// The generated file keeps the painting's name (ledger-chamber.<hash>_<id>.webp). Reading `art.src` instead
// would make Astro ship the full-size original too.
const roomName = webp.src.split("/").pop()?.split(".")[0] ?? "";
const placeholder = placeholders[`../../assets/rooms/lqip/${roomName}.webp`];
if (!placeholder) {
  throw new Error(`No blur-up placeholder for room art "${roomName}" in assets/rooms/lqip/`);
}
---

<Site title={title} description={description}>
  <div class="room">
    <header class="room-head">
      <picture class="room-art-pic">
        <source type="image/avif" srcset={avif.srcSet.attribute} sizes="100vw" />
        <img
          class="room-art"
          src={webp.src}
          srcset={webp.srcSet.attribute}
          sizes="100vw"
          width={art.width}
          height={art.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          alt=""
          style={`object-position: ${artPosition}; background-image: url(${placeholder}); background-position: ${artPosition}`}
        />
      </picture>
      <PageHeader current={current} />
      <div class="room-title wrap">
        <div class="heading">
          <span class="rule" aria-hidden="true"></span>
          <h1 id="page-heading" class:list={["shade", { "heading-title": longTitle }]}>
            {heading}
          </h1>
          <span class="rule flip" aria-hidden="true"></span>
        </div>
        {lede && <p class="room-lede shade">{lede}</p>}
        <slot name="title" />
      </div>
    </header>
    <main id="top" tabindex="-1" class="room-body wrap">
      <slot />
    </main>
    <SiteFooter />
  </div>
</Site>
