---
// Every page past the homepage is a room of the citadel from the hero: its own painting opens the page under the
// nav, the title sits in the painting's lower calm, and the page continues in the same moonlit night below.
// The painting carries a shared view-transition name, so walking between rooms crossfades the art.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Site from "./Site.astro";
import PageHeader from "../components/PageHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  /** One italic line under the title. Omit for pages whose title says it all. */
  lede?: string;
  art: ImageMetadata;
  /** CSS object-position for the painting, so each room's subject stays in frame. */
  artPosition?: string;
  current?: "events" | "addons" | "officers" | "account";
  /** Runtime-titled pages (event detail): the h1 may run to a sentence, so it wraps in smaller caps. */
  longTitle?: boolean;
}

const { title, description, heading, lede, art, artPosition = "50% 45%", current, longTitle = false } = Astro.props;
---

<Site title={title} description={description}>
  <div class="room">
    <header class="room-head">
      <Image
        class="room-art"
        src={art}
        widths={[640, 1024, 1600, 2048]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        alt=""
        style={`object-position: ${artPosition}`}
      />
      <PageHeader current={current} />
      <div class="room-title wrap">
        <div class="heading">
          <span class="rule" aria-hidden="true"></span>
          <h1 id="page-heading" class:list={["shade", { "heading-title": longTitle }]}>
            {heading}
          </h1>
          <span class="rule flip" aria-hidden="true"></span>
        </div>
        {lede && <p class="room-lede shade">{lede}</p>}
        <slot name="title" />
      </div>
    </header>
    <main id="top" tabindex="-1" class="room-body wrap">
      <slot />
    </main>
    <SiteFooter />
  </div>
</Site>
