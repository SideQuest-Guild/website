---
import Room from "../../../layouts/Room.astro";
import hallOfHeroes from "../../../../assets/rooms/hall-of-heroes.webp";
import "../../../styles/room-heroes.css";
---

<Room
  title="Hero · SideQuest"
  description="A SideQuest member's Hall of Heroes profile: Renown, raids, events, level and earned badges."
  heading="HERO"
  art={hallOfHeroes}
  artPosition="50% 30%"
  current="heroes"
  longTitle
>
  <!-- Ask for the profile with the HTML, not after the page script loads; the URL matches refresh() below. -->
  <script is:inline slot="head">
    const memberId = new URLSearchParams(location.search).get("id");
    if (memberId) {
      const link = document.createElement("link");
      Object.assign(link, { rel: "preload", as: "fetch", href: `/api/heroes/${memberId}`, crossOrigin: "anonymous" });
      document.head.append(link);
    }
  </script>

  <p class="status" id="hero-status" role="status" aria-live="polite"></p>

  <div id="hero-gate" hidden>
    <section class="chamber" aria-labelledby="h-hero-gate">
      <h2 class="chamber-title" id="h-hero-gate">
        Hero
      </h2>
      <p class="chamber-intro" id="hero-gate-message"></p>
    </section>
  </div>

  <div id="hero-content" hidden>
    <section class="chamber" aria-labelledby="h-hero-sheet">
      <h2 class="chamber-title" id="h-hero-sheet">
        Character Sheet
      </h2>
      <div class="hero-sheet">
        <span class="hero-sheet-portrait" id="hero-portrait">
          <img id="hero-avatar" alt="" width="96" height="96" hidden />
          <span class="hero-avatar-empty" id="hero-avatar-fallback" aria-hidden="true" hidden></span>
        </span>
        <div class="hero-sheet-info">
          <p class="hero-sheet-name" id="hero-name"></p>
          <p class="hero-sheet-meta" id="hero-meta"></p>
        </div>
      </div>

      <h3 class="sub-title" id="hero-season-label">
        Season
      </h3>
      <div class="hero-stat-tiles" id="hero-season-tiles"></div>

      <h3 class="sub-title">All time</h3>
      <div class="hero-stat-tiles" id="hero-all-time-tiles"></div>
    </section>

    <section class="chamber" id="hero-activity-section" aria-labelledby="h-hero-activity" hidden>
      <h2 class="chamber-title" id="h-hero-activity">
        Adventurer's Log
      </h2>
      <p class="status" id="hero-activity-status" role="status" aria-live="polite"></p>

      <div id="hero-activity-body" hidden>
        <div class="hero-level-card">
          <span class="hero-level-ring" id="hero-activity-portrait">
            <svg class="hero-level-ring-svg" viewBox="0 0 80 80" aria-hidden="true">
              <circle class="hero-level-ring-track" cx="40" cy="40" r="35"></circle>
              <circle class="hero-level-ring-fill" id="hero-activity-ring-fill" cx="40" cy="40" r="35"></circle>
            </svg>
            <span class="hero-level-avatar-inner">
              <img id="hero-activity-avatar" alt="" width="60" height="60" hidden />
              <span class="hero-avatar-empty" id="hero-activity-avatar-fallback" aria-hidden="true" hidden></span>
            </span>
          </span>
          <div class="hero-level-info">
            <p class="hero-level-big" id="hero-activity-level"></p>
            <div class="level-bar-row">
              <div class="level-bar level-bar-big">
                <div class="level-bar-fill" id="hero-activity-level-fill"></div>
              </div>
              <span class="level-bar-label" id="hero-activity-level-label"></span>
            </div>
            <div class="hero-level-chips">
              <span class="hero-level-chip" id="hero-activity-rank"></span>
              <span class="hero-level-chip hero-level-chip-reward" id="hero-activity-reward"></span>
            </div>
          </div>
        </div>

        <div class="hero-activity-tiles" id="hero-activity-tiles"></div>

        <div class="hero-streak" id="hero-activity-streak"></div>

        <h3 class="sub-title">XP by source</h3>
        <div class="xp-source-bar" id="hero-xp-source-bar" role="img" aria-label="XP by source"></div>
        <ul class="xp-source-legend" id="hero-xp-source-legend"></ul>

        <h3 class="sub-title">Last 30 days</h3>
        <div
          id="hero-activity-chart"
          class="attendance-trend-chart"
          role="img"
          aria-label="Last 30 days of messages and voice hours"
        ></div>

        <h3 class="sub-title">When they're around</h3>
        <p class="aside">By weekday and hour, America/Chicago, last 90 days.</p>
        <div class="groups-heat-wrap">
          <div class="groups-heat-grid" id="hero-activity-heat-grid" role="img" aria-label="Activity heat grid"></div>
        </div>
      </div>
    </section>

    <section class="chamber" aria-labelledby="h-hero-badges">
      <h2 class="chamber-title" id="h-hero-badges">
        Badge Case
      </h2>
      <ul class="badge-case" id="hero-badge-case"></ul>
    </section>

    <section class="chamber" aria-labelledby="h-hero-recent">
      <h2 class="chamber-title" id="h-hero-recent">
        Recent Events
      </h2>
      <ul class="quest-log" id="hero-recent-events"></ul>
    </section>
  </div>

  <noscript>
    <p class="aside">Enable JavaScript to view this member's Hall of Heroes profile.</p>
  </noscript>
</Room>

<script>
  import {
    apiFetch,
    fetchMe,
    escapeHtml,
    requireElement,
    statusMessage,
    capitalize,
    ApiError,
    EVENT_KIND_LABELS,
    SEASONS,
    badgeIconId,
    type HeroProfile,
    type HeroSeasonStats,
    type HeroActivity,
    type HeroXPSources,
    type StatsHourCell,
    type EarnedBadge,
    type Me,
  } from "../../../scripts/api";
  import { onPage } from "../../../scripts/page";
  import { renderActivityChart as renderGroupedActivityChart } from "../../../scripts/activity-chart";

  function statTile(label: string, value: string): string {
    return `<div class="hero-stat-tile"><span class="hero-stat-tile-label">${escapeHtml(label)}</span><span class="hero-stat-tile-value">${escapeHtml(value)}</span></div>`;
  }

  function statTiles(stats: HeroSeasonStats): string {
    return [
      statTile("Renown", String(stats.ep)),
      statTile("Raids", String(stats.raids_attended)),
      statTile("Events", String(stats.events_attended)),
      statTile("Attendance", `${Math.round(stats.attendance_rate * 100)}%`),
    ].join("");
  }

  function badgePlaque(badge: EarnedBadge, dateFormat: Intl.DateTimeFormat): string {
    return `
    <li class="badge-plaque">
      <svg class="ico badge-plaque-icon" role="img" aria-label="${escapeHtml(badge.name)}"><use href="#${badgeIconId(badge.id)}"></use></svg>
      <span>
        <p class="badge-plaque-name">${escapeHtml(badge.name)}</p>
        <p class="badge-plaque-desc">${escapeHtml(badge.description)}</p>
        <p class="badge-plaque-date">Earned ${escapeHtml(dateFormat.format(new Date(badge.earned_at)))}</p>
      </span>
    </li>`;
  }

  // ——— Adventurer's Log (GET /api/heroes/{id}/activity): MEE6-style activity stats ———
  const WEEKDAY_LABELS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

  function hourLabel(hour: number): string {
    return hour === 0 ? "12a" : hour < 12 ? `${hour}a` : hour === 12 ? "12p" : `${hour - 12}p`;
  }

  // A small hand-drawn flame, like the voice hearths' flame on the homepage, for the streak tiles.
  function flameIcon(muted: boolean): string {
    return `<svg class="hero-streak-flame${muted ? " is-muted" : ""}" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2c1.2 3-2.6 4.2-2.6 7.4a2.6 2.6 0 0 0 5.2 0c0-.9-.6-1.7-.6-2.6 1.8 1 3 3 3 5.2a5 5 0 0 1-10 0c0-4.4 3.4-5.6 5-10z" fill="currentColor"></path></svg>`;
  }

  function activityTile(label: string, value: string, sub: string, rank: number | null, rankSuffix: string): string {
    const chip = rank !== null ? `<span class="hero-rank-chip">#${rank}${rankSuffix}</span>` : "";
    return `
      <div class="hero-activity-tile">
        <span class="hero-activity-tile-label">${escapeHtml(label)}</span>
        <span class="hero-activity-tile-value">${escapeHtml(value)}</span>
        <span class="hero-activity-tile-sub">${escapeHtml(sub)}${chip}</span>
      </div>`;
  }

  function xpSourceBar(sources: HeroXPSources): string {
    const segments: { key: keyof HeroXPSources; label: string; css: string }[] = [
      { key: "chat", label: "Chat", css: "xp-source-chat" },
      { key: "voice", label: "Voice", css: "xp-source-voice" },
      { key: "events", label: "Events", css: "xp-source-events" },
      { key: "groups", label: "Groups", css: "xp-source-groups" },
      { key: "earlier", label: "Earlier", css: "xp-source-earlier" },
    ];
    const total = Math.max(
      1,
      segments.reduce((sum, s) => sum + sources[s.key], 0),
    );
    return segments
      .filter((s) => sources[s.key] > 0)
      .map((s) => `<span class="xp-source-segment ${s.css}" style="width:${(sources[s.key] / total) * 100}%"></span>`)
      .join("");
  }

  function xpSourceLegend(sources: HeroXPSources): string {
    const segments: { key: keyof HeroXPSources; label: string; css: string }[] = [
      { key: "chat", label: "Chat", css: "xp-source-chat" },
      { key: "voice", label: "Voice", css: "xp-source-voice" },
      { key: "events", label: "Events", css: "xp-source-events" },
      { key: "groups", label: "Groups", css: "xp-source-groups" },
      { key: "earlier", label: "Earlier", css: "xp-source-earlier" },
    ];
    return segments
      .map(
        (s) => `
      <li><span class="xp-source-dot ${s.css}" aria-hidden="true"></span>${escapeHtml(s.label)}<span class="groups-stat-value">${sources[s.key].toLocaleString()} XP</span></li>`,
      )
      .join("");
  }

  function renderActivityHeatmap(el: HTMLElement, cells: StatsHourCell[]): void {
    const max = Math.max(1, ...cells.map((c) => c.messages + c.voice_minutes));
    const byCell = new Map(cells.map((c) => [`${c.weekday}-${c.hour}`, c]));
    const gridCells: string[] = [`<span class="groups-heat-corner"></span>`];
    for (let hour = 0; hour < 24; hour++) {
      gridCells.push(`<span class="groups-heat-hour-label">${hour % 3 === 0 ? hourLabel(hour) : ""}</span>`);
    }
    for (let weekday = 0; weekday < 7; weekday++) {
      gridCells.push(`<span class="groups-heat-row-label">${WEEKDAY_LABELS[weekday]}</span>`);
      for (let hour = 0; hour < 24; hour++) {
        const cell = byCell.get(`${weekday}-${hour}`);
        const weight = cell ? cell.messages + cell.voice_minutes : 0;
        const alpha = weight === 0 ? 0 : 0.15 + 0.85 * (weight / max);
        const label = cell
          ? `${WEEKDAY_LABELS[weekday]} ${hourLabel(hour)} \u2014 ${cell.messages} message${cell.messages === 1 ? "" : "s"}, ${cell.voice_minutes} voice min`
          : `${WEEKDAY_LABELS[weekday]} ${hourLabel(hour)} \u2014 quiet`;
        gridCells.push(
          `<span class="groups-heat-cell" style="background:rgba(201,162,75,${alpha})" title="${escapeHtml(label)}" aria-label="${escapeHtml(label)}"></span>`,
        );
      }
    }
    el.innerHTML = gridCells.join("");
  }

  onPage("#hero-content", (signal) => {
    const statusEl = requireElement("hero-status");
    const gateEl = requireElement("hero-gate");
    const gateMessage = requireElement("hero-gate-message");
    const contentEl = requireElement("hero-content");
    const portraitEl = requireElement("hero-portrait");
    const avatarImg = requireElement<HTMLImageElement>("hero-avatar");
    const avatarFallback = requireElement("hero-avatar-fallback");
    const nameEl = requireElement("hero-name");
    const metaEl = requireElement("hero-meta");
    const seasonLabel = requireElement("hero-season-label");
    const seasonTiles = requireElement("hero-season-tiles");
    const allTimeTiles = requireElement("hero-all-time-tiles");
    const badgeCase = requireElement("hero-badge-case");
    const recentList = requireElement("hero-recent-events");

    const activitySectionEl = requireElement("hero-activity-section");
    const activityStatusEl = requireElement("hero-activity-status");
    const activityBodyEl = requireElement("hero-activity-body");
    const activityPortraitEl = requireElement("hero-activity-portrait");
    const activityRingFillEl = document.getElementById("hero-activity-ring-fill") as unknown as SVGCircleElement;
    const activityAvatarImg = requireElement<HTMLImageElement>("hero-activity-avatar");
    const activityAvatarFallback = requireElement("hero-activity-avatar-fallback");
    const activityLevelEl = requireElement("hero-activity-level");
    const activityLevelFill = requireElement("hero-activity-level-fill");
    const activityLevelLabel = requireElement("hero-activity-level-label");
    const activityRankEl = requireElement("hero-activity-rank");
    const activityRewardEl = requireElement("hero-activity-reward");
    const activityTilesEl = requireElement("hero-activity-tiles");
    const activityStreakEl = requireElement("hero-activity-streak");
    const xpSourceBarEl = requireElement("hero-xp-source-bar");
    const xpSourceLegendEl = requireElement("hero-xp-source-legend");
    const activityChartEl = requireElement("hero-activity-chart");
    const activityHeatGridEl = requireElement("hero-activity-heat-grid");

    const memberId = new URLSearchParams(location.search).get("id");
    const dateFormat = new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric", year: "numeric" });

    function renderActivity(profile: HeroProfile, activity: HeroActivity): void {
      activityPortraitEl.style.setProperty(
        "--class-color",
        profile.wow_class ? `var(--c-${profile.wow_class})` : "transparent",
      );
      if (profile.avatar_url) {
        activityAvatarImg.src = profile.avatar_url;
        activityAvatarImg.hidden = false;
        activityAvatarFallback.hidden = true;
      } else {
        activityAvatarImg.hidden = true;
        activityAvatarFallback.hidden = false;
        activityAvatarFallback.textContent = profile.display_name.trim().charAt(0).toUpperCase() || "?";
      }

      activityLevelEl.textContent = `Lv. ${activity.level}`;
      const haveNextLevel = activity.xp_for_next_level > 0;
      const pct = haveNextLevel
        ? Math.min(100, Math.round((activity.xp_into_level / activity.xp_for_next_level) * 100))
        : 100;
      activityLevelFill.style.width = `${pct}%`;
      activityLevelLabel.textContent = haveNextLevel
        ? `${activity.xp_into_level.toLocaleString()} / ${activity.xp_for_next_level.toLocaleString()} XP`
        : `${activity.xp.toLocaleString()} XP`;
      // The ring's own radius drives the circumference, so the markup's r can change without touching this math.
      const ringCircumference = 2 * Math.PI * activityRingFillEl.r.baseVal.value;
      activityRingFillEl.style.strokeDasharray = `${ringCircumference}`;
      activityRingFillEl.style.strokeDashoffset = `${ringCircumference * (1 - pct / 100)}`;
      activityRankEl.textContent =
        activity.xp_rank !== null ? `#${activity.xp_rank} of ${activity.ranked_members} by XP` : "Not yet ranked by XP";
      activityRewardEl.textContent = activity.next_reward
        ? `Next reward at level ${activity.next_reward.level}: ${activity.next_reward.role_name}`
        : "";

      activityTilesEl.innerHTML = [
        activityTile(
          "Messages",
          activity.message_count.toLocaleString(),
          `${activity.messages_30d.toLocaleString()} in 30 days`,
          activity.chat_rank_30d,
          " in 30d",
        ),
        activityTile(
          "Voice hours",
          `${(activity.voice_minutes / 60).toFixed(1)}h`,
          `${(activity.voice_minutes_30d / 60).toFixed(1)}h in 30 days`,
          activity.voice_rank_30d,
          " in 30d",
        ),
        activityTile("Events attended", String(activity.events_attended), "All time", null, ""),
        activityTile("Groups joined", String(activity.groups_joined), "All time", null, ""),
      ].join("");

      activityStreakEl.innerHTML = `
        <div class="hero-streak-tile">
          ${flameIcon(activity.current_streak_days === 0)}
          <span class="hero-streak-text">
            <span class="hero-activity-tile-label">Current streak</span>
            <span class="hero-activity-tile-value">${activity.current_streak_days} day${activity.current_streak_days === 1 ? "" : "s"}</span>
          </span>
        </div>
        <div class="hero-streak-tile">
          ${flameIcon(activity.longest_streak_days === 0)}
          <span class="hero-streak-text">
            <span class="hero-activity-tile-label">Longest streak</span>
            <span class="hero-activity-tile-value">${activity.longest_streak_days} day${activity.longest_streak_days === 1 ? "" : "s"}</span>
          </span>
        </div>`;

      xpSourceBarEl.innerHTML = xpSourceBar(activity.xp_sources);
      xpSourceLegendEl.innerHTML = xpSourceLegend(activity.xp_sources);

      renderGroupedActivityChart(
        activityChartEl,
        activity.days.map((d) => ({ date: d.day, messages: d.messages, voice_minutes: d.voice_minutes })),
      );
      renderActivityHeatmap(activityHeatGridEl, activity.heatmap);
    }

    async function refresh(): Promise<void> {
      if (!memberId) {
        statusEl.textContent = "No member specified.";
        return;
      }
      let me: Me | null = null;
      try {
        me = await fetchMe();
      } catch (err) {
        if (err instanceof ApiError && err.status === 0) {
          statusEl.textContent = statusMessage(err);
          return;
        }
        me = null;
      }
      if (!me) {
        gateEl.hidden = false;
        contentEl.hidden = true;
        const next = encodeURIComponent(location.pathname + location.search);
        gateMessage.innerHTML = `Guild stats and badges are for members only. <a href="/auth/discord/login?next=${next}">Sign in with Discord</a> to see this hero.`;
        statusEl.textContent = "";
        return;
      }
      gateEl.hidden = true;

      // Fetched alongside the profile; the `.then`/`.catch` attach synchronously so a failure here is never an
      // unhandled rejection, and never blocks the rest of the page.
      const activityPromise: Promise<{ ok: true; data: HeroActivity } | { ok: false; error: unknown }> =
        apiFetch<HeroActivity>(`/api/heroes/${memberId}/activity`, { signal })
          .then((data) => ({ ok: true as const, data }))
          .catch((error: unknown) => ({ ok: false as const, error }));

      let profile: HeroProfile;
      try {
        profile = await apiFetch<HeroProfile>(`/api/heroes/${memberId}`, { signal });
      } catch (err) {
        contentEl.hidden = true;
        statusEl.textContent = statusMessage(err);
        return;
      }
      statusEl.textContent = "";
      contentEl.hidden = false;

      const headingEl = requireElement<HTMLHeadingElement>("page-heading");
      headingEl.textContent = profile.display_name;
      headingEl.classList.add("heading-title");
      document.title = `${profile.display_name} · SideQuest`;

      portraitEl.style.borderColor = profile.wow_class ? `var(--c-${profile.wow_class})` : "";
      if (profile.avatar_url) {
        avatarImg.src = profile.avatar_url;
        avatarImg.hidden = false;
        avatarFallback.hidden = true;
      } else {
        avatarImg.hidden = true;
        avatarFallback.hidden = false;
        avatarFallback.textContent = profile.display_name.trim().charAt(0).toUpperCase() || "?";
      }
      nameEl.textContent = profile.display_name;
      if (profile.wow_class) {
        nameEl.className = `hero-sheet-name cls-${profile.wow_class}`;
      } else {
        nameEl.className = "hero-sheet-name";
      }

      const classLabel = profile.wow_class ? capitalize(profile.wow_class) : "No class yet";
      const rankLabel = profile.rank !== null ? `Rank #${profile.rank} this season` : "Unranked this season";
      metaEl.textContent = `${classLabel} · ${rankLabel}`;

      const currentSeasonId = Object.keys(profile.seasons).at(-1);
      const currentSeasonStats = currentSeasonId ? profile.seasons[currentSeasonId] : undefined;
      seasonLabel.textContent = SEASONS.find((s) => s.id === currentSeasonId)?.name ?? "This season";
      seasonTiles.innerHTML = currentSeasonStats
        ? statTiles(currentSeasonStats)
        : `<p class="aside">No stats for this season yet.</p>`;
      allTimeTiles.innerHTML = statTiles(profile.all_time);

      badgeCase.innerHTML =
        profile.badges.length > 0
          ? profile.badges.map((b) => badgePlaque(b, dateFormat)).join("")
          : `<li class="aside">No badges earned yet. They show up here as they're announced in Discord.</li>`;

      recentList.innerHTML =
        profile.recent_events.length > 0
          ? profile.recent_events
              .map(
                (e) => `
        <li>
          <a class="quest" href="/events/detail/?id=${e.id}">
            <svg class="ico ico-quest is-done" aria-hidden="true"><use href="#i-quest-done"></use></svg>
            <span>
              <span class="quest-name">${escapeHtml(e.title)}</span>
              <span class="quest-meta">${escapeHtml(EVENT_KIND_LABELS[e.kind])} · ${e.ep} Renown</span>
            </span>
            <span class="quest-when">${escapeHtml(dateFormat.format(new Date(e.starts_at)))}</span>
          </a>
        </li>`,
              )
              .join("")
          : `<li class="quest-empty">No events attended yet.</li>`;

      activitySectionEl.hidden = false;
      activityStatusEl.textContent = "Loading…";
      activityBodyEl.hidden = true;
      const activityResult = await activityPromise;
      if (activityResult.ok) {
        // Reveal before rendering so the SVG charts measure their real, laid-out width.
        activityBodyEl.hidden = false;
        renderActivity(profile, activityResult.data);
        activityStatusEl.textContent = "";
      } else {
        activityStatusEl.textContent = statusMessage(activityResult.error);
        activityBodyEl.hidden = true;
      }
    }

    refresh();
  });
</script>
