---
import { getImage } from "astro:assets";
import Room from "../../layouts/Room.astro";
import Art from "../../components/Art.astro";
import armory from "../../../assets/rooms/armory.webp";
import courierLoft from "../../../assets/rooms/courier-loft.webp";
import guildCrest from "../../../assets/brand/sidequest-logo.png";
import "../../styles/addon-tooltip.css";
import "../../styles/room-addons.css";

// The crest is the guild addon's inventory icon; the cards are drawn client-side, so they get its URL.
const crest = await getImage({ src: guildCrest, width: 112, format: "webp" });
---

<Room
  title="Addons · SideQuest"
  description="Download SideQuest's guild addon and the community addons it suggests for World of Warcraft: Forever."
  heading="ADDONS"
  lede="The guild's own addon, plus the community addons it asks raiders to run or suggests for raiding, leveling and PvP. New versions are announced in the Discord."
  art={armory}
  current="addons"
>
  <section class="chamber" aria-labelledby="h-armory">
    <h2 class="chamber-title" id="h-armory">
      The Armory
    </h2>
    <div class="armory-layout">
      <div class="addon-groups" id="addons-list" aria-live="polite" data-crest={crest.src}></div>
      <aside class="pairing" aria-labelledby="h-pairing">
        <Art
          src={courierLoft}
          alt=""
          class="pairing-art"
          widths={[640, 960, 1280]}
          sizes="(max-width: 900px) 100vw, 60vw"
        />
        <div class="pairing-copy">
          <h3 class="pairing-title" id="h-pairing">
            SideQuest Companion
          </h3>
          <p>
            The guild's tray app for Windows, macOS and Linux. It checks for new versions of the addon and installs them
            for you, keeps itself up to date, and reminds you before raids you've signed up for.
          </p>
          <p>Officers also get auto-sync: each raid record the addon saves is on this site within seconds.</p>
          <div class="form-actions">
            <a class="btn btn-small" href="/companion/">
              Get Companion
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <noscript>
    <p class="aside">Enable JavaScript to see the addon list.</p>
  </noscript>
</Room>

<script>
  import {
    apiFetch,
    onFreshData,
    escapeHtml,
    requireElement,
    statusMessage,
    ADDON_CATEGORIES,
    ADDON_CATEGORY_LABELS,
    type Addon,
    type AddonCategory,
  } from "../../scripts/api";
  import { addonTooltip } from "../../scripts/addon-card";
  import { onPage } from "../../scripts/page";

  function emptySlot(label: string, text: string): string {
    return `<div class="armory-empty"><p class="armory-empty-label">${escapeHtml(label)}</p><p>${escapeHtml(text)}</p></div>`;
  }

  // One rack per category, in contract order; guild-made addons first within a rack, then the API's name order.
  function addonGroup(category: AddonCategory, addons: Addon[], crestSrc: string | undefined): string {
    const headingId = `h-addons-${category}`;
    const cards = addons
      .toSorted((a, b) => Number(b.origin === "guild") - Number(a.origin === "guild"))
      .map((addon) => addonTooltip(addon, crestSrc))
      .join("");
    return `
      <section class="addon-group" aria-labelledby="${headingId}">
        <h3 class="sub-title" id="${headingId}">${escapeHtml(ADDON_CATEGORY_LABELS[category])}</h3>
        <ul class="addon-rack">${cards}</ul>
      </section>`;
  }

  async function loadAddons(): Promise<void> {
    const list = requireElement("addons-list");
    try {
      const addons = await apiFetch<Addon[]>("/api/addons");
      if (addons.length === 0) {
        list.innerHTML = emptySlot(
          "Empty",
          "The racks stand empty for now. The guild's addons will be posted here, and announced in the Discord, once they're ready.",
        );
        return;
      }
      list.innerHTML = ADDON_CATEGORIES.map(
        (category) => [category, addons.filter((addon) => addon.category === category)] as const,
      )
        .filter(([, group]) => group.length > 0)
        .map(([category, group]) => addonGroup(category, group, list.dataset.crest))
        .join("");
    } catch (err) {
      list.innerHTML = emptySlot("Unavailable", statusMessage(err));
    }
  }

  onPage("#addons-list", () => {
    onFreshData("/api/addons", () => void loadAddons());
    void loadAddons();
  });
</script>
