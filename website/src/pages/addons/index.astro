---
import Room from "../../layouts/Room.astro";
import armory from "../../../assets/rooms/armory.webp";
import "../../styles/room-addons.css";
---

<Room
  title="Addons · SideQuest"
  description="Download SideQuest's guild addons for World of Warcraft: Forever."
  heading="ADDONS"
  lede="The guild's own addons, so everyone raids on the same setup. New versions are announced in the Discord."
  art={armory}
  current="addons"
>
  <section class="chamber" aria-labelledby="h-armory">
    <h2 class="chamber-title" id="h-armory">
      The Armory
    </h2>
    <ul class="tooltip-grid" id="addons-list" aria-live="polite"></ul>
  </section>

  <noscript>
    <p class="aside">Enable JavaScript to see the addon list.</p>
  </noscript>
</Room>

<script>
  import {
    apiFetch,
    onFreshData,
    escapeHtml,
    requireElement,
    statusMessage,
    ADDON_ORIGIN_LABELS,
    type Addon,
  } from "../../scripts/api";
  import { onPage } from "../../scripts/page";

  function addonCard(addon: Addon): string {
    const homepage = addon.homepage_url
      ? `<a class="btn-quiet btn-small" href="${escapeHtml(addon.homepage_url)}">Homepage</a>`
      : "";
    const originClass = addon.origin === "guild" ? "tt-origin tt-origin-guild" : "tt-origin tt-origin-community";
    return `
      <li class="tooltip-card">
        <p class="tt-name">${escapeHtml(addon.name)}</p>
        <p class="${originClass}">${escapeHtml(ADDON_ORIGIN_LABELS[addon.origin])}</p>
        <p class="tt-version">Version ${escapeHtml(addon.version)}</p>
        <p class="tt-flavor">“${escapeHtml(addon.summary)}”</p>
        <div class="form-actions">
          <a class="btn btn-small" href="${escapeHtml(addon.download_url)}">Download</a>
          ${homepage}
        </div>
      </li>`;
  }

  function emptySlot(label: string, text: string): string {
    return `<li class="armory-empty"><p class="armory-empty-label">${escapeHtml(label)}</p><p>${escapeHtml(text)}</p></li>`;
  }

  /** Guild-made addons rack first, then community picks; each group keeps the API's name order. */
  function sortedAddons(addons: Addon[]): Addon[] {
    return addons.toSorted((a, b) => Number(b.origin === "guild") - Number(a.origin === "guild"));
  }

  async function loadAddons(): Promise<void> {
    const list = requireElement("addons-list");
    try {
      const addons = await apiFetch<Addon[]>("/api/addons");
      list.innerHTML =
        addons.length > 0
          ? sortedAddons(addons).map(addonCard).join("")
          : emptySlot(
              "Empty",
              "The racks stand empty for now. The guild's addons will be posted here, and announced in the Discord, once they're ready.",
            );
    } catch (err) {
      list.innerHTML = emptySlot("Unavailable", statusMessage(err));
    }
  }

  onPage("#addons-list", () => {
    onFreshData("/api/addons", () => void loadAddons());
    void loadAddons();
  });
</script>
