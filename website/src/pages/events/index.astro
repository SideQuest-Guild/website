---
import Room from "../../layouts/Room.astro";
import warRoom from "../../../assets/rooms/war-room.webp";
---

<Room
  title="Events · SideQuest"
  description="Upcoming and past SideQuest guild events: raid nights, dungeons, leveling groups, PvP and social nights."
  heading="EVENTS"
  lede="Raid nights, dungeons, leveling groups, PvP and social nights, pinned to the war table as the guild plans them."
  art={warRoom}
  artPosition="50% 55%"
  current="events"
>
  <section class="chamber" aria-labelledby="h-upcoming">
    <h2 class="chamber-title" id="h-upcoming">
      Upcoming
    </h2>
    <nav aria-label="Filter by kind">
      <ul class="tabs" id="kind-filter-list">
        <li>
          <a href="/events/" data-kind="">
            All
          </a>
        </li>
        <li>
          <a href="/events/?kind=raid" data-kind="raid">
            Raids
          </a>
        </li>
        <li>
          <a href="/events/?kind=dungeon" data-kind="dungeon">
            Dungeons
          </a>
        </li>
        <li>
          <a href="/events/?kind=leveling" data-kind="leveling">
            Leveling
          </a>
        </li>
        <li>
          <a href="/events/?kind=pvp" data-kind="pvp">
            PvP
          </a>
        </li>
        <li>
          <a href="/events/?kind=social" data-kind="social">
            Social
          </a>
        </li>
        <li>
          <a href="/events/?kind=other" data-kind="other">
            Other
          </a>
        </li>
      </ul>
    </nav>
    <ul class="quest-log" id="events-upcoming" aria-live="polite"></ul>
    <p class="chamber-note aside">
      Sign in with Discord on the <a href="/account/">account page</a> to sign up for an event.
    </p>
  </section>

  <section class="chamber" aria-labelledby="h-past">
    <h2 class="chamber-title" id="h-past">
      Past
    </h2>
    <ul class="quest-log" id="events-past" aria-live="polite"></ul>
  </section>

  <noscript>
    <p class="aside">Enable JavaScript to load the event schedule here, or check the Discord.</p>
  </noscript>
</Room>

<script>
  import {
    apiFetch,
    escapeHtml,
    requireElement,
    statusMessage,
    EVENT_KIND_LABELS,
    ROLE_KINDS,
    type EventKind,
    type EventSummary,
  } from "../../scripts/api";
  import { weekdayPhrase } from "../../scripts/series";

  const params = new URLSearchParams(location.search);
  const requestedKind = params.get("kind");
  const kind: EventKind | null =
    requestedKind && requestedKind in EVENT_KIND_LABELS ? (requestedKind as EventKind) : null;

  for (const link of document.querySelectorAll<HTMLAnchorElement>("#kind-filter-list a")) {
    if (link.dataset.kind === (kind ?? "")) {
      link.setAttribute("aria-current", "page");
    }
  }

  const dayFormat = new Intl.DateTimeFormat(undefined, { weekday: "short", month: "short", day: "numeric" });
  const timeFormat = new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" });

  // Quest-giver marks: a gold "!" for an event still open to sign-ups, a dim "?" once it has run.
  function questMark(event: EventSummary): string {
    const open = event.status === "scheduled" && new Date(event.starts_at).getTime() > Date.now();
    return `<svg class="ico ico-quest${open ? "" : " is-done"}" aria-hidden="true"><use href="#${open ? "i-quest" : "i-quest-done"}"></use></svg>`;
  }

  function eventRow(event: EventSummary): string {
    const start = new Date(event.starts_at);
    const signupCounts = ROLE_KINDS.includes(event.kind)
      ? `${event.counts.tank}T · ${event.counts.healer}H · ${event.counts.dps}D${
          event.counts.tentative > 0 ? ` · ${event.counts.tentative} tentative` : ""
        }`
      : `${event.counts.signed} going${event.counts.tentative > 0 ? ` · ${event.counts.tentative} maybe` : ""}`;
    const counts =
      event.counts.interested > 0 ? `${signupCounts} · ${event.counts.interested} interested on Discord` : signupCounts;
    const statusSuffix =
      event.status === "scheduled" ? "" : ` · ${event.status === "cancelled" ? "Cancelled" : "Completed"}`;
    const seriesText = event.series ? weekdayPhrase(event.series.weekdays, event.series.interval_weeks) : "";
    const meta = [EVENT_KIND_LABELS[event.kind], event.location, seriesText, counts].filter(Boolean).join(" · ");
    return `
      <li>
        <a class="quest" href="/events/detail/?id=${event.id}">
          ${questMark(event)}
          <span>
            <span class="quest-name">${escapeHtml(event.title)}${escapeHtml(statusSuffix)}</span>
            <span class="quest-meta">${escapeHtml(meta)}</span>
          </span>
          <span class="quest-when">${escapeHtml(timeFormat.format(start))}<small>${escapeHtml(dayFormat.format(start))}</small></span>
        </a>
      </li>`;
  }

  async function loadEvents(when: "upcoming" | "past", listId: string, emptyText: string): Promise<void> {
    const list = requireElement(listId);
    const query = `/api/events?when=${when}${kind ? `&kind=${kind}` : ""}`;
    try {
      const events = await apiFetch<EventSummary[]>(query);
      list.innerHTML = events.length > 0 ? events.map(eventRow).join("") : `<li class="quest-empty">${emptyText}</li>`;
    } catch (err) {
      list.innerHTML = `<li class="quest-empty">${escapeHtml(statusMessage(err))}</li>`;
    }
  }

  loadEvents("upcoming", "events-upcoming", "Nothing on the war table yet. Events appear here as they're planned.");
  loadEvents("past", "events-past", "No past events yet.");
</script>
