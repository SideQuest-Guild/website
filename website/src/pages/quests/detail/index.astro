---
import Room from "../../../layouts/Room.astro";
import musterYard from "../../../../assets/rooms/muster-yard.webp";
import "../../../styles/room-quests.css";
---

<Room
  title="Quest · SideQuest"
  description="A quest's description, requirements and rewards, straight from Battle.net."
  heading="QUEST"
  art={musterYard}
  artPosition="50% 42%"
  current="quests"
>
  <script is:inline slot="head">
    const questId = new URLSearchParams(location.search).get("id");
    if (questId) {
      const link = document.createElement("link");
      Object.assign(link, { rel: "preload", as: "fetch", href: `/api/quests/${questId}`, crossOrigin: "anonymous" });
      document.head.append(link);
    }
  </script>

  <p class="status" id="quest-detail-status" role="status" aria-live="polite"></p>

  <div id="quest-detail-content" hidden>
    <section class="chamber" aria-labelledby="h-quest">
      <h2 class="chamber-title" id="h-quest">
        Quest
      </h2>
      <div id="quest-detail-card"></div>
      <p class="quest-wowhead-link">
        <!-- Wowhead's script puts its icon on every wowhead.com link; saying it's already there keeps it off the button. -->
        <a
          id="quest-wowhead-link"
          href="#"
          target="_blank"
          rel="noreferrer"
          data-astro-reload
          data-wh-icon-added="true"
        >
          View on Wowhead
        </a>
      </p>
    </section>
  </div>

  <noscript>
    <p class="aside">Enable JavaScript to view this quest.</p>
  </noscript>
</Room>

<script>
  import {
    apiFetch,
    ApiError,
    copperToGold,
    escapeHtml,
    requireElement,
    statusMessage,
    type Quest,
    type QuestRequirementRef,
  } from "../../../scripts/api";
  import { itemLink, loadWowheadTooltips, refreshWowheadLinks } from "../../../scripts/items";
  import { onPage } from "../../../scripts/page";
  import { questLink } from "../../../scripts/reference";

  function groupedRequirements(requires: QuestRequirementRef[]): string {
    const rendered = new Set<number>();
    const rows: string[] = [];
    for (const req of requires) {
      if (rendered.has(req.id)) {
        continue;
      }
      if (req.group === null) {
        rendered.add(req.id);
        rows.push(`<li>${questLink(req.id, req.title)}</li>`);
        continue;
      }
      const alternatives = requires.filter((r) => r.group === req.group);
      for (const alt of alternatives) {
        rendered.add(alt.id);
      }
      rows.push(`<li>One of: ${alternatives.map((r) => questLink(r.id, r.title)).join(", ")}</li>`);
    }
    return rows.join("");
  }

  function renderChain(quest: Quest): string {
    if (quest.chain.length === 0 && quest.leads_to.length === 0) {
      return "";
    }
    const before = quest.chain.map((q) => questLink(q.id, q.title)).join(" \u2192 ");
    const after = quest.leads_to.map((q) => questLink(q.id, q.title)).join(", ");
    return `
      <h3>Part of a chain</h3>
      <p class="quest-chain">${before ? `${before} \u2192 ` : ""}<strong>${escapeHtml(quest.title)}</strong>${after ? ` \u2192 ${after}` : ""}</p>`;
  }

  function renderRequirements(quest: Quest): string {
    if (quest.requires.length === 0 && quest.excludes.length === 0) {
      return "";
    }
    const requires = quest.requires.length
      ? `<h3>Requires</h3><ul class="quest-requirements-list">${groupedRequirements(quest.requires)}</ul>`
      : "";
    const excludes = quest.excludes.length
      ? `<h3>Not available if you've done</h3><ul class="quest-requirements-list">${quest.excludes.map((q) => `<li>${questLink(q.id, q.title)}</li>`).join("")}</ul>`
      : "";
    return requires + excludes;
  }

  function renderQuest(quest: Quest): void {
    const meta = [quest.area, quest.category, quest.type].filter(Boolean).join(" \u00b7 ");
    const levels =
      quest.min_level !== null || quest.max_level !== null
        ? `Level ${quest.min_level ?? "?"}\u2013${quest.max_level ?? "?"}`
        : "";
    const flags = [
      quest.is_repeatable ? "Repeatable" : "",
      quest.is_daily ? "Daily" : "",
      quest.is_weekly ? "Weekly" : "",
    ]
      .filter(Boolean)
      .map((label) => `<span class="quest-flag">${label}</span>`)
      .join("");
    const rewards = quest.rewards;
    const rewardLines = [
      rewards.experience ? `<li>${rewards.experience.toLocaleString()} XP</li>` : "",
      rewards.money ? `<li>${copperToGold(rewards.money)}</li>` : "",
      ...rewards.items.map((item) => `<li>${itemLink(item.item_id, item.name)}</li>`),
      ...rewards.reputations.map(
        (rep) => `<li>${rep.value >= 0 ? "+" : ""}${rep.value} ${escapeHtml(rep.faction)} reputation</li>`,
      ),
    ].join("");
    requireElement("quest-detail-card").innerHTML = `
      <p class="quest-detail-name">${escapeHtml(quest.title)}</p>
      ${meta ? `<p class="quest-detail-meta">${escapeHtml(meta)}${levels ? ` \u00b7 ${levels}` : ""}</p>` : levels ? `<p class="quest-detail-meta">${levels}</p>` : ""}
      ${flags ? `<div class="quest-flags">${flags}</div>` : ""}
      ${renderChain(quest)}
      ${quest.description ? `<p class="quest-detail-description">${escapeHtml(quest.description)}</p>` : ""}
      ${renderRequirements(quest)}
      ${rewardLines ? `<h3>Rewards</h3><ul class="quest-rewards-list">${rewardLines}</ul>` : ""}`;
    requireElement<HTMLAnchorElement>("quest-wowhead-link").href = `https://www.wowhead.com/forever/quest=${quest.id}`;
    refreshWowheadLinks();
  }

  onPage("#quest-detail-status", (signal) => {
    const statusEl = requireElement("quest-detail-status");
    const contentEl = requireElement("quest-detail-content");

    async function init(): Promise<void> {
      const id = new URLSearchParams(location.search).get("id");
      if (!id) {
        statusEl.textContent = "No quest was given.";
        return;
      }
      statusEl.textContent = "Loading\u2026";
      void loadWowheadTooltips();
      try {
        const quest = await apiFetch<Quest>(`/api/quests/${id}`, { signal });
        renderQuest(quest);
        contentEl.hidden = false;
        statusEl.textContent = "";
      } catch (err) {
        if (err instanceof ApiError && err.status === 404) {
          statusEl.textContent = "There's no such quest.";
        } else if (err instanceof ApiError && err.status === 503) {
          statusEl.textContent = "Battle.net isn't answering right now, so this quest can't be shown. Try again soon.";
        } else {
          statusEl.textContent = statusMessage(err);
        }
      }
    }

    void init();
  });
</script>
