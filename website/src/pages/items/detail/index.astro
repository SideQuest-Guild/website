---
import Room from "../../../layouts/Room.astro";
import armory from "../../../../assets/rooms/armory.webp";
import "../../../styles/addon-tooltip.css";
import "../../../styles/room-items.css";
---

<Room
  title="Item · SideQuest"
  description="An item's stats, tooltip and who in SideQuest has looted it."
  heading="ITEM"
  art={armory}
  artPosition="50% 42%"
  current="items"
>
  <!-- Ask for the item (and who got it) with the HTML, not after the page script loads; the URLs match init()
       below. -->
  <script is:inline slot="head">
    const itemId = new URLSearchParams(location.search).get("id");
    if (itemId) {
      for (const href of [`/api/items/${itemId}`, `/api/epgp/loot?item_id=${itemId}&limit=50`]) {
        const link = document.createElement("link");
        Object.assign(link, { rel: "preload", as: "fetch", href, crossOrigin: "anonymous" });
        document.head.append(link);
      }
    }
  </script>

  <p class="status" id="item-detail-status" role="status" aria-live="polite"></p>

  <div id="item-detail-content" hidden>
    <section class="chamber" aria-labelledby="h-item">
      <h2 class="chamber-title" id="h-item">
        Item
      </h2>
      <div class="tooltip-card" id="item-tooltip-card"></div>
      <p class="item-wowhead-link">
        <!-- Wowhead's script puts its icon on every wowhead.com link; saying it's already there keeps it off the button. -->
        <a id="item-wowhead-link" href="#" target="_blank" rel="noreferrer" data-astro-reload data-wh-icon-added="true">
          View on Wowhead
        </a>
      </p>
    </section>

    <section class="chamber" aria-labelledby="h-wishlist">
      <h2 class="chamber-title" id="h-wishlist">
        Want this?
      </h2>
      <p class="aside">
        Wishing for an item doesn't change the loot rules or the SQL addon. It just lets officers see who wants it next
        to their EP/GP when it drops.
      </p>
      <p class="aside" id="wishlist-signed-out" hidden></p>
      <div id="wishlist-member" hidden>
        <p class="status" id="wishlist-status" role="status" aria-live="polite"></p>
        <form id="wishlist-form" class="wishlist-form">
          <label>
            Note (optional)
            <input type="text" id="wishlist-note" maxlength="200" placeholder="e.g. for my tank off-spec" />
          </label>
          <button type="submit" class="btn-quiet" id="wishlist-save-btn">
            Add to wishlist
          </button>
          <button type="button" class="btn-quiet btn-danger" id="wishlist-remove-btn" hidden>
            Remove
          </button>
        </form>
      </div>
    </section>

    <section class="chamber" aria-labelledby="h-wishers" id="wishers-section" hidden>
      <h2 class="chamber-title" id="h-wishers">
        Who wants it
      </h2>
      <ul class="item-wishers-list" id="item-wishers-list" aria-label="Who wants this item"></ul>
    </section>

    <section class="chamber" aria-labelledby="h-who-got-it">
      <h2 class="chamber-title" id="h-who-got-it">
        Who got it
      </h2>
      <ul class="item-loot-list" id="item-loot-list" aria-label="Who has looted this item"></ul>
    </section>
  </div>

  <noscript>
    <p class="aside">Enable JavaScript to view this item.</p>
  </noscript>
</Room>

<script>
  import {
    apiFetch,
    ApiError,
    copperToGold,
    escapeHtml,
    fetchMe,
    qualityClass,
    requireElement,
    statusMessage,
    type EpgpLootItem,
    type EpgpLootPage,
    type Item,
    type ItemWish,
    type ItemWisher,
    type Me,
  } from "../../../scripts/api";
  import { loadWowheadTooltips, refreshWowheadLinks } from "../../../scripts/items";
  import { onPage } from "../../../scripts/page";

  const RESPONSE_LABELS: Record<string, string> = {
    ms: "Main spec",
    os: "Off spec",
    alt: "Alt fill",
    council: "Council",
    de: "Disenchanted",
    bank: "Banked",
  };

  function renderItem(item: Item): void {
    const cls = qualityClass(item.quality);
    const icon = item.icon_url
      ? `<img src="${escapeHtml(item.icon_url)}" alt="" width="56" height="56" />`
      : `<span class="item-icon-placeholder">No icon</span>`;
    const requires = item.required_level > 0 ? ` \u00b7 Requires level ${item.required_level}` : "";
    const tooltipLines = item.tooltip.map((line) => `<p class="item-tooltip-line">${escapeHtml(line)}</p>`).join("");
    requireElement("item-tooltip-card").innerHTML = `
      <div class="item-detail-head">
        <span class="tt-icon">${icon}</span>
        <div>
          <p class="item-detail-name q-${cls}">${escapeHtml(item.name)}</p>
          <p class="item-detail-meta">${escapeHtml(item.item_class)} \u2013 ${escapeHtml(item.item_subclass)} \u00b7 ${escapeHtml(item.inventory_type_name)} \u00b7 Item level ${item.item_level}${requires}</p>
        </div>
      </div>
      ${tooltipLines ? `<div class="item-tooltip-lines">${tooltipLines}</div>` : ""}
      <p class="item-sell-price">Sells for ${copperToGold(item.sell_price)}</p>
      ${lootPrice(item)}`;
    requireElement<HTMLAnchorElement>("item-wowhead-link").href =
      `https://www.wowhead.com/forever/item=${item.item_id}`;
    refreshWowheadLinks();
  }

  function lootPrice(item: Item): string {
    const price = item.loot_price;
    if (!price) {
      return "";
    }
    return `
      <p class="item-loot-price">
        SQL price if it drops in a raid: <strong>${price.main_spec} GP</strong> main spec \u00b7
        ${price.off_spec} GP off spec \u00b7 ${price.chase} GP if officers call it a chase item
      </p>`;
  }

  function lootRow(item: EpgpLootItem): string {
    const who = escapeHtml(item.member_name ?? item.character);
    const where = [item.instance_name, item.encounter_name].filter(Boolean).join(" \u2013 ");
    return `
      <li class="item-loot-row${item.voided ? " is-voided" : ""}">
        <span class="item-loot-who">${who}</span>
        <span class="item-loot-meta">${escapeHtml(RESPONSE_LABELS[item.response] ?? item.response)} \u00b7 ${item.gp} GP${where ? ` \u00b7 ${escapeHtml(where)}` : ""}</span>
        <span class="item-loot-when">${new Date(item.at).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" })}</span>
      </li>`;
  }

  function renderLoot(items: EpgpLootItem[]): void {
    const list = requireElement("item-loot-list");
    const live = items.filter((item) => !item.voided);
    list.innerHTML =
      live.length > 0
        ? live.map(lootRow).join("")
        : `<li class="ledger-empty">Nobody in the guild has looted this yet.</li>`;
  }

  function wisherRow(wisher: ItemWisher): string {
    const trial = wisher.trial ? `<span class="trial-tag">Trial</span>` : "";
    return `
      <li class="item-wisher-row">
        <span class="item-wisher-who">${escapeHtml(wisher.member_name)}${trial}</span>
        <span class="item-wisher-meta">
          ${wisher.ep.toFixed(1)} EP \u00b7 ${wisher.gp.toFixed(1)} GP \u00b7 ${wisher.pr.toFixed(3)} PR
        </span>
        ${wisher.note ? `<span class="item-wisher-note">${escapeHtml(wisher.note)}</span>` : ""}
      </li>`;
  }

  function renderWishers(wishers: ItemWisher[]): void {
    const list = requireElement("item-wishers-list");
    list.innerHTML =
      wishers.length > 0
        ? wishers.map(wisherRow).join("")
        : `<li class="ledger-empty">Nobody has wished for this yet.</li>`;
  }

  onPage("#item-detail-status", (signal) => {
    const statusEl = requireElement("item-detail-status");
    const contentEl = requireElement("item-detail-content");
    const wishlistSignedOut = requireElement("wishlist-signed-out");
    const wishlistMember = requireElement("wishlist-member");
    const wishlistStatusEl = requireElement("wishlist-status");
    const wishlistForm = requireElement<HTMLFormElement>("wishlist-form");
    const wishlistNoteInput = requireElement<HTMLInputElement>("wishlist-note");
    const wishlistSaveBtn = requireElement<HTMLButtonElement>("wishlist-save-btn");
    const wishlistRemoveBtn = requireElement<HTMLButtonElement>("wishlist-remove-btn");
    const wishersSection = requireElement("wishers-section");
    let itemId = "";
    let onList = false;

    function applyWish(wish: ItemWish | null): void {
      onList = wish !== null;
      wishlistNoteInput.value = wish?.note ?? "";
      wishlistSaveBtn.textContent = onList ? "Save note" : "Add to wishlist";
      wishlistRemoveBtn.hidden = !onList;
    }

    async function initWishlist(me: Me | null): Promise<void> {
      if (!me || !me.is_guild_member) {
        wishlistMember.hidden = true;
        const next = encodeURIComponent(location.pathname + location.search);
        wishlistSignedOut.innerHTML = `<a href="/auth/discord/login?next=${next}">Sign in with Discord</a> to keep a wishlist.`;
        wishlistSignedOut.hidden = false;
        return;
      }
      wishlistSignedOut.hidden = true;
      wishlistMember.hidden = false;
      try {
        const wishes = await apiFetch<ItemWish[]>("/api/me/wishlist", { signal });
        applyWish(wishes.find((wish) => wish.item_id === Number(itemId)) ?? null);
      } catch (err) {
        wishlistStatusEl.dataset.tone = "error";
        wishlistStatusEl.textContent = statusMessage(err);
      }
    }

    async function initWishers(me: Me | null): Promise<void> {
      if (!me?.is_officer) {
        return;
      }
      wishersSection.hidden = false;
      try {
        const wishers = await apiFetch<ItemWisher[]>(`/api/items/${itemId}/wishers`, { signal });
        renderWishers(wishers);
      } catch (err) {
        requireElement("item-wishers-list").innerHTML =
          `<li class="ledger-empty">${escapeHtml(statusMessage(err))}</li>`;
      }
    }

    wishlistForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      wishlistSaveBtn.disabled = true;
      try {
        const wishes = await apiFetch<ItemWish[]>(`/api/me/wishlist/${itemId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ note: wishlistNoteInput.value.trim() || null }),
          signal,
        });
        const wasOnList = onList;
        applyWish(wishes.find((wish) => wish.item_id === Number(itemId)) ?? null);
        wishlistStatusEl.dataset.tone = "";
        wishlistStatusEl.textContent = wasOnList ? "Note saved." : "Added to your wishlist.";
      } catch (err) {
        wishlistStatusEl.dataset.tone = "error";
        if (err instanceof ApiError && err.status === 503) {
          wishlistStatusEl.textContent =
            "Battle.net isn't answering right now, so your wishlist can't be updated. Try again soon.";
        } else {
          wishlistStatusEl.textContent = statusMessage(err);
        }
      } finally {
        wishlistSaveBtn.disabled = false;
      }
    });

    wishlistRemoveBtn.addEventListener("click", async () => {
      wishlistRemoveBtn.disabled = true;
      try {
        await apiFetch(`/api/me/wishlist/${itemId}`, { method: "DELETE", signal });
        applyWish(null);
        wishlistStatusEl.dataset.tone = "";
        wishlistStatusEl.textContent = "Removed from your wishlist.";
      } catch (err) {
        wishlistStatusEl.dataset.tone = "error";
        wishlistStatusEl.textContent = statusMessage(err);
      } finally {
        wishlistRemoveBtn.disabled = false;
      }
    });

    async function init(): Promise<void> {
      const id = new URLSearchParams(location.search).get("id");
      if (!id) {
        statusEl.textContent = "No item was given.";
        return;
      }
      itemId = id;
      statusEl.textContent = "Loading\u2026";
      void loadWowheadTooltips();
      try {
        const item = await apiFetch<Item>(`/api/items/${id}`, { signal });
        renderItem(item);
        contentEl.hidden = false;
        statusEl.textContent = "";
      } catch (err) {
        if (err instanceof ApiError && err.status === 404) {
          statusEl.textContent = "There's no such item.";
        } else if (err instanceof ApiError && err.status === 503) {
          statusEl.textContent = "Battle.net isn't answering right now, so this item can't be shown. Try again soon.";
        } else {
          statusEl.textContent = statusMessage(err);
        }
        return;
      }
      try {
        const loot = await apiFetch<EpgpLootPage>(`/api/epgp/loot?item_id=${id}&limit=50`, { signal });
        renderLoot(loot.items);
      } catch (err) {
        requireElement("item-loot-list").innerHTML = `<li class="ledger-empty">${escapeHtml(statusMessage(err))}</li>`;
      }
      const me = await fetchMe().catch(() => null);
      await initWishlist(me);
      await initWishers(me);
    }

    void init();
  });
</script>
