---
import JoinPlaque from "../../components/JoinPlaque.astro";
import Room from "../../layouts/Room.astro";
import ledgerChamber from "../../../assets/rooms/ledger-chamber.webp";
import { DISCORD_INVITE } from "../../config";
import "../../styles/room-account.css";
---

<Room
  title="Account · SideQuest"
  description="Sign in with Discord to manage your SideQuest account, and link Battle.net."
  heading="ACCOUNT"
  art={ledgerChamber}
  current="account"
>
  <p class="status" id="account-status" role="status" aria-live="polite"></p>

  <div id="account-signed-out">
    <section class="chamber" aria-labelledby="h-sign-in">
      <h2 class="chamber-title" id="h-sign-in">
        Sign The Ledger
      </h2>
      <p class="chamber-intro">Sign in with your Discord account to sign up for raids and see your profile.</p>
      <div class="ledger-cta">
        <JoinPlaque label="Sign in with Discord" href="/auth/discord/login?next=/account/" />
      </div>
      <p class="aside account-terms">
        You must be 18 or older. Signing in means you accept the <a href="/terms/">Terms</a> and the{" "}
        <a href="/rules/">Guild rules</a>. See <a href="/privacy/">Privacy</a> for what we keep.
      </p>
    </section>
  </div>

  <div id="account-not-member" hidden>
    <section class="chamber" aria-labelledby="h-not-member">
      <h2 class="chamber-title" id="h-not-member">
        Not Yet On The Roll
      </h2>
      <p class="chamber-intro" id="not-member-text"></p>
      <div class="ledger-cta">
        <JoinPlaque label="Join the Discord" href={DISCORD_INVITE} />
      </div>
    </section>
  </div>

  <div id="account-signed-in" hidden>
    <section class="chamber" aria-labelledby="h-sheet">
      <h2 class="chamber-title" id="h-sheet">
        Character Sheet
      </h2>
      <div class="sheet">
        <span class="sheet-portrait">
          <img id="account-avatar" alt="" width="96" height="96" hidden />
        </span>
        <div class="sheet-info">
          <p class="sheet-name" id="account-name"></p>
          <p class="sheet-rank" id="account-role"></p>
          <p class="sheet-roster" id="account-roster"></p>
        </div>
      </div>

      <h3>Linked accounts</h3>
      <dl class="links" aria-label="Linked accounts">
        <div>
          <dt>Discord</dt>
          <dd id="account-discord"></dd>
        </div>
        <div>
          <dt>Battle.net</dt>
          <dd>
            <span id="bnet-linked" hidden>
              <span id="bnet-tag"></span> · officers use it to check the guild roster.
            </span>
            <span id="bnet-unlinked">Not linked. Link it so officers can match you to your characters in game.</span>
          </dd>
        </div>
      </dl>
      <div class="form-actions">
        <a class="btn" id="bnet-link" href="/auth/battlenet/link">
          Link Battle.net
        </a>
        <button type="button" class="btn-quiet" id="bnet-unlink-btn" hidden>
          Unlink Battle.net
        </button>
        <button type="button" class="btn-quiet" id="sign-out-btn">
          Sign out
        </button>
      </div>
    </section>

    <section class="chamber" aria-labelledby="calendar-title">
      <h2 class="chamber-title" id="calendar-title">
        Calendar
      </h2>
      <p class="aside">
        Subscribe once and new events show up on their own. Anyone with this link can see the guild's events and your
        sign-ups, so keep it to yourself.
      </p>
      <div class="calendar-link-row">
        <input type="text" id="calendar-url" readonly aria-label="Your private calendar link" />
        <button type="button" class="btn-quiet btn-small" id="calendar-copy-btn">
          Copy
        </button>
      </div>
      <div class="form-actions">
        <a class="btn" id="calendar-google" target="_blank" rel="noopener noreferrer">
          Add to Google Calendar
        </a>
        <a class="btn" id="calendar-apple">
          Add to Apple Calendar
        </a>
        <button type="button" class="btn-quiet" id="calendar-rotate-btn">
          Make a new link
        </button>
      </div>
    </section>

    <section class="chamber" aria-labelledby="companion-title">
      <h2 class="chamber-title" id="companion-title">
        Companion
      </h2>
      <p class="aside">
        <a href="/companion/">SideQuest Companion</a> sits in your system tray on Windows, macOS or Linux and shows your
        updates and raid reminders; officers can also sync the addon's raid record from it. Choose{" "}
        <strong>Sign in with sidequest-guild.com</strong> in the app, then{" "}
        <a href="/companion/authorize/">approve it there</a>. Sign-ins you've approved are listed here.
      </p>
      <ul class="item-list companion-list" id="companion-token-list" aria-label="Companion sign-ins"></ul>
    </section>

    <section class="chamber" aria-labelledby="away-title">
      <h2 class="chamber-title" id="away-title">
        Away
      </h2>
      <p>Mark the dates you'll be away so officers and raid leads know not to expect you at those events.</p>
      <ul class="away-list" id="away-list"></ul>
      <form id="away-form" class="away-form">
        <label>
          From
          <input type="date" id="away-start" required />
        </label>
        <label>
          To
          <input type="date" id="away-end" required />
        </label>
        <label class="away-note-label">
          Note (optional)
          <input type="text" id="away-note" maxlength="100" placeholder="e.g. Family trip" />
        </label>
        <button type="submit" class="btn-quiet">
          Add
        </button>
      </form>
    </section>

    <section class="chamber" aria-labelledby="characters-title">
      <h2 class="chamber-title" id="characters-title">
        Your Characters
      </h2>
      <p>Link your characters so officers can match the SideQuest addon's raid record to your EP/GP balance.</p>
      <ul class="char-list" id="char-list"></ul>
      <form id="char-form" class="char-form">
        <label>
          Name
          <input type="text" id="char-name" maxlength="24" required />
        </label>
        <label>
          Realm
          <input type="text" id="char-realm" maxlength="40" placeholder="Whitemane" />
        </label>
        <label>
          Class (optional)
          <select id="char-class">
            <option value="">Unknown</option>
          </select>
        </label>
        <button type="submit" class="btn-quiet">
          Add
        </button>
      </form>
    </section>

    <section class="chamber danger-zone" aria-labelledby="account-data-title">
      <h2 class="chamber-title" id="account-data-title">
        Danger Zone
      </h2>
      <p class="chamber-intro">
        Deleting your account erases your SideQuest profile, every event sign-up, and your Discord chat XP right away,
        and signs you out. <strong>It also removes you from the guild on Discord:</strong> the bot takes away your roles
        and puts you back behind #sign-the-ledger, so the guild channels disappear until you sign in again and a Quest
        Master confirms you. Moderation records in the Discord stay; ask an officer about those.{" "}
        <a href="/privacy/#deleting">Privacy</a> has the full list.
      </p>
      <div class="form-actions danger-actions">
        <button type="button" class="btn-quiet btn-doom" id="delete-account-btn" aria-controls="delete-confirm">
          Delete my account
        </button>
      </div>
      <div class="danger-confirm" id="delete-confirm" role="group" aria-labelledby="delete-confirm-title" hidden>
        <p class="danger-confirm-title" id="delete-confirm-title">
          Delete everything? This can't be undone.
        </p>
        <p class="danger-confirm-body">
          Your profile, sign-ups and chat XP are erased, and you lose your Discord roles and guild channels.
        </p>
        <div class="form-actions danger-actions">
          <button type="button" class="btn-quiet" id="delete-account-cancel">
            Keep my account
          </button>
          <button type="button" class="btn btn-doom btn-doom-solid" id="delete-account-confirm">
            Yes, delete my account
          </button>
        </div>
      </div>
    </section>
  </div>

  <noscript>
    <p class="aside">
      Without JavaScript you can still sign in above, but your profile and sign-out button won't display here.
    </p>
  </noscript>
</Room>

<script>
  import {
    apiFetch,
    classLabel,
    CLASSES,
    escapeHtml,
    fetchMe,
    normalizeClass,
    requireElement,
    statusMessage,
    type AwayRange,
    type CalendarLink,
    type EpgpCharacter,
    type EpgpCharacters,
    type EpgpSyncToken,
    type EpgpSyncTokens,
    type Me,
  } from "../../scripts/api";
  import { onPage } from "../../scripts/page";

  /** `is_gm` isn't on `Me` yet; read it defensively so the rank line is ready the day it ships. */
  function rankLabel(me: Me): string {
    const isGm = (me as unknown as { is_gm?: boolean }).is_gm === true;
    if (isGm) {
      return "GM";
    }
    return me.is_officer ? "Officer" : "Member";
  }

  function toWebcal(url: string): string {
    return url.replace(/^https?:\/\//, "webcal://");
  }

  function formatAwayDate(iso: string): string {
    return new Date(`${iso}T00:00:00`).toLocaleDateString(undefined, { month: "short", day: "numeric" });
  }

  function formatAwayRange(range: AwayRange): string {
    return range.start_date === range.end_date
      ? formatAwayDate(range.start_date)
      : `${formatAwayDate(range.start_date)} \u2013 ${formatAwayDate(range.end_date)}`;
  }

  function companionTokenRow(token: EpgpSyncToken): string {
    const lastUsed = token.last_used_at
      ? `Last used ${new Date(token.last_used_at).toLocaleDateString()}`
      : "Never used";
    return `
      <li class="companion-row" data-token-id="${token.id}">
        <span class="companion-row-main">
          <span class="item-title">${escapeHtml(token.name)}</span>
          <span class="item-meta">Created ${new Date(token.created_at).toLocaleDateString()} \u00b7 ${lastUsed}</span>
        </span>
        <button type="button" class="btn-quiet btn-small btn-danger" data-revoke-companion-token="${token.id}">
          Revoke
        </button>
      </li>`;
  }
  onPage("#account-status", () => {
    const ERROR_MESSAGES: Record<string, string> = {
      state: "That sign-in took too long or was opened twice. Try again.",
      oauth_not_configured: "Discord sign-in isn't set up yet.",
      discord_unreachable: "Couldn't reach Discord. Try again in a moment.",
      token_exchange_failed: "Discord didn't accept the sign-in. Try again.",
      user_fetch_failed: "Discord didn't send your profile. Try again.",
      guild_member_fetch_failed: "Couldn't check your SideQuest membership with Discord. Try again.",
      signin_first: "Sign in with Discord first, then link Battle.net.",
      battlenet_not_configured: "Battle.net linking isn't set up yet.",
      battlenet_denied: "Battle.net linking was cancelled.",
      battlenet_unreachable: "Couldn't reach Battle.net. Try again in a moment.",
      battlenet_failed: "Battle.net didn't confirm your account. Try again.",
      battlenet_taken:
        "That Battle.net account is already linked to another SideQuest member. Ask an officer if that's wrong.",
    };

    const statusEl = requireElement("account-status");
    const signedOut = requireElement("account-signed-out");
    const notMember = requireElement("account-not-member");
    const notMemberText = requireElement("not-member-text");
    const signedIn = requireElement("account-signed-in");
    const avatarImg = requireElement<HTMLImageElement>("account-avatar");
    const nameEl = requireElement("account-name");
    const roleEl = requireElement("account-role");
    const rosterEl = requireElement("account-roster");
    const discordEl = requireElement("account-discord");
    const signOutBtn = requireElement<HTMLButtonElement>("sign-out-btn");
    const bnetLinked = requireElement("bnet-linked");
    const bnetUnlinked = requireElement("bnet-unlinked");
    const bnetTag = requireElement("bnet-tag");
    const bnetLink = requireElement<HTMLAnchorElement>("bnet-link");
    const bnetUnlinkBtn = requireElement<HTMLButtonElement>("bnet-unlink-btn");
    const deleteAccountBtn = requireElement<HTMLButtonElement>("delete-account-btn");
    const deleteConfirm = requireElement("delete-confirm");
    const deleteCancelBtn = requireElement<HTMLButtonElement>("delete-account-cancel");
    const deleteConfirmBtn = requireElement<HTMLButtonElement>("delete-account-confirm");
    const calendarUrlInput = requireElement<HTMLInputElement>("calendar-url");
    const calendarCopyBtn = requireElement<HTMLButtonElement>("calendar-copy-btn");
    const calendarGoogleLink = requireElement<HTMLAnchorElement>("calendar-google");
    const calendarAppleLink = requireElement<HTMLAnchorElement>("calendar-apple");
    const calendarRotateBtn = requireElement<HTMLButtonElement>("calendar-rotate-btn");
    const companionTokenList = requireElement("companion-token-list");
    const awayList = requireElement("away-list");
    const awayForm = requireElement<HTMLFormElement>("away-form");
    const awayStartInput = requireElement<HTMLInputElement>("away-start");
    const awayEndInput = requireElement<HTMLInputElement>("away-end");
    const awayNoteInput = requireElement<HTMLInputElement>("away-note");
    const charList = requireElement("char-list");
    const charForm = requireElement<HTMLFormElement>("char-form");
    const charNameInput = requireElement<HTMLInputElement>("char-name");
    const charRealmInput = requireElement<HTMLInputElement>("char-realm");
    const charClassSelect = requireElement<HTMLSelectElement>("char-class");

    function show(target: HTMLElement): void {
      for (const el of [signedOut, notMember, signedIn]) {
        el.hidden = el !== target;
      }
    }

    function showRedirectError(): void {
      const params = new URLSearchParams(location.search);
      const errorCode = params.get("error");
      if (!errorCode) {
        return;
      }
      statusEl.dataset.tone = "error";
      statusEl.textContent = ERROR_MESSAGES[errorCode] ?? "Something went wrong. Try again.";
      // Drop ?error= so a reload or a later re-render doesn't repeat a stale message.
      params.delete("error");
      const query = params.toString();
      history.replaceState(null, "", `${location.pathname}${query ? `?${query}` : ""}${location.hash}`);
    }

    function applyCalendarLink(link: CalendarLink): void {
      calendarUrlInput.value = link.url;
      const webcalUrl = toWebcal(link.url);
      calendarGoogleLink.href = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcalUrl)}`;
      calendarAppleLink.href = webcalUrl;
    }

    async function renderCalendar(): Promise<void> {
      try {
        const link = await apiFetch<CalendarLink>("/api/me/calendar");
        applyCalendarLink(link);
      } catch {
        calendarUrlInput.value = "";
      }
    }

    async function renderCompanionTokens(): Promise<void> {
      try {
        const data = await apiFetch<EpgpSyncTokens>("/api/epgp/sync-tokens");
        companionTokenList.innerHTML =
          data.tokens.length > 0
            ? data.tokens.map(companionTokenRow).join("")
            : `<li class="away-empty">No Companion sign-ins yet.</li>`;
      } catch {
        companionTokenList.innerHTML = `<li class="away-empty">Couldn\u2019t load your Companion sign-ins.</li>`;
      }
    }

    function renderAwayList(ranges: AwayRange[]): void {
      if (ranges.length === 0) {
        awayList.innerHTML = '<li class="away-empty">No away dates marked.</li>';
        return;
      }
      awayList.innerHTML = ranges
        .map(
          (range) => `
            <li class="away-item" data-id="${range.id}">
              <span class="away-range">${formatAwayRange(range)}</span>
              ${range.note ? `<span class="away-note">${escapeHtml(range.note)}</span>` : ""}
              <button type="button" class="btn-quiet away-delete-btn" data-id="${range.id}" aria-label="Remove">
                Remove
              </button>
            </li>`,
        )
        .join("");
    }

    async function renderAway(): Promise<void> {
      try {
        const ranges = await apiFetch<AwayRange[]>("/api/me/away");
        renderAwayList(ranges);
      } catch {
        awayList.innerHTML = '<li class="away-empty">Couldn\u2019t load your away dates.</li>';
      }
    }

    for (const cls of CLASSES) {
      charClassSelect.insertAdjacentHTML("beforeend", `<option value="${cls}">${classLabel(cls)}</option>`);
    }

    function renderCharacterList(characters: EpgpCharacter[]): void {
      if (characters.length === 0) {
        charList.innerHTML = '<li class="away-empty">No characters linked yet.</li>';
        return;
      }
      charList.innerHTML = characters
        .map((character) => {
          const normalized = normalizeClass(character.class);
          return `
            <li class="char-item" data-id="${character.id}">
              <span class="char-name ${normalized ? `cls-${normalized}` : ""}">
                ${escapeHtml(`${character.name}-${character.realm}`)}
              </span>
              <span class="char-meta">
                ${escapeHtml(classLabel(character.class))}${character.is_main ? " \u00b7 Main" : ""}
              </span>
              <button type="button" class="btn-quiet char-delete-btn" data-id="${character.id}" aria-label="Remove">
                Remove
              </button>
            </li>`;
        })
        .join("");
    }

    async function renderCharacters(): Promise<void> {
      try {
        const data = await apiFetch<EpgpCharacters>("/api/me/characters");
        renderCharacterList(data.characters);
      } catch {
        charList.innerHTML = '<li class="away-empty">Couldn\u2019t load your characters.</li>';
      }
    }

    async function render({ fresh = false }: { fresh?: boolean } = {}): Promise<void> {
      let me: Me | null = null;
      try {
        me = await fetchMe({ fresh });
      } catch {
        me = null;
      }

      if (!me) {
        show(signedOut);
        return;
      }
      if (!me.is_guild_member) {
        notMemberText.textContent = `Signed in as ${me.username}, but you're not in the SideQuest Discord yet.`;
        show(notMember);
        return;
      }
      nameEl.textContent = me.display_name;
      roleEl.textContent = rankLabel(me);
      rosterEl.textContent = me.roster_confirmed
        ? "Confirmed on the guild roster."
        : "Not yet confirmed on the guild roster.";
      discordEl.textContent = `@${me.username}`;
      if (me.avatar_url) {
        avatarImg.src = me.avatar_url;
        avatarImg.hidden = false;
      }
      const linked = me.battletag !== null;
      bnetTag.textContent = me.battletag ?? "";
      bnetLinked.hidden = !linked;
      bnetUnlinked.hidden = linked;
      bnetLink.hidden = linked;
      bnetUnlinkBtn.hidden = !linked;
      show(signedIn);
      await renderCalendar();
      await renderCompanionTokens();
      await renderAway();
      await renderCharacters();
    }

    signOutBtn.addEventListener("click", async () => {
      signOutBtn.disabled = true;
      try {
        await apiFetch("/auth/logout", { method: "POST" });
      } catch {
        // The session cookie may already be gone; reload regardless to reflect the signed-out state.
      }
      location.reload();
    });

    bnetUnlinkBtn.addEventListener("click", async () => {
      if (!confirm("Unlink Battle.net? Your BattleTag is erased from SideQuest right away.")) {
        return;
      }
      bnetUnlinkBtn.disabled = true;
      try {
        await apiFetch("/auth/battlenet/unlink", { method: "POST" });
        statusEl.dataset.tone = "";
        statusEl.textContent = "Battle.net unlinked.";
        await render({ fresh: true });
      } catch (err) {
        statusEl.dataset.tone = "error";
        statusEl.textContent = statusMessage(err);
      } finally {
        bnetUnlinkBtn.disabled = false;
      }
    });

    function askToDelete(asking: boolean): void {
      deleteConfirm.hidden = !asking;
      deleteAccountBtn.hidden = asking;
      deleteAccountBtn.setAttribute("aria-expanded", String(asking));
      // The safe choice gets focus, so a stray Enter keeps the account.
      (asking ? deleteCancelBtn : deleteAccountBtn).focus();
    }

    deleteAccountBtn.addEventListener("click", () => askToDelete(true));
    deleteCancelBtn.addEventListener("click", () => askToDelete(false));
    deleteConfirm.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        askToDelete(false);
      }
    });

    deleteConfirmBtn.addEventListener("click", async () => {
      deleteConfirmBtn.disabled = true;
      deleteCancelBtn.disabled = true;
      try {
        await apiFetch("/api/me", { method: "DELETE" });
        statusEl.dataset.tone = "";
        statusEl.textContent =
          "Your account and sign-ups are deleted, and the bot is taking away your Discord roles. Signing in again starts a fresh account.";
        show(signedOut);
      } catch (err) {
        statusEl.dataset.tone = "error";
        statusEl.textContent = statusMessage(err);
      } finally {
        deleteConfirmBtn.disabled = false;
        deleteCancelBtn.disabled = false;
      }
    });

    calendarCopyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(calendarUrlInput.value);
        statusEl.dataset.tone = "";
        statusEl.textContent = "Calendar link copied.";
      } catch {
        calendarUrlInput.select();
      }
    });

    calendarRotateBtn.addEventListener("click", async () => {
      if (!confirm("Make a new calendar link? The current link will stop working for anyone who has it, right away.")) {
        return;
      }
      calendarRotateBtn.disabled = true;
      try {
        const link = await apiFetch<CalendarLink>("/api/me/calendar/rotate", { method: "POST" });
        applyCalendarLink(link);
        statusEl.dataset.tone = "";
        statusEl.textContent = "New calendar link ready.";
      } catch (err) {
        statusEl.dataset.tone = "error";
        statusEl.textContent = statusMessage(err);
      } finally {
        calendarRotateBtn.disabled = false;
      }
    });

    awayForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitBtn = awayForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
      }
      try {
        await apiFetch("/api/me/away", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            start_date: awayStartInput.value,
            end_date: awayEndInput.value,
            note: awayNoteInput.value.trim() || null,
          }),
        });
        awayForm.reset();
        statusEl.dataset.tone = "";
        statusEl.textContent = "Away dates added.";
        await renderAway();
      } catch (err) {
        statusEl.dataset.tone = "error";
        statusEl.textContent = statusMessage(err);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
        }
      }
    });

    awayList.addEventListener("click", async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".away-delete-btn");
      if (!button?.dataset.id) {
        return;
      }
      button.disabled = true;
      try {
        await apiFetch(`/api/me/away/${button.dataset.id}`, { method: "DELETE" });
        await renderAway();
      } catch (err) {
        statusEl.dataset.tone = "error";
        statusEl.textContent = statusMessage(err);
        button.disabled = false;
      }
    });

    charForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitBtn = charForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
      }
      try {
        await apiFetch("/api/me/characters", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: charNameInput.value.trim(),
            realm: charRealmInput.value.trim() || undefined,
            class: charClassSelect.value || undefined,
          }),
        });
        charForm.reset();
        statusEl.dataset.tone = "";
        statusEl.textContent = "Character added.";
        await renderCharacters();
      } catch (err) {
        statusEl.dataset.tone = "error";
        statusEl.textContent = statusMessage(err);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
        }
      }
    });

    charList.addEventListener("click", async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".char-delete-btn");
      if (!button?.dataset.id) {
        return;
      }
      button.disabled = true;
      try {
        await apiFetch(`/api/me/characters/${button.dataset.id}`, { method: "DELETE" });
        await renderCharacters();
      } catch (err) {
        statusEl.dataset.tone = "error";
        statusEl.textContent = statusMessage(err);
        button.disabled = false;
      }
    });

    companionTokenList.addEventListener("click", async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-revoke-companion-token]");
      if (!button?.dataset.revokeCompanionToken) {
        return;
      }
      if (!confirm("Revoke this Companion sign-in? It stops working right away.")) {
        return;
      }
      button.disabled = true;
      try {
        await apiFetch(`/api/epgp/sync-tokens/${button.dataset.revokeCompanionToken}`, { method: "DELETE" });
        await renderCompanionTokens();
      } catch (err) {
        statusEl.dataset.tone = "error";
        statusEl.textContent = statusMessage(err);
        button.disabled = false;
      }
    });
    showRedirectError();
    render();
  });
</script>
