---
import Page from "../../layouts/Page.astro";
---

<Page
  title="Officers · SideQuest"
  description="Officer console: create guild events, assign the raid chart, manage addons, and check members' BattleTags."
  heading="OFFICERS"
  current="officers"
>
  <p class="status" id="officers-status" role="status" aria-live="polite"></p>

  <div id="officers-gate" hidden>
    <p class="lede">
      This page is for SideQuest officers. Sign in with Discord on the <a href="/account/">account page</a> if you hold
      an officer role.
    </p>
  </div>

  <div id="officers-body" hidden>
    <section aria-labelledby="h-event-manage">
      <span class="caps section-label" id="h-event-manage">
        Events
      </span>
      <form id="event-form" class="form">
        <fieldset>
          <legend id="event-form-legend">New event</legend>
          <p class="aside" id="e-series-aside" hidden>
            To change every week, edit the series below.
          </p>
          <div class="form-row">
            <div class="field">
              <label for="e-kind">Kind</label>
              <select id="e-kind" required></select>
            </div>
            <div class="field">
              <label for="e-title">Title</label>
              <input id="e-title" maxlength="80" required />
            </div>
            <div class="field">
              <label for="e-location">Location</label>
              <input id="e-location" maxlength="80" />
            </div>
            <div class="field">
              <label for="e-starts">Start</label>
              <input id="e-starts" type="datetime-local" required />
            </div>
            <div class="field">
              <label for="e-ends">End (optional)</label>
              <input id="e-ends" type="datetime-local" />
            </div>
            <div class="field">
              <label for="e-size">Size (optional)</label>
              <input id="e-size" type="number" min="1" max="40" />
            </div>
            <div class="field" id="e-status-field">
              <label for="e-status">Status</label>
              <select id="e-status">
                <option value="scheduled">Scheduled</option>
                <option value="cancelled">Cancelled</option>
                <option value="completed">Completed</option>
              </select>
            </div>
            <div class="field" id="e-repeats-field">
              <label for="e-repeats">Repeats</label>
              <select id="e-repeats">
                <option value="">Doesn't repeat</option>
                <option value="1">Weekly</option>
                <option value="2">Every 2 weeks</option>
              </select>
            </div>
            <div class="field" id="e-until-field" hidden>
              <label for="e-until">Until (optional)</label>
              <input id="e-until" type="date" />
            </div>
          </div>
          <fieldset class="weekday-toggles" id="e-weekdays-fieldset" hidden>
            <legend class="caps">Repeat on</legend>
            <div id="e-weekday-grid"></div>
          </fieldset>
          <div class="field">
            <label for="e-notes">Notes</label>
            <textarea id="e-notes" rows="2" maxlength="500"></textarea>
          </div>
        </fieldset>
        <div class="form-actions">
          <button type="submit" class="btn" id="event-save">
            Save event
          </button>
          <button type="button" class="btn-quiet" id="event-reset">
            New event
          </button>
          <button type="button" class="btn-quiet" id="event-delete" hidden>
            Cancel &amp; delete event
          </button>
        </div>
        <p class="status" id="event-form-status" role="status" aria-live="polite"></p>
        <p class="aside">
          Events are mirrored to the Discord server's Events. Changes here show up in Discord within about 15 seconds;
          events made or edited in Discord appear here too, starting out with kind "Other" until set here. Deleting an
          event in Discord cancels it here and keeps the sign-ups.
        </p>
      </form>
      <ul class="raid-list" id="officer-event-list" aria-label="Existing events"></ul>

      <span class="caps section-label" id="h-series-manage">
        Repeating events
      </span>
      <ul class="raid-list" id="officer-series-list" aria-label="Repeating events"></ul>
    </section>

    <section aria-labelledby="h-addon-manage">
      <span class="caps section-label" id="h-addon-manage">
        Addons
      </span>
      <form id="addon-form" class="form">
        <fieldset>
          <legend id="addon-form-legend">New addon</legend>
          <div class="form-row">
            <div class="field">
              <label for="a-name">Name</label>
              <input id="a-name" maxlength="80" required />
            </div>
            <div class="field">
              <label for="a-slug">Slug</label>
              <input id="a-slug" pattern="[a-z0-9-]+" maxlength="80" required />
            </div>
            <div class="field">
              <label for="a-version">Version</label>
              <input id="a-version" maxlength="40" required />
            </div>
            <div class="field">
              <label for="a-download">Download URL</label>
              <input id="a-download" type="url" required />
            </div>
            <div class="field">
              <label for="a-homepage">Homepage URL</label>
              <input id="a-homepage" type="url" />
            </div>
          </div>
          <div class="field">
            <label for="a-summary">Summary</label>
            <textarea id="a-summary" rows="2" maxlength="280" required></textarea>
          </div>
        </fieldset>
        <div class="form-actions">
          <button type="submit" class="btn" id="addon-save">
            Save addon
          </button>
          <button type="button" class="btn-quiet" id="addon-reset">
            New addon
          </button>
          <button type="button" class="btn-quiet" id="addon-delete" hidden>
            Delete addon
          </button>
        </div>
        <p class="status" id="addon-form-status" role="status" aria-live="polite"></p>
      </form>
      <ul class="addon-list" id="officer-addon-list" aria-label="Existing addons"></ul>
    </section>

    <section aria-labelledby="h-members">
      <span class="caps section-label" id="h-members">
        Members
      </span>
      <p class="aside">
        Everyone who has signed in. Match each linked BattleTag against the in-game guild roster, then confirm them:
        Discord gives them New Arrival and opens the member channels within a minute. Until then they only see the Guest
        Hall.
      </p>
      <ul class="raid-list" id="officer-member-list" aria-label="Signed-in members"></ul>
    </section>
  </div>

  <noscript>
    <p class="aside">Enable JavaScript to use the officer console.</p>
  </noscript>
</Page>

<script>
  import {
    ApiError,
    apiFetch,
    escapeHtml,
    requireElement,
    statusMessage,
    EVENT_KINDS,
    EVENT_KIND_LABELS,
    ROLE_KINDS,
    type Addon,
    type EventKind,
    type EventSeriesSummary,
    type EventSummary,
    type Me,
    type MemberListing,
  } from "../../scripts/api";
  import { seriesRuleText, WEEKDAY_SHORT_LABELS } from "../../scripts/series";

  const statusEl = requireElement("officers-status");
  const gateEl = requireElement("officers-gate");
  const bodyEl = requireElement("officers-body");

  // ——— Events ———
  const eventForm = requireElement<HTMLFormElement>("event-form");
  const eventLegend = requireElement("event-form-legend");
  const eventSeriesAside = requireElement("e-series-aside");
  const eventKind = requireElement<HTMLSelectElement>("e-kind");
  const eventTitle = requireElement<HTMLInputElement>("e-title");
  const eventLocation = requireElement<HTMLInputElement>("e-location");
  const eventStarts = requireElement<HTMLInputElement>("e-starts");
  const eventEnds = requireElement<HTMLInputElement>("e-ends");
  const eventSize = requireElement<HTMLInputElement>("e-size");
  const eventStatusField = requireElement("e-status-field");
  const eventStatusSelect = requireElement<HTMLSelectElement>("e-status");
  const eventRepeatsField = requireElement("e-repeats-field");
  const eventRepeats = requireElement<HTMLSelectElement>("e-repeats");
  const eventWeekdaysFieldset = requireElement("e-weekdays-fieldset");
  const eventWeekdayGrid = requireElement("e-weekday-grid");
  const eventUntilField = requireElement("e-until-field");
  const eventUntil = requireElement<HTMLInputElement>("e-until");
  const eventNotes = requireElement<HTMLTextAreaElement>("e-notes");
  const eventResetBtn = requireElement<HTMLButtonElement>("event-reset");
  const eventDeleteBtn = requireElement<HTMLButtonElement>("event-delete");
  const eventFormStatus = requireElement("event-form-status");
  const eventListEl = requireElement("officer-event-list");
  const seriesListEl = requireElement("officer-series-list");

  eventKind.innerHTML = EVENT_KINDS.map((k) => `<option value="${k}">${EVENT_KIND_LABELS[k]}</option>`).join("");
  eventWeekdayGrid.innerHTML = WEEKDAY_SHORT_LABELS.map(
    (label, i) => `
      <label class="weekday-toggle">
        <input type="checkbox" value="${i}" />
        <span>${label}</span>
      </label>`,
  ).join("");
  const weekdayCheckboxes = Array.from(eventWeekdayGrid.querySelectorAll<HTMLInputElement>("input[type=checkbox]"));

  let events: EventSummary[] = [];
  let series: EventSeriesSummary[] = [];
  let editingEventId: string | null = null;
  let editingSeriesId: string | null = null;
  let weekdaysTouched = false;

  function pad(n: number): string {
    return String(n).padStart(2, "0");
  }

  function localDateTimeInput(iso: string): string {
    const d = new Date(iso);
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  function addMinutesToLocalDateTime(dateStr: string, timeStr: string, minutes: number): string {
    const [y, m, d] = dateStr.split("-").map(Number);
    const [hh, mm] = timeStr.split(":").map(Number);
    const dt = new Date(y ?? 1970, (m ?? 1) - 1, d ?? 1, hh ?? 0, (mm ?? 0) + minutes);
    return `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}T${pad(dt.getHours())}:${pad(dt.getMinutes())}`;
  }

  function applyDefaultWeekdays(): void {
    const d = eventStarts.value ? new Date(eventStarts.value) : new Date();
    const day = (d.getDay() + 6) % 7;
    for (const cb of weekdayCheckboxes) {
      cb.checked = Number(cb.value) === day;
    }
  }

  for (const cb of weekdayCheckboxes) {
    cb.addEventListener("change", () => {
      weekdaysTouched = true;
    });
  }

  eventRepeats.addEventListener("change", () => {
    const repeating = eventRepeats.value !== "";
    eventWeekdaysFieldset.hidden = !repeating;
    eventUntilField.hidden = !repeating;
    if (repeating && !weekdaysTouched) {
      applyDefaultWeekdays();
    }
  });

  eventStarts.addEventListener("change", () => {
    if (eventRepeats.value !== "" && !weekdaysTouched) {
      applyDefaultWeekdays();
    }
  });

  function resetEventForm(): void {
    eventForm.reset();
    editingEventId = null;
    editingSeriesId = null;
    weekdaysTouched = false;
    eventLegend.textContent = "New event";
    eventSeriesAside.hidden = true;
    eventKind.value = "raid";
    eventStatusField.hidden = false;
    eventStatusSelect.value = "scheduled";
    eventRepeatsField.hidden = false;
    eventRepeats.value = "";
    eventWeekdaysFieldset.hidden = true;
    eventUntilField.hidden = true;
    eventDeleteBtn.hidden = true;
    eventFormStatus.textContent = "";
  }

  function fillEventForm(event: EventSummary): void {
    editingEventId = event.id;
    editingSeriesId = null;
    weekdaysTouched = false;
    eventLegend.textContent = event.series ? `Edit · ${event.title} (this night only)` : `Edit · ${event.title}`;
    eventSeriesAside.hidden = !event.series;
    eventStatusField.hidden = false;
    eventRepeatsField.hidden = true;
    eventRepeats.value = "";
    eventWeekdaysFieldset.hidden = true;
    eventUntilField.hidden = true;
    eventKind.value = event.kind;
    eventTitle.value = event.title;
    eventLocation.value = event.location;
    eventStarts.value = localDateTimeInput(event.starts_at);
    eventEnds.value = event.ends_at ? localDateTimeInput(event.ends_at) : "";
    eventSize.value = event.size === null ? "" : String(event.size);
    eventStatusSelect.value = event.status;
    eventNotes.value = event.notes ?? "";
    eventDeleteBtn.hidden = false;
    eventFormStatus.textContent = "";
  }

  function fillSeriesForm(s: EventSeriesSummary): void {
    editingEventId = null;
    editingSeriesId = s.id;
    weekdaysTouched = true;
    eventLegend.textContent = `Edit series · ${s.title}`;
    eventSeriesAside.hidden = true;
    eventStatusField.hidden = true;
    eventRepeatsField.hidden = false;
    eventWeekdaysFieldset.hidden = false;
    eventUntilField.hidden = false;
    eventKind.value = s.kind;
    eventTitle.value = s.title;
    eventLocation.value = s.location;
    eventStarts.value = `${s.rule.starts_on}T${s.rule.start_time}`;
    eventEnds.value = s.rule.duration_minutes
      ? addMinutesToLocalDateTime(s.rule.starts_on, s.rule.start_time, s.rule.duration_minutes)
      : "";
    eventSize.value = s.size === null ? "" : String(s.size);
    eventNotes.value = s.notes ?? "";
    eventRepeats.value = String(s.rule.interval_weeks);
    for (const cb of weekdayCheckboxes) {
      cb.checked = s.rule.weekdays.includes(Number(cb.value));
    }
    eventUntil.value = s.rule.until ?? "";
    eventDeleteBtn.hidden = true;
    eventFormStatus.textContent = "";
  }

  function renderEventList(): void {
    eventListEl.innerHTML =
      events.length > 0
        ? events
            .map(
              (e) => `
        <li>
          <button type="button" class="raid-row" data-edit-event="${e.id}">
            <span class="caps kind-tag">${escapeHtml(EVENT_KIND_LABELS[e.kind])}</span>
            <span>${escapeHtml(e.title)} (${escapeHtml(e.status)})</span>
            <span class="when">${escapeHtml([e.location, new Date(e.starts_at).toLocaleString()].filter(Boolean).join(" · "))}</span>
          </button>
        </li>`,
            )
            .join("")
        : `<li class="aside">No events yet.</li>`;
    eventListEl.querySelectorAll<HTMLButtonElement>("[data-edit-event]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.editEvent;
        const match = events.find((e) => e.id === id);
        if (match) {
          fillEventForm(match);
        }
      });
    });
  }

  function renderSeriesList(): void {
    seriesListEl.innerHTML =
      series.length > 0
        ? series
            .map((s) => {
              const ruleText = seriesRuleText(s.rule, s.next_starts_at);
              const nextText = s.next_starts_at ? new Date(s.next_starts_at).toLocaleDateString() : "No upcoming night";
              return `
        <li class="series-row">
          <button type="button" class="raid-row" data-edit-series="${s.id}">
            <span class="caps kind-tag">${escapeHtml(EVENT_KIND_LABELS[s.kind])}</span>
            <span>${escapeHtml(ruleText)}${s.location ? ` · ${escapeHtml(s.location)}` : ""}</span>
            <span class="when">${escapeHtml(nextText)}</span>
          </button>
          <button type="button" class="btn-quiet" data-end-series="${s.id}">End series</button>
        </li>`;
            })
            .join("")
        : `<li class="aside">No repeating events yet.</li>`;
    seriesListEl.querySelectorAll<HTMLButtonElement>("[data-edit-series]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const match = series.find((s) => s.id === btn.dataset.editSeries);
        if (match) {
          fillSeriesForm(match);
        }
      });
    });
    seriesListEl.querySelectorAll<HTMLButtonElement>("[data-end-series]").forEach((btn) => {
      btn.addEventListener("click", () => onEndSeries(btn.dataset.endSeries));
    });
  }

  async function loadEvents(): Promise<void> {
    try {
      const [upcoming, past] = await Promise.all([
        apiFetch<EventSummary[]>("/api/events?when=upcoming"),
        apiFetch<EventSummary[]>("/api/events?when=past"),
      ]);
      events = [...upcoming, ...past];
      renderEventList();
    } catch (err) {
      eventListEl.innerHTML = `<li class="aside">${escapeHtml(statusMessage(err))}</li>`;
    }
  }

  async function loadSeries(): Promise<void> {
    try {
      series = await apiFetch<EventSeriesSummary[]>("/api/event-series");
      renderSeriesList();
    } catch (err) {
      seriesListEl.innerHTML = `<li class="aside">${escapeHtml(statusMessage(err))}</li>`;
    }
  }

  async function onEndSeries(id: string | undefined): Promise<void> {
    if (!id) {
      return;
    }
    if (
      !confirm(
        "End this series? Future nights without sign-ups will be removed; nights with sign-ups will be cancelled.",
      )
    ) {
      return;
    }
    eventFormStatus.textContent = "Ending series…";
    try {
      await apiFetch(`/api/event-series/${id}`, { method: "DELETE" });
      if (editingSeriesId === id) {
        resetEventForm();
      }
      eventFormStatus.textContent = "Series ended.";
      await Promise.all([loadEvents(), loadSeries()]);
    } catch (err) {
      eventFormStatus.textContent = statusMessage(err);
    }
  }

  eventForm.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const kind = eventKind.value as EventKind;
    const location = eventLocation.value.trim();
    if (ROLE_KINDS.includes(kind) && location.length === 0) {
      eventFormStatus.textContent = "Location is required for raids and dungeons.";
      eventLocation.focus();
      return;
    }
    const notes = eventNotes.value.trim();
    const startsAt = new Date(eventStarts.value);
    const endsAt = eventEnds.value ? new Date(eventEnds.value) : null;
    if (endsAt && endsAt <= startsAt) {
      eventFormStatus.textContent = "The end has to be after the start.";
      eventEnds.focus();
      return;
    }
    const sizeRaw = eventSize.value.trim();
    const repeating = eventRepeats.value !== "";

    if (repeating) {
      const weekdays = weekdayCheckboxes.filter((cb) => cb.checked).map((cb) => Number(cb.value));
      if (weekdays.length === 0) {
        eventFormStatus.textContent = "Pick at least one day of the week.";
        return;
      }
      const seriesBody: Record<string, unknown> = {
        kind,
        title: eventTitle.value.trim(),
        location,
        weekdays,
        interval_weeks: Number(eventRepeats.value),
        start_time: `${pad(startsAt.getHours())}:${pad(startsAt.getMinutes())}`,
        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
        starts_on: eventStarts.value.slice(0, 10),
      };
      if (notes.length > 0) {
        seriesBody.notes = notes;
      } else if (editingSeriesId) {
        seriesBody.notes = null;
      }
      if (eventUntil.value.length > 0) {
        seriesBody.until = eventUntil.value;
      } else if (editingSeriesId) {
        seriesBody.until = null;
      }
      if (endsAt) {
        seriesBody.duration_minutes = Math.round((endsAt.getTime() - startsAt.getTime()) / 60000);
      } else if (editingSeriesId) {
        seriesBody.duration_minutes = null;
      }
      if (sizeRaw.length > 0) {
        seriesBody.size = Number(sizeRaw);
      } else if (editingSeriesId) {
        seriesBody.size = null;
      }
      eventFormStatus.textContent = "Saving…";
      try {
        if (editingSeriesId) {
          await apiFetch(`/api/event-series/${editingSeriesId}`, {
            method: "PATCH",
            body: JSON.stringify(seriesBody),
          });
        } else {
          await apiFetch("/api/event-series", { method: "POST", body: JSON.stringify(seriesBody) });
        }
        resetEventForm();
        eventFormStatus.textContent = "Saved.";
        await Promise.all([loadEvents(), loadSeries()]);
      } catch (err) {
        eventFormStatus.textContent = statusMessage(err);
      }
      return;
    }

    const body: Record<string, unknown> = {
      kind,
      title: eventTitle.value.trim(),
      location,
      starts_at: startsAt.toISOString(),
      notes: notes.length > 0 ? notes : undefined,
    };
    if (sizeRaw.length > 0) {
      body.size = Number(sizeRaw);
    } else if (editingEventId) {
      body.size = null;
    }
    if (endsAt) {
      body.ends_at = endsAt.toISOString();
    } else if (editingEventId) {
      body.ends_at = null;
    }
    eventFormStatus.textContent = "Saving…";
    try {
      if (editingEventId) {
        body.status = eventStatusSelect.value;
        await apiFetch(`/api/events/${editingEventId}`, { method: "PATCH", body: JSON.stringify(body) });
      } else {
        await apiFetch("/api/events", { method: "POST", body: JSON.stringify(body) });
      }
      resetEventForm();
      eventFormStatus.textContent = "Saved.";
      await loadEvents();
    } catch (err) {
      eventFormStatus.textContent = statusMessage(err);
    }
  });

  eventResetBtn.addEventListener("click", resetEventForm);

  eventDeleteBtn.addEventListener("click", async () => {
    if (!editingEventId || !confirm("Cancel and remove this event?")) {
      return;
    }
    eventFormStatus.textContent = "Deleting…";
    try {
      await apiFetch(`/api/events/${editingEventId}`, { method: "DELETE" });
      resetEventForm();
      eventFormStatus.textContent = "Deleted.";
      await loadEvents();
    } catch (err) {
      eventFormStatus.textContent = statusMessage(err);
    }
  });

  // ——— Addons ———
  const addonForm = requireElement<HTMLFormElement>("addon-form");
  const addonLegend = requireElement("addon-form-legend");
  const addonName = requireElement<HTMLInputElement>("a-name");
  const addonSlug = requireElement<HTMLInputElement>("a-slug");
  const addonVersion = requireElement<HTMLInputElement>("a-version");
  const addonDownload = requireElement<HTMLInputElement>("a-download");
  const addonHomepage = requireElement<HTMLInputElement>("a-homepage");
  const addonSummary = requireElement<HTMLTextAreaElement>("a-summary");
  const addonResetBtn = requireElement<HTMLButtonElement>("addon-reset");
  const addonDeleteBtn = requireElement<HTMLButtonElement>("addon-delete");
  const addonFormStatus = requireElement("addon-form-status");
  const addonListEl = requireElement("officer-addon-list");

  let addons: Addon[] = [];
  let editingAddonId: string | null = null;

  function resetAddonForm(): void {
    addonForm.reset();
    editingAddonId = null;
    addonLegend.textContent = "New addon";
    addonDeleteBtn.hidden = true;
    addonFormStatus.textContent = "";
  }

  function fillAddonForm(addon: Addon): void {
    editingAddonId = addon.id;
    addonLegend.textContent = `Edit · ${addon.name}`;
    addonName.value = addon.name;
    addonSlug.value = addon.slug;
    addonVersion.value = addon.version;
    addonDownload.value = addon.download_url;
    addonHomepage.value = addon.homepage_url ?? "";
    addonSummary.value = addon.summary;
    addonDeleteBtn.hidden = false;
    addonFormStatus.textContent = "";
  }

  function renderAddonList(): void {
    addonListEl.innerHTML =
      addons.length > 0
        ? addons
            .map(
              (a) => `
        <li class="addon-row">
          <button type="button" class="raid-row" data-edit-addon="${a.id}">
            <span class="addon-name">${escapeHtml(a.name)}</span>
            <span class="when">v${escapeHtml(a.version)} · ${escapeHtml(a.slug)}</span>
          </button>
        </li>`,
            )
            .join("")
        : `<li class="aside">No addons yet.</li>`;
    addonListEl.querySelectorAll<HTMLButtonElement>("[data-edit-addon]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.editAddon;
        const addon = addons.find((a) => a.id === id);
        if (addon) {
          fillAddonForm(addon);
        }
      });
    });
  }

  async function loadAddons(): Promise<void> {
    try {
      addons = await apiFetch<Addon[]>("/api/addons");
      renderAddonList();
    } catch (err) {
      addonListEl.innerHTML = `<li class="aside">${escapeHtml(statusMessage(err))}</li>`;
    }
  }

  addonForm.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const homepage = addonHomepage.value.trim();
    const body = {
      slug: addonSlug.value.trim(),
      name: addonName.value.trim(),
      summary: addonSummary.value.trim(),
      version: addonVersion.value.trim(),
      download_url: addonDownload.value.trim(),
      homepage_url: homepage.length > 0 ? homepage : undefined,
    };
    addonFormStatus.textContent = "Saving…";
    try {
      if (editingAddonId) {
        await apiFetch(`/api/addons/${editingAddonId}`, { method: "PATCH", body: JSON.stringify(body) });
      } else {
        await apiFetch("/api/addons", { method: "POST", body: JSON.stringify(body) });
      }
      resetAddonForm();
      addonFormStatus.textContent = "Saved.";
      await loadAddons();
    } catch (err) {
      addonFormStatus.textContent = statusMessage(err);
    }
  });

  addonResetBtn.addEventListener("click", resetAddonForm);

  addonDeleteBtn.addEventListener("click", async () => {
    if (!editingAddonId || !confirm("Delete this addon?")) {
      return;
    }
    addonFormStatus.textContent = "Deleting…";
    try {
      await apiFetch(`/api/addons/${editingAddonId}`, { method: "DELETE" });
      resetAddonForm();
      addonFormStatus.textContent = "Deleted.";
      await loadAddons();
    } catch (err) {
      addonFormStatus.textContent = statusMessage(err);
    }
  });

  // ——— Members ———
  const memberListEl = requireElement("officer-member-list");

  async function loadMembers(): Promise<void> {
    try {
      const members = await apiFetch<MemberListing[]>("/api/members");
      memberListEl.innerHTML =
        members.length > 0
          ? members
              .map((m) => {
                const tags = [
                  m.is_officer ? "Officer" : null,
                  m.is_guild_member ? null : "Not in the Discord",
                  m.roster_confirmed ? "On the roster" : "Guest",
                ]
                  .filter(Boolean)
                  .join(" · ");
                const label = m.roster_confirmed ? "Remove from roster" : "Confirm in guild";
                return `
        <li class="series-row">
          <div class="raid-row">
            <span>${escapeHtml(m.display_name)} <span class="when">@${escapeHtml(m.username)}</span></span>
            <span class="when">${m.battletag ? escapeHtml(m.battletag) : "No Battle.net linked"}</span>
            <span class="meta">${escapeHtml(tags)}</span>
          </div>
          <button type="button" class="btn-quiet" data-roster="${m.id}" data-confirmed="${m.roster_confirmed}">
            ${label}
          </button>
        </li>`;
              })
              .join("")
          : `<li class="aside">No one has signed in yet.</li>`;
      memberListEl.querySelectorAll<HTMLButtonElement>("[data-roster]").forEach((btn) => {
        btn.addEventListener("click", () => onToggleRoster(btn));
      });
    } catch (err) {
      memberListEl.innerHTML = `<li class="aside">${escapeHtml(statusMessage(err))}</li>`;
    }
  }

  async function onToggleRoster(btn: HTMLButtonElement): Promise<void> {
    const confirmed = btn.dataset.confirmed === "true";
    if (confirmed && !confirm("Remove from the roster? They lose New Arrival and drop back to the Guest Hall.")) {
      return;
    }
    btn.disabled = true;
    try {
      await apiFetch(`/api/members/${btn.dataset.roster}/roster-confirmation`, {
        method: confirmed ? "DELETE" : "PUT",
      });
      await loadMembers();
    } catch (err) {
      btn.disabled = false;
      btn.textContent = statusMessage(err);
    }
  }

  // ——— Gate ———
  async function init(): Promise<void> {
    let me: Me | null = null;
    try {
      me = await apiFetch<Me>("/api/me");
    } catch (err) {
      if (err instanceof ApiError && err.status === 0) {
        statusEl.textContent = statusMessage(err);
      }
      me = null;
    }
    if (!me || !me.is_officer) {
      gateEl.hidden = false;
      return;
    }
    bodyEl.hidden = false;
    resetEventForm();
    resetAddonForm();
    await Promise.all([loadEvents(), loadSeries(), loadAddons(), loadMembers()]);
  }

  init();
</script>
