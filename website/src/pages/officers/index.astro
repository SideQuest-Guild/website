          <option value="" ${signupStateValue(s) === "" ? "selected" : ""}>Not marked</option>
          <option value="came" ${signupStateValue(s) === "came" ? "selected" : ""}>Came</option>
          <option value="no_show" ${signupStateValue(s) === "no_show" ? "selected" : ""}>No-show</option>
        </select>
      </li>`;
  }

  function weekLabel(weekStart: string): string {
    return new Date(`${weekStart}T00:00:00`).toLocaleDateString(undefined, { month: "short", day: "numeric" });
  }
  function wireRecruitRows(container: HTMLElement): void {
    container.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((checkbox) => {
      checkbox.addEventListener("change", () => {
        const row = checkbox.closest("li");
        const select = row?.querySelector<HTMLSelectElement>("select");
        const note = row?.querySelector<HTMLInputElement>('input[type="text"]');
        if (select) {
          select.disabled = !checkbox.checked;
        }
        if (note) {
          note.disabled = !checkbox.checked;
        }
      });
    });
  }
