  // ——— Members (Quest Masters only) ———
  const memberSearch = requireElement<HTMLInputElement>("m-search");
  const memberFilterTabsEl = requireElement("member-filter-tabs");
  const memberCountEl = requireElement("member-count");
  const memberListEl = requireElement("officer-member-list");
  const memberDetailEmpty = requireElement("member-detail-empty");
  const memberDetailBody = requireElement("member-detail-body");

  type MemberFilter = "all" | "guests" | "roster" | "officers" | "linked" | "unlinked-discord";

  let allMembers: GmMember[] = [];
  let memberFilter: MemberFilter = "all";
  let memberQuery = "";
  let selectedMemberId: number | null = null;
  let membersLoaded = false;

  function roleChips(roles: RoleTag[]): string {
    if (roles.length === 0) {
      return `<span class="role-chip">No Discord roles</span>`;
    }
    return roles
      .slice(0, 3)
      .map(
        (r) => `
      <span class="role-chip">
        <span class="role-dot" style="${r.color ? `background:${escapeHtml(r.color)}` : ""}" aria-hidden="true"></span>
        ${escapeHtml(r.name)}
      </span>`,
      )
      .join("");
  }

  function memberTags(m: GmMember): string {
    return [
      m.is_gm ? "Quest Master" : m.is_officer ? "Officer" : null,
      m.is_guild_member ? null : "Not in Discord",
      m.roster_confirmed_at ? "On the roster" : "Guest",
    ]
      .filter(Boolean)
      .join(" · ");
  }

  function matchesMemberFilter(m: GmMember): boolean {
    switch (memberFilter) {
      case "guests":
        return m.roster_confirmed_at === null;
      case "roster":
        return m.roster_confirmed_at !== null;
      case "officers":
        return m.is_officer;
      case "linked":
        return m.battletag !== null;
      case "unlinked-discord":
        return !m.is_guild_member;
      default:
        return true;
    }
  }

  function matchesMemberQuery(m: GmMember): boolean {
    if (memberQuery.length === 0) {
      return true;
    }
    const q = memberQuery.toLowerCase();
    return m.display_name.toLowerCase().includes(q) || (m.battletag ?? "").toLowerCase().includes(q);
  }

  function renderMemberList(): void {
    const rows = allMembers.filter((m) => matchesMemberFilter(m) && matchesMemberQuery(m));
    memberCountEl.textContent = allMembers.length > 0 ? `${rows.length} of ${allMembers.length}` : "";
    memberListEl.innerHTML =
      rows.length > 0
        ? rows
            .map(
              (m) => `
      <li class="row-pair">
        <button type="button" class="roster-row" data-select-member="${m.id}" aria-current="${m.id === selectedMemberId}">
          ${avatarMarkup(m.display_name, m.avatar_url, 40)}
          <span>
            <span class="roster-name">${escapeHtml(m.display_name)}</span>
            <span class="roster-roles">${roleChips(m.roles)}</span>
            <span class="roster-meta">${escapeHtml(memberTags(m))}${m.battletag ? ` · ${escapeHtml(m.battletag)}` : " · No Battle.net linked"}</span>
          </span>
        </button>
        <button
          type="button"
          class="btn-quiet btn-small"
          data-roster="${m.id}"
          data-confirmed="${m.roster_confirmed_at !== null}"
        >
          ${m.roster_confirmed_at ? "Remove from roster" : "Confirm in guild"}
        </button>
      </li>`,
            )
            .join("")
        : `<li class="quest-empty">No members match.</li>`;
    memberListEl.querySelectorAll<HTMLButtonElement>("[data-select-member]").forEach((btn) => {
      btn.addEventListener("click", () => selectMember(Number(btn.dataset.selectMember)));
    });
    memberListEl.querySelectorAll<HTMLButtonElement>("[data-roster]").forEach((btn) => {
      btn.addEventListener("click", () => onToggleRoster(btn));
    });
  }

  async function onToggleRoster(btn: HTMLButtonElement): Promise<void> {
    const confirmed = btn.dataset.confirmed === "true";
    const id = Number(btn.dataset.roster);
    if (confirmed && !confirm("Remove from the roster? They lose New Arrival and drop back to the Guest Hall.")) {
      return;
    }
    btn.disabled = true;
    try {
      await apiFetch(`/api/members/${id}/roster-confirmation`, { method: confirmed ? "DELETE" : "PUT" });
      await loadMembers();
      if (selectedMemberId === id) {
        await loadMemberDetail(id);
      }
    } catch (err) {
      btn.disabled = false;
      btn.textContent = statusMessage(err);
    }
  }

  async function loadMembers(): Promise<void> {
    memberListEl.innerHTML = `<li class="quest-empty">Loading roster…</li>`;
    try {
      allMembers = await apiFetch<GmMember[]>("/api/gm/members");
      renderMemberList();
    } catch (err) {
      memberListEl.innerHTML = `<li class="quest-empty">${escapeHtml(statusMessage(err))}</li>`;
      memberCountEl.textContent = "";
    }
  }

  function signupStatusLabel(s: GmSignup["status"]): string {
    return s === "signed" ? "Going" : s === "tentative" ? "Maybe" : "Can't make it";
  }

  function memberSignupRow(s: GmSignup): string {
    const start = new Date(s.starts_at);
    const roleMark = s.role
      ? `<svg class="ico role-${s.role}" aria-hidden="true"><use href="#i-${s.role}"></use></svg>`
      : `<svg class="ico ico-quest" aria-hidden="true"><use href="#i-quest"></use></svg>`;
    const classText = s.class ? ` · <span class="cls-${s.class}">${escapeHtml(capitalize(s.class))}</span>` : "";
    const statusSuffix =
      s.event_status === "scheduled" ? null : s.event_status === "cancelled" ? "Cancelled" : "Completed";
    const meta = [
      EVENT_KIND_LABELS[s.kind],
      signupStatusLabel(s.status),
      statusSuffix,
      s.comment ? `“${s.comment}”` : null,
    ]
      .filter(Boolean)
      .map((part) => escapeHtml(part as string))
      .join(" · ");
    return `
      <li>
        <a class="quest" href="/events/detail/?id=${s.event_id}">
          ${roleMark}
          <span>
            <span class="quest-name">${escapeHtml(s.title)}${classText}</span>
            <span class="quest-meta">${meta}</span>
          </span>
          <span class="quest-when">${escapeHtml(timeFormat.format(start))}<small>${escapeHtml(dayFormat.format(start))}</small></span>
        </a>
      </li>`;
  }

  function caseQuality(action: string): "common" | "uncommon" | "rare" | "epic" {
    const a = action.toLowerCase();
    if (a.includes("ban")) {
      return "epic";
    }
    if (a.includes("kick")) {
      return "rare";
    }
    if (a.includes("mute") || a.includes("timeout")) {
      return "uncommon";
    }
    return "common";
  }

  function durationText(seconds: number | null): string {
    if (seconds === null) {
      return "";
    }
    if (seconds >= 86400) {
      return `${Math.round(seconds / 86400)}d`;
    }
    if (seconds >= 3600) {
      return `${Math.round(seconds / 3600)}h`;
    }
    if (seconds >= 60) {
      return `${Math.round(seconds / 60)}m`;
    }
    return `${seconds}s`;
  }

  function memberCaseRow(c: GmCase): string {
    const quality = caseQuality(c.action);
    const duration = durationText(c.duration_seconds);
    return `
      <li class="case-row">
        <div class="case-head">
          <span class="case-number">#${c.case_number}</span>
          <span class="case-action" data-quality="${quality}">${escapeHtml(capitalize(c.action))}</span>
          ${duration ? `<span class="case-meta">${escapeHtml(duration)}</span>` : ""}
        </div>
        <p class="case-meta">
          ${escapeHtml(dateFormat.format(new Date(c.created_at)))} · by ${escapeHtml(c.moderator_name ?? c.moderator_id)}
        </p>
        <p class="case-reason${c.reason ? "" : " is-empty"}">${c.reason ? escapeHtml(c.reason) : "No reason given."}</p>
      </li>`;
  }

  function memberStat(label: string, value: string): string {
    return `<div class="member-stat"><span class="member-stat-label">${escapeHtml(label)}</span><span class="member-stat-value">${escapeHtml(value)}</span></div>`;
  }

  function renderMemberDetail(detail: GmMemberDetail): void {
    const m = detail.member;
    const stats = [
      memberStat("First seen", dateFormat.format(new Date(m.first_seen_at))),
      memberStat("Last login", m.last_login_at ? dateFormat.format(new Date(m.last_login_at)) : "Never"),
      memberStat("Level", m.level !== null ? String(m.level) : "—"),
      memberStat("XP", detail.xp !== null ? detail.xp.toLocaleString() : "—"),
      memberStat("Messages", detail.message_count !== null ? detail.message_count.toLocaleString() : "—"),
    ].join("");
    memberDetailBody.innerHTML = `
      <div class="member-detail-head">
        ${avatarMarkup(m.display_name, m.avatar_url, 56)}
        <div>
          <p class="member-detail-name">${escapeHtml(m.display_name)}</p>
          <p class="member-detail-sub">@${escapeHtml(m.username)}${m.battletag ? ` · ${escapeHtml(m.battletag)}` : " · No Battle.net linked"}</p>
          <p class="roster-roles">${roleChips(m.roles)}</p>
        </div>
      </div>
      <div class="member-stats">${stats}</div>
      <h3 class="sub-title">Sign-ups <span class="count">${detail.signups.length}</span></h3>
      <ul class="quest-log" aria-label="Sign-ups">
        ${detail.signups.length > 0 ? detail.signups.map(memberSignupRow).join("") : `<li class="quest-empty">No sign-ups yet.</li>`}
      </ul>
      <h3 class="sub-title">Moderation cases <span class="count">${detail.cases.length}</span></h3>
      <ul class="case-list" aria-label="Moderation cases">
        ${detail.cases.length > 0 ? detail.cases.map(memberCaseRow).join("") : `<li class="quest-empty">No cases.</li>`}
      </ul>`;
  }

  async function loadMemberDetail(id: number): Promise<void> {
    memberDetailEmpty.hidden = true;
    memberDetailBody.hidden = false;
    memberDetailBody.innerHTML = `<p class="aside">Loading…</p>`;
    try {
      const detail = await apiFetch<GmMemberDetail>(`/api/gm/members/${id}`);
      renderMemberDetail(detail);
