    const recruitingForm = requireElement<HTMLFormElement>("recruiting-form");
    const recruitingRoleList = requireElement("recruiting-role-list");
    const recruitingClassList = requireElement("recruiting-class-list");
    const recruitingFormStatus = requireElement("recruiting-form-status");

    recruitingRoleList.innerHTML = ROLES.map((role) => recruitRow("role", role, ROLE_LABELS[role], "")).join("");
    recruitingClassList.innerHTML = CLASSES.map((cls) =>
      recruitRow("class", cls, CLASS_LABELS[cls], `cls-${cls}`),
    ).join("");
    wireRecruitRows(recruitingRoleList);
    wireRecruitRows(recruitingClassList);

    function applyRecruiting(recruiting: Recruiting): void {
      for (const want of recruiting.roles) {
        const checkbox = recruitingRoleList.querySelector<HTMLInputElement>(`input[data-role="${want.role}"]`);
        const select = recruitingRoleList.querySelector<HTMLSelectElement>(`select[data-role-priority="${want.role}"]`);
        const note = recruitingRoleList.querySelector<HTMLInputElement>(`input[data-role-note="${want.role}"]`);
        if (checkbox) {
          checkbox.checked = true;
        }
        if (select) {
          select.disabled = false;
          select.value = want.priority;
        }
        if (note) {
          note.disabled = false;
          note.value = want.note ?? "";
        }
      }
      for (const want of recruiting.classes) {
        const checkbox = recruitingClassList.querySelector<HTMLInputElement>(`input[data-class="${want.class}"]`);
        const select = recruitingClassList.querySelector<HTMLSelectElement>(
          `select[data-class-priority="${want.class}"]`,
        );
        const note = recruitingClassList.querySelector<HTMLInputElement>(`input[data-class-note="${want.class}"]`);
        if (checkbox) {
          checkbox.checked = true;
        }
        if (select) {
          select.disabled = false;
          select.value = want.priority;
        }
        if (note) {
          note.disabled = false;
          note.value = want.note ?? "";
        }
      }
    }

    async function loadRecruiting(): Promise<void> {
      try {
        applyRecruiting(await apiFetch<Recruiting>("/api/recruiting"));
      } catch (err) {
        recruitingFormStatus.textContent = statusMessage(err);
      }
    }

    recruitingForm.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const roles = ROLES.filter(
        (role) => recruitingRoleList.querySelector<HTMLInputElement>(`input[data-role="${role}"]`)?.checked,
      ).map((role) => ({
        role,
        priority: (recruitingRoleList.querySelector<HTMLSelectElement>(`select[data-role-priority="${role}"]`)?.value ??
          "normal") as RecruitingPriority,
        note:
          recruitingRoleList.querySelector<HTMLInputElement>(`input[data-role-note="${role}"]`)?.value.trim() ||
          undefined,
      }));
      const classes = CLASSES.filter(
        (cls) => recruitingClassList.querySelector<HTMLInputElement>(`input[data-class="${cls}"]`)?.checked,
      ).map((cls) => ({
        class: cls,
        priority: (recruitingClassList.querySelector<HTMLSelectElement>(`select[data-class-priority="${cls}"]`)
          ?.value ?? "normal") as RecruitingPriority,
        note:
          recruitingClassList.querySelector<HTMLInputElement>(`input[data-class-note="${cls}"]`)?.value.trim() ||
          undefined,
      }));
      recruitingFormStatus.textContent = "Saving…";
      try {
        await apiFetch("/api/recruiting", { method: "PUT", body: JSON.stringify({ roles, classes }) });
        recruitingFormStatus.textContent = "Saved.";
      } catch (err) {
        recruitingFormStatus.textContent = statusMessage(err);
      }
    });

    // ——— Members (Quest Masters only) ———
    const memberSearch = requireElement<HTMLInputElement>("m-search");
    const memberFilterTabsEl = requireElement("member-filter-tabs");
    const memberCountEl = requireElement("member-count");
    const memberListEl = requireElement("officer-member-list");
    const memberDetailEmpty = requireElement("member-detail-empty");
    const memberDetailBody = requireElement("member-detail-body");

    type MemberFilter = "all" | "guests" | "roster" | "officers" | "linked" | "unlinked-discord";

    let allMembers: GmMember[] = [];
    let memberFilter: MemberFilter = "all";
    let memberQuery = "";
    let selectedMemberId: number | null = null;
    let membersLoaded = false;

    function matchesMemberFilter(m: GmMember): boolean {
      switch (memberFilter) {
        case "guests":
          return m.roster_confirmed_at === null;
        case "roster":
          return m.roster_confirmed_at !== null;
        case "officers":
          return m.is_officer;
        case "linked":
          return m.battletag !== null;
        case "unlinked-discord":
          return !m.is_guild_member;
        default:
          return true;
      }
    }

    function matchesMemberQuery(m: GmMember): boolean {
      if (memberQuery.length === 0) {
        return true;
      }
      const q = memberQuery.toLowerCase();
      return (
        m.display_name.toLowerCase().includes(q) ||
        m.username.toLowerCase().includes(q) ||
        (m.battletag ?? "").toLowerCase().includes(q)
      );
    }

    function renderMemberList(): void {
      const rows = allMembers.filter((m) => matchesMemberFilter(m) && matchesMemberQuery(m));
      memberCountEl.textContent = allMembers.length > 0 ? `${rows.length} of ${allMembers.length}` : "";
      memberListEl.innerHTML =
        rows.length > 0
          ? rows
              .map(
                (m) => `
      <li class="row-pair">
        <button type="button" class="roster-row" data-select-member="${m.id}" aria-current="${m.id === selectedMemberId}">
          ${avatarMarkup(m.display_name, m.avatar_url, 40)}
          <span>
            <span class="roster-name">${escapeHtml(m.display_name)}<span class="roster-username">@${escapeHtml(m.username)}</span></span>
            <span class="roster-roles">${roleChips(m.roles)}</span>
            <span class="roster-meta">${escapeHtml(memberTags(m))}${m.battletag ? ` · ${escapeHtml(m.battletag)}` : " · No Battle.net linked"}</span>
          </span>
        </button>
        <button
          type="button"
          class="btn-quiet btn-small"
          data-roster="${m.id}"
          data-confirmed="${m.roster_confirmed_at !== null}"
        >
          ${m.roster_confirmed_at ? "Remove from roster" : "Confirm in guild"}
        </button>
      </li>`,
              )
              .join("")
          : `<li class="quest-empty">No members match.</li>`;
      memberListEl.querySelectorAll<HTMLButtonElement>("[data-select-member]").forEach((btn) => {
        btn.addEventListener("click", () => selectMember(Number(btn.dataset.selectMember)));
      });
      memberListEl.querySelectorAll<HTMLButtonElement>("[data-roster]").forEach((btn) => {
        btn.addEventListener("click", () => onToggleRoster(btn));
      });
    }

    async function onToggleRoster(btn: HTMLButtonElement): Promise<void> {
      const confirmed = btn.dataset.confirmed === "true";
      const id = Number(btn.dataset.roster);
      if (confirmed && !confirm("Remove from the roster? They lose New Arrival and drop back to the Guest Hall.")) {
        return;
      }
      btn.disabled = true;
      try {
        await apiFetch(`/api/members/${id}/roster-confirmation`, { method: confirmed ? "DELETE" : "PUT" });
        await loadMembers();
        if (selectedMemberId === id) {
          await loadMemberDetail(id);
        }
      } catch (err) {
        btn.disabled = false;
        btn.textContent = statusMessage(err);
      }
    }

    async function loadMembers(): Promise<void> {
      memberListEl.innerHTML = `<li class="quest-empty">Loading roster…</li>`;
      try {
        allMembers = await apiFetch<GmMember[]>("/api/gm/members");
        renderMemberList();
      } catch (err) {
        memberListEl.innerHTML = `<li class="quest-empty">${escapeHtml(statusMessage(err))}</li>`;
        memberCountEl.textContent = "";
      }
    }

    function memberSignupRow(s: GmSignup): string {
      const start = new Date(s.starts_at);
      const roleMark = s.role
        ? `<svg class="ico role-${s.role}" aria-hidden="true"><use href="#i-${s.role}"></use></svg>`
        : `<svg class="ico ico-quest" aria-hidden="true"><use href="#i-quest"></use></svg>`;
      const classText = s.class ? ` · <span class="cls-${s.class}">${escapeHtml(capitalize(s.class))}</span>` : "";
      const statusSuffix =
        s.event_status === "scheduled" ? null : s.event_status === "cancelled" ? "Cancelled" : "Completed";
      const meta = [
        EVENT_KIND_LABELS[s.kind],
        signupStatusLabel(s.status),
        statusSuffix,
        s.comment ? `“${s.comment}”` : null,
      ]
        .filter(Boolean)
        .map((part) => escapeHtml(part as string))
        .join(" · ");
      return `
      <li>
        <a class="quest" href="/events/detail/?id=${s.event_id}">
          ${roleMark}
          <span>
            <span class="quest-name">${escapeHtml(s.title)}${classText}</span>
            <span class="quest-meta">${meta}</span>
          </span>
          <span class="quest-when">${escapeHtml(timeFormat.format(start))}<small>${escapeHtml(dayFormat.format(start))}</small></span>
        </a>
      </li>`;
    }

    function memberCaseRow(c: GmCase): string {
      const quality = caseQuality(c.action);
      const duration = durationText(c.duration_seconds);
      return `
      <li class="case-row">
        <div class="case-head">
          <span class="case-number">#${c.case_number}</span>
          <span class="case-action" data-quality="${quality}">${escapeHtml(capitalize(c.action))}</span>
          ${duration ? `<span class="case-meta">${escapeHtml(duration)}</span>` : ""}
        </div>
        <p class="case-meta">
          ${escapeHtml(dateFormat.format(new Date(c.created_at)))} · by ${escapeHtml(c.moderator_name ?? c.moderator_id)}
        </p>
        <p class="case-reason${c.reason ? "" : " is-empty"}">${c.reason ? escapeHtml(c.reason) : "No reason given."}</p>
      </li>`;
    }

    function renderMemberDetail(detail: GmMemberDetail): void {
      const m = detail.member;
      const stats = [
        memberStat("First seen", dateFormat.format(new Date(m.first_seen_at))),
        memberStat("Last login", m.last_login_at ? dateFormat.format(new Date(m.last_login_at)) : "Never"),
        memberStat("Level", m.level !== null ? String(m.level) : "—"),
        memberStat("XP", detail.xp !== null ? detail.xp.toLocaleString() : "—"),
        memberStat("Messages", detail.message_count !== null ? detail.message_count.toLocaleString() : "—"),
      ].join("");
      memberDetailBody.innerHTML = `
      <div class="member-detail-head">
        ${avatarMarkup(m.display_name, m.avatar_url, 56)}
        <div>
          <p class="member-detail-name">${escapeHtml(m.display_name)}</p>
          <p class="member-detail-sub">@${escapeHtml(m.username)}${m.battletag ? ` · ${escapeHtml(m.battletag)}` : " · No Battle.net linked"}</p>
          <p class="roster-roles">${roleChips(m.roles)}</p>
        </div>
      </div>
      <div class="member-stats">${stats}</div>
      <h3 class="sub-title">Sign-ups <span class="count">${detail.signups.length}</span></h3>
      <ul class="quest-log" aria-label="Sign-ups">
        ${detail.signups.length > 0 ? detail.signups.map(memberSignupRow).join("") : `<li class="quest-empty">No sign-ups yet.</li>`}
      </ul>
      <h3 class="sub-title">Moderation cases <span class="count">${detail.cases.length}</span></h3>
      <ul class="case-list" aria-label="Moderation cases">
        ${detail.cases.length > 0 ? detail.cases.map(memberCaseRow).join("") : `<li class="quest-empty">No cases.</li>`}
      </ul>`;
    }

    async function loadMemberDetail(id: number): Promise<void> {
      memberDetailEmpty.hidden = true;
      memberDetailBody.hidden = false;
      memberDetailBody.innerHTML = `<p class="aside">Loading…</p>`;
      try {
        const detail = await apiFetch<GmMemberDetail>(`/api/gm/members/${id}`);
        renderMemberDetail(detail);
      } catch (err) {
        memberDetailBody.innerHTML = `<p class="status" data-tone="error">${escapeHtml(statusMessage(err))}</p>`;
      }
    }

    async function selectMember(id: number): Promise<void> {
      selectedMemberId = id;
      renderMemberList();
      await loadMemberDetail(id);
    }

    memberSearch.addEventListener("input", () => {
      memberQuery = memberSearch.value.trim();
      renderMemberList();
    });

    setupTablist(memberFilterTabsEl, (tab) => {
      memberFilter = (tab.dataset.filter ?? "all") as MemberFilter;
      renderMemberList();
    });

    // ——— Guild log (Quest Masters only) ———
    const logFilterTabsEl = requireElement("log-filter-tabs");
    const logTimelineEl = requireElement("log-timeline");
    const logLoadMoreBtn = requireElement<HTMLButtonElement>("log-load-more");

    let logKind = "";
    let logBefore: string | null = null;
    let logEntries: LogEntry[] = [];
    let logLoaded = false;

    function logRow(entry: LogEntry): string {
      const link = entry.event_id
        ? `<a href="/events/detail/?id=${entry.event_id}">${escapeHtml(entry.summary)}</a>`
        : entry.member_id !== null
          ? `<a href="#members" data-jump-member="${entry.member_id}">${escapeHtml(entry.summary)}</a>`
          : escapeHtml(entry.summary);
      return `
      <li class="log-entry">
        ${entry.actor ? avatarMarkup(entry.actor.display_name, entry.actor.avatar_url, 32) : ""}
        <span class="log-entry-body">
          <span class="log-entry-summary">${link}</span>
          ${entry.detail ? `<span class="log-entry-detail">“${escapeHtml(entry.detail)}”</span>` : ""}
        </span>
        <span class="log-entry-when">${escapeHtml(timeFormat.format(new Date(entry.at)))}</span>
      </li>`;
    }

    function renderLog(): void {
      if (logEntries.length === 0) {
        logTimelineEl.innerHTML = `<p class="aside">Nothing recorded yet.</p>`;
        return;
      }
      const groups = new Map<string, LogEntry[]>();
      for (const entry of logEntries) {
        const key = dateFormat.format(new Date(entry.at));
        const bucket = groups.get(key);
        if (bucket) {
          bucket.push(entry);
        } else {
          groups.set(key, [entry]);
        }
      }
      logTimelineEl.innerHTML = Array.from(groups.entries())
        .map(
          ([day, dayEntries]) => `
      <div class="log-day">
        <h3 class="sub-title">${escapeHtml(day)}</h3>
        <ul class="log-list">${dayEntries.map(logRow).join("")}</ul>
      </div>`,
        )
        .join("");
    }

    async function loadLog(reset: boolean): Promise<void> {
      if (reset) {
        logEntries = [];
        logBefore = null;
        logTimelineEl.innerHTML = `<p class="aside">Loading…</p>`;
      }
      const params = new URLSearchParams();
      if (logKind) {
        params.set("kind", logKind);
      }
      if (logBefore) {
        params.set("before", logBefore);
      }
      try {
        const page = await apiFetch<LogPage>(`/api/gm/log?${params.toString()}`);
        logEntries = reset ? page.entries : [...logEntries, ...page.entries];
        logBefore = page.next_before;
        logLoadMoreBtn.hidden = logBefore === null;
        renderLog();
      } catch (err) {
        logTimelineEl.innerHTML = `<p class="status" data-tone="error">${escapeHtml(statusMessage(err))}</p>`;
        logLoadMoreBtn.hidden = true;
      }
    }

    setupTablist(logFilterTabsEl, (tab) => {
      logKind = tab.dataset.kind ?? "";
      loadLog(true);
    });

    logLoadMoreBtn.addEventListener("click", () => loadLog(false));

    logTimelineEl.addEventListener("click", (ev) => {
      const target = (ev.target as HTMLElement).closest<HTMLAnchorElement>("[data-jump-member]");
      if (!target) {
        return;
      }
      ev.preventDefault();
      const memberTab = document.getElementById("tab-members") as HTMLButtonElement | null;
      if (memberTab && !memberTab.hidden && tablist) {
        tablist.select(memberTab);
      }
      selectMember(Number(target.dataset.jumpMember));
    });

    // ——— Moderation cases (Quest Masters only) ———
    const caseListEl = requireElement("officer-case-list");

    let cases: GmCase[] = [];
    let editingCaseNumber: number | null = null;
    let casesLoaded = false;

    function caseRow(c: GmCase): string {
      const quality = caseQuality(c.action);
      const duration = durationText(c.duration_seconds);
      const editing = editingCaseNumber === c.case_number;
      return `
      <li class="case-row">
        <div class="case-head">
          <span class="case-number">#${c.case_number}</span>
          <span class="case-action" data-quality="${quality}">${escapeHtml(capitalize(c.action))}</span>
          ${duration ? `<span class="case-meta">${escapeHtml(duration)}</span>` : ""}
        </div>
        <p class="case-meta">
          ${escapeHtml(c.user_name ?? c.user_id)} · ${escapeHtml(dateFormat.format(new Date(c.created_at)))} · by
          ${escapeHtml(c.moderator_name ?? c.moderator_id)}
        </p>
        ${
          editing
            ? `
        <div class="case-edit">
          <textarea class="case-reason-input" maxlength="500" data-case-reason-input>${escapeHtml(c.reason ?? "")}</textarea>
          <p class="status" data-tone="error" data-case-status="${c.case_number}"></p>
          <div class="case-actions">
            <button type="button" class="btn-quiet btn-small" data-save-case="${c.case_number}">Save</button>
            <button type="button" class="btn-quiet btn-small" data-cancel-case="${c.case_number}">Cancel</button>
          </div>
        </div>`
            : `
        <p class="case-reason${c.reason ? "" : " is-empty"}">${c.reason ? escapeHtml(c.reason) : "No reason given."}</p>
        <div class="case-actions">
          <button type="button" class="btn-quiet btn-small" data-edit-case="${c.case_number}">Edit reason</button>
        </div>`
        }
      </li>`;
    }

    function renderCases(): void {
      caseListEl.innerHTML =
        cases.length > 0 ? cases.map(caseRow).join("") : `<li class="quest-empty">No cases yet.</li>`;
      caseListEl.querySelectorAll<HTMLButtonElement>("[data-edit-case]").forEach((btn) => {
        btn.addEventListener("click", () => {
          editingCaseNumber = Number(btn.dataset.editCase);
          renderCases();
        });
      });
      caseListEl.querySelectorAll<HTMLButtonElement>("[data-cancel-case]").forEach((btn) => {
        btn.addEventListener("click", () => {
          editingCaseNumber = null;
          renderCases();
        });
      });
      caseListEl.querySelectorAll<HTMLButtonElement>("[data-save-case]").forEach((btn) => {
        btn.addEventListener("click", () => onSaveCase(btn));
      });
    }

    async function onSaveCase(btn: HTMLButtonElement): Promise<void> {
      const num = Number(btn.dataset.saveCase);
      const row = btn.closest("li");
      const textarea = row?.querySelector<HTMLTextAreaElement>("[data-case-reason-input]");
      const rowStatus = row?.querySelector<HTMLElement>(`[data-case-status="${num}"]`);
      const reason = textarea?.value.trim() ?? "";
      if (reason.length === 0 || reason.length > 500) {
        if (rowStatus) {
          rowStatus.textContent = "Reason must be 1–500 characters.";
        }
        return;
      }
      btn.disabled = true;
      try {
        const updated = await apiFetch<GmCase>(`/api/gm/cases/${num}`, {
          method: "PATCH",
          body: JSON.stringify({ reason }),
        });
        cases = cases.map((c) => (c.case_number === num ? updated : c));
        editingCaseNumber = null;
        renderCases();
      } catch (err) {
        if (rowStatus) {
          rowStatus.textContent = statusMessage(err);
        }
        btn.disabled = false;
      }
    }

    async function loadCases(): Promise<void> {
      caseListEl.innerHTML = `<li class="quest-empty">Loading…</li>`;
      try {
        cases = await apiFetch<GmCase[]>("/api/gm/cases");
        renderCases();
      } catch (err) {
        caseListEl.innerHTML = `<li class="quest-empty">${escapeHtml(statusMessage(err))}</li>`;
      }
    }

    // ——— Attendance ———
    const attendanceEventListEl = requireElement("attendance-event-list");
    const attendanceEmptyEl = requireElement("attendance-empty");
    const attendanceFormEl = requireElement<HTMLFormElement>("attendance-form");
    const attendanceSignupListEl = requireElement("attendance-signup-list");
    const attendanceWalkinMemberEl = requireElement<HTMLSelectElement>("attendance-walkin-member");
    const attendanceWalkinCharacterField = requireElement("attendance-walkin-character-field");
    const attendanceWalkinCharacterEl = requireElement<HTMLInputElement>("attendance-walkin-character");
    const attendanceWalkinClassField = requireElement("attendance-walkin-class-field");
    const attendanceWalkinClassEl = requireElement<HTMLSelectElement>("attendance-walkin-class");
    const attendanceWalkinRoleField = requireElement("attendance-walkin-role-field");
    const attendanceWalkinRoleEl = requireElement<HTMLSelectElement>("attendance-walkin-role");
    const attendanceWalkinAddBtn = requireElement<HTMLButtonElement>("attendance-walkin-add");
    const attendanceWalkinListEl = requireElement("attendance-walkin-list");
    const attendanceFormStatusEl = requireElement("attendance-form-status");
    const attendanceReportSectionEl = requireElement("attendance-report");
    const attendanceRangeTabsEl = requireElement("attendance-range-tabs");
    const attendanceRaidsOnlyEl = requireElement<HTMLInputElement>("attendance-raids-only");
    const attendanceTrendChartEl = requireElement("attendance-trend-chart");
    const attendanceReportTableEl = requireElement("attendance-report-table");
    const attendanceReportRowsEl = requireElement("attendance-report-rows");

    attendanceWalkinClassEl.innerHTML = CLASSES.map((c) => `<option value="${c}">${capitalize(c)}</option>`).join("");
    attendanceWalkinRoleEl.innerHTML = ROLES.map((r) => `<option value="${r}">${capitalize(r)}</option>`).join("");

    let attendanceEvents: AttendanceEventSummary[] = [];
    let selectedAttendanceEventId: string | null = null;
    let currentAttendanceDetail: AttendanceDetail | null = null;
    let pendingWalkIns: (WalkInCreate & { display_name: string })[] = [];
    let attendanceRange: AttendanceRange = "last_30";
    let attendanceRaidsOnly = false;
    let attendanceReportRows: MemberAttendanceRow[] = [];
    let attendanceSortKey: keyof MemberAttendanceRow = "display_name";
    let attendanceSortDesc = false;

    function attendanceEventRow(e: AttendanceEventSummary): string {
      const start = new Date(e.starts_at);
      const iconClasses = `ico ico-quest${e.needs_attendance ? "" : " is-done"}`;
      const iconId = e.needs_attendance ? "i-quest" : "i-quest-done";
      const marker = e.needs_attendance ? `<span class="attendance-needed">Needs attendance</span>` : "";
      return `
      <li>
        <button type="button" class="quest quest-btn" data-select-attendance-event="${e.id}" aria-current="${e.id === selectedAttendanceEventId}">
          <svg class="${iconClasses}" aria-hidden="true"><use href="#${iconId}"></use></svg>
          <span>
            <span class="quest-name">${escapeHtml(e.title)}</span>
            <span class="quest-meta">${EVENT_KIND_LABELS[e.kind]} · ${start.toLocaleString()}</span>
          </span>
          <span class="quest-when">${marker}</span>
        </button>
      </li>`;
    }

    function renderAttendanceEvents(): void {
      attendanceEventListEl.innerHTML =
        attendanceEvents.length > 0
          ? attendanceEvents.map(attendanceEventRow).join("")
          : `<li class="quest-empty">No past events yet.</li>`;
      attendanceEventListEl.querySelectorAll<HTMLButtonElement>("[data-select-attendance-event]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.dataset.selectAttendanceEvent;
          if (id) {
            void selectAttendanceEvent(id);
          }
        });
      });
    }

    async function loadAttendanceEvents(): Promise<void> {
      attendanceEventListEl.innerHTML = `<li class="quest-empty">Loading…</li>`;
      try {
        attendanceEvents = await apiFetch<AttendanceEventSummary[]>("/api/attendance/events");
        renderAttendanceEvents();
      } catch (err) {
        attendanceEventListEl.innerHTML = `<li class="quest-empty">${escapeHtml(statusMessage(err))}</li>`;
      }
    }

    function renderWalkInCandidates(): void {
      const taken = new Set(pendingWalkIns.map((w) => w.member_id));
      const candidates = (currentAttendanceDetail?.walk_in_candidates ?? []).filter((c) => !taken.has(c.member_id));
      attendanceWalkinMemberEl.innerHTML = candidates
        .map((c) => `<option value="${c.member_id}">${escapeHtml(c.display_name)}</option>`)
        .join("");
      attendanceWalkinAddBtn.disabled = candidates.length === 0;
    }

    function renderPendingWalkIns(): void {
      attendanceWalkinListEl.innerHTML = pendingWalkIns.map(pendingWalkInRow).join("");
      attendanceWalkinListEl.querySelectorAll<HTMLButtonElement>("[data-remove-walkin]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const index = Number(btn.dataset.removeWalkin);
          pendingWalkIns.splice(index, 1);
          renderPendingWalkIns();
          renderWalkInCandidates();
        });
      });
    }

    function renderAttendanceForm(detail: AttendanceDetail): void {
      currentAttendanceDetail = detail;
      pendingWalkIns = [];
      attendanceEmptyEl.hidden = true;
      attendanceFormEl.hidden = false;
      attendanceFormStatusEl.textContent = "";
      const roleKind = (ROLE_KINDS as EventKind[]).includes(detail.event.kind);
      attendanceWalkinCharacterField.hidden = !roleKind;
      attendanceWalkinClassField.hidden = !roleKind;
      attendanceWalkinRoleField.hidden = !roleKind;
      attendanceSignupListEl.innerHTML =
        detail.signups.length > 0
          ? detail.signups.map(attendanceSignupRow).join("")
          : `<li class="roster-empty">No sign-ups for this event.</li>`;
      renderWalkInCandidates();
      renderPendingWalkIns();
    }

    async function selectAttendanceEvent(id: string): Promise<void> {
      selectedAttendanceEventId = id;
      renderAttendanceEvents();
      attendanceEmptyEl.hidden = false;
      attendanceEmptyEl.textContent = "Loading…";
      attendanceFormEl.hidden = true;
      try {
        const detail = await apiFetch<AttendanceDetail>(`/api/events/${id}/attendance`);
        renderAttendanceForm(detail);
      } catch (err) {
        attendanceEmptyEl.textContent = statusMessage(err);
      }
    }

    attendanceWalkinAddBtn.addEventListener("click", () => {
      const memberId = Number(attendanceWalkinMemberEl.value);
      const candidate = currentAttendanceDetail?.walk_in_candidates.find((c) => c.member_id === memberId);
      if (!candidate) {
        return;
      }
      const roleKind = currentAttendanceDetail
        ? (ROLE_KINDS as EventKind[]).includes(currentAttendanceDetail.event.kind)
        : false;
      const character = attendanceWalkinCharacterEl.value.trim() || null;
      const wowClass = (attendanceWalkinClassEl.value || null) as CharClass | null;
      const role = (attendanceWalkinRoleEl.value || null) as Role | null;
      if (roleKind && (!character || !wowClass || !role)) {
        attendanceFormStatusEl.textContent = "Character, class, and role are required for this event's kind.";
        return;
      }
      pendingWalkIns.push({
        member_id: memberId,
        character,
        class: wowClass,
        role,
        display_name: candidate.display_name,
      });
      attendanceWalkinCharacterEl.value = "";
      attendanceFormStatusEl.textContent = "";
      renderPendingWalkIns();
      renderWalkInCandidates();
    });

    attendanceFormEl.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      if (!selectedAttendanceEventId) {
        return;
      }
      const entries = Array.from(attendanceSignupListEl.querySelectorAll<HTMLSelectElement>("[data-signup-id]"))
        .filter((select) => select.value !== "")
        .map((select) => ({ signup_id: select.dataset.signupId!, attended: select.value === "came" }));
      const walkIns: WalkInCreate[] = pendingWalkIns.map(({ display_name: _display_name, ...rest }) => rest);
      const body: AttendanceMark = { entries, walk_ins: walkIns };
      const saveBtn = requireElement<HTMLButtonElement>("attendance-save");
      saveBtn.disabled = true;
      attendanceFormStatusEl.textContent = "Saving…";
      try {
        const detail = await apiFetch<AttendanceDetail>(`/api/events/${selectedAttendanceEventId}/attendance`, {
          method: "PUT",
          body: JSON.stringify(body),
        });
        renderAttendanceForm(detail);
        attendanceFormStatusEl.textContent = "Attendance saved.";
        await loadAttendanceEvents();
        if (isGm) {
          await Promise.all([loadAttendanceReport(), loadAttendanceTrends()]);
        }
      } catch (err) {
        attendanceFormStatusEl.textContent = statusMessage(err);
      } finally {
        saveBtn.disabled = false;
      }
    });

    // ——— Attendance report (GM only) ———
    function sortAttendanceRows(): void {
      attendanceReportRows.sort((a, b) => {
        const av = a[attendanceSortKey];
        const bv = b[attendanceSortKey];
        let cmp = 0;
        if (typeof av === "string" && typeof bv === "string") {
          cmp = av.localeCompare(bv);
        } else if (typeof av === "number" && typeof bv === "number") {
          cmp = av - bv;
        }
        return attendanceSortDesc ? -cmp : cmp;
      });
    }

    function renderAttendanceReportRows(): void {
      sortAttendanceRows();
      attendanceReportRowsEl.innerHTML =
        attendanceReportRows
          .map(
            (r) => `
          <tr>
            <td>${avatarMarkup(r.display_name, r.avatar_url, 28)} ${escapeHtml(r.display_name)}</td>
            <td>${r.signed_up}</td>
            <td>${r.came}</td>
            <td>${r.no_shows}</td>
            <td>${r.walk_ins}</td>
            <td>${Math.round(r.attendance_rate * 100)}%</td>
            <td>${r.last_attended ? new Date(r.last_attended).toLocaleDateString() : "—"}</td>
          </tr>`,
          )
          .join("") || `<tr><td colspan="7" class="aside">No attendance in this range.</td></tr>`;
    }

    async function loadAttendanceReport(): Promise<void> {
      try {
        const params = new URLSearchParams({ window: attendanceRange, raids_only: String(attendanceRaidsOnly) });
        const report = await apiFetch<AttendanceReport>(`/api/attendance/report?${params}`);
        attendanceReportRows = report.rows;
        renderAttendanceReportRows();
      } catch (err) {
        attendanceReportRowsEl.innerHTML = `<tr><td colspan="7" class="aside">${escapeHtml(statusMessage(err))}</td></tr>`;
      }
    }

    function renderTrendChart(points: AttendanceTrendPoint[]): void {
      if (points.length === 0) {
        attendanceTrendChartEl.innerHTML = `<p class="aside">No events in this range yet.</p>`;
        return;
      }
      const width = 600;
      const height = 180;
      const padSide = 24;
      const padTop = 26;
      const padBottom = 32;
      const chartHeight = height - padTop - padBottom;
      const maxAttendees = Math.max(1, ...points.map((p) => p.attendees));
      const maxBarWidth = 48;
      const gap = 16;
      const available = width - padSide * 2;
      const slot = Math.min(maxBarWidth + gap, available / points.length);
      const barWidth = Math.max(4, Math.min(maxBarWidth, slot - gap));
      const rowWidth = points.length * slot - gap;
      const startX = padSide + Math.max(0, (available - rowWidth) / 2);
      const showLine = points.length >= 2;
      const bars = points
        .map((p, i) => {
          const barHeight = (p.attendees / maxAttendees) * chartHeight;
          const x = startX + i * slot + (slot - gap - barWidth) / 2;
          const y = height - padBottom - barHeight;
          return `<rect x="${x}" y="${y}" width="${barWidth}" height="${barHeight}" style="fill:var(--gold-2, #c9a24b)" />`;
        })
        .join("");
      const centerX = (i: number): number => startX + i * slot + (slot - gap) / 2;
      const linePoints = showLine
        ? points.map((p, i) => `${centerX(i)},${height - padBottom - p.show_rate * chartHeight}`).join(" ")
        : "";
      const dots = showLine
        ? points
            .map(
              (p, i) =>
                `<circle cx="${centerX(i)}" cy="${height - padBottom - p.show_rate * chartHeight}" r="3" style="fill:var(--gold, #d8b25c)" />`,
            )
            .join("")
        : "";
      const labels = points
        .map(
          (p, i) =>
            `<text x="${centerX(i)}" y="${height - 10}" text-anchor="middle" font-size="10" style="fill:var(--mist-2, #9aa)">${escapeHtml(weekLabel(p.week_start))}</text>`,
        )
        .join("");
      attendanceTrendChartEl.innerHTML = `
        <svg viewBox="0 0 ${width} ${height}" preserveAspectRatio="xMidYMid meet" style="width:100%;height:180px">
          <text x="${padSide}" y="16" font-size="10" style="fill:var(--mist-2, #9aa)">Max ${maxAttendees} attendee${maxAttendees === 1 ? "" : "s"}</text>
          ${bars}
          ${showLine ? `<polyline points="${linePoints}" fill="none" style="stroke:var(--gold, #d8b25c)" stroke-width="2" />` : ""}
          ${dots}
          ${labels}
        </svg>
        <p class="aside">Bars: distinct attendees per week.${showLine ? " Line: show rate (came ÷ signed up)." : ""}</p>
      `;
    }

    async function loadAttendanceTrends(): Promise<void> {
      try {
        const params = new URLSearchParams({ window: attendanceRange, raids_only: String(attendanceRaidsOnly) });
        const trends = await apiFetch<AttendanceTrends>(`/api/attendance/trends?${params}`);
        renderTrendChart(trends.points);
      } catch (err) {
        attendanceTrendChartEl.innerHTML = `<p class="aside">${escapeHtml(statusMessage(err))}</p>`;
      }
    }

    setupTablist(attendanceRangeTabsEl, (tab) => {
      attendanceRange = (tab.dataset.range ?? "last_30") as AttendanceRange;
      void Promise.all([loadAttendanceReport(), loadAttendanceTrends()]);
    });

    attendanceRaidsOnlyEl.addEventListener("change", () => {
      attendanceRaidsOnly = attendanceRaidsOnlyEl.checked;
      void Promise.all([loadAttendanceReport(), loadAttendanceTrends()]);
    });

    attendanceReportTableEl.querySelectorAll<HTMLTableCellElement>("th[data-sort]").forEach((th) => {
      th.style.cursor = "pointer";
      th.addEventListener("click", () => {
        const key = th.dataset.sort as keyof MemberAttendanceRow;
        attendanceSortDesc = attendanceSortKey === key ? !attendanceSortDesc : false;
        attendanceSortKey = key;
        renderAttendanceReportRows();
      });
    });

    let attendanceLoaded = false;

    async function loadAttendance(): Promise<void> {
      const tasks = [loadAttendanceEvents()];
      if (isGm) {
        attendanceReportSectionEl.hidden = false;
        tasks.push(loadAttendanceReport(), loadAttendanceTrends());
      }
      await Promise.all(tasks);
    }

    // ——— Tabs & gate ———
    const VALID_TABS = ["events", "addons", "recruiting", "attendance", "members", "log", "moderation"] as const;
    const GM_TABS = new Set(["members", "log", "moderation"]);

    let isGm = false;
    let tablist: { select: (tab: HTMLButtonElement, opts?: { focus?: boolean }) => void } | null = null;

    function showPanel(name: string): void {
      document.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach((panel) => {
        panel.hidden = panel.id !== `panel-${name}`;
      });
      if (location.hash.slice(1) !== name) {
        history.replaceState(null, "", `#${name}`);
      }
      if (name === "members" && !membersLoaded) {
        membersLoaded = true;
        loadMembers();
      } else if (name === "log" && !logLoaded) {
        logLoaded = true;
        loadLog(true);
      } else if (name === "moderation" && !casesLoaded) {
        casesLoaded = true;
        loadCases();
      } else if (name === "attendance" && !attendanceLoaded) {
        attendanceLoaded = true;
        void loadAttendance();
      }
    }

    function initialTabName(): string {
      const { tab: requested } = parseHash();
      if ((VALID_TABS as readonly string[]).includes(requested) && (!GM_TABS.has(requested) || isGm)) {
        return requested;
      }
      return "events";
    }

    // ——— Gate ———
    async function init(): Promise<void> {
      let me: Me | null = null;
      try {
        me = await fetchMe();
      } catch (err) {
        if (err instanceof ApiError && err.status === 0) {
          statusEl.textContent = statusMessage(err);
        }
        me = null;
      }
      if (!me || !me.is_officer) {
        gateEl.hidden = false;
        return;
      }
      bodyEl.hidden = false;
      isGm = me.is_gm;
      for (const id of ["tab-members", "tab-log", "tab-moderation"]) {
        requireElement<HTMLButtonElement>(id).hidden = !isGm;
      }
      resetEventForm();
      resetAddonForm();
      const tabsEl = requireElement("officers-body").querySelector<HTMLElement>('[role="tablist"]')!;
      tablist = setupTablist(tabsEl, (tab) => showPanel(tab.id.slice(4)));
      const startMemberId = parseHash().memberId;
      const initialName = initialTabName();
      tablist.select(requireElement<HTMLButtonElement>(`tab-${initialName}`));
      if (initialName === "members" && startMemberId !== null) {
        selectMember(startMemberId);
      }
      window.addEventListener(
        "hashchange",
        () => {
          const { tab: name, memberId } = parseHash();
          if (!(VALID_TABS as readonly string[]).includes(name) || (GM_TABS.has(name) && !isGm)) {
            return;
          }
          const tab = document.getElementById(`tab-${name}`) as HTMLButtonElement | null;
          if (tab && !tab.hidden && tablist) {
            tablist.select(tab);
          }
          if (name === "members" && memberId !== null) {
            selectMember(memberId);
          }
        },
        { signal },
      );
      await Promise.all([loadEvents(), loadSeries(), loadAddons(), loadRecruiting()]);
    }

    void init();
  });
</script>
