---
import Room from "../../layouts/Room.astro";
import roundTable from "../../../assets/rooms/round-table.webp";
import "../../styles/room-officers.css";
---

<Room
  title="Officers · SideQuest"
  description="Officer console: create guild events, manage addons, and — for Quest Masters — run the roster, guild log and moderation case book."
  heading="OFFICERS"
  lede="The round table where officers plan the guild's nights and stock its addons, and the Quest Masters keep its roster and record."
  art={roundTable}
  current="officers"
>
  <p class="status" id="officers-status" role="status" aria-live="polite"></p>

  <div id="officers-gate" hidden>
    <p class="chamber-intro">
      This page is for SideQuest officers. Sign in with Discord on the <a href="/account/">account page</a> if you hold
      an officer role.
    </p>
  </div>

  <div id="officers-body" hidden>
    <div class="tabs" role="tablist" aria-label="Officer console">
      <button type="button" role="tab" id="tab-events" aria-controls="panel-events" aria-selected="true" tabindex="0">
        Events
      </button>
      <button type="button" role="tab" id="tab-addons" aria-controls="panel-addons" aria-selected="false" tabindex="-1">
        Addons
      </button>
      <button
        type="button"
        role="tab"
        id="tab-recruiting"
        aria-controls="panel-recruiting"
        aria-selected="false"
        tabindex="-1"
      >
        Recruiting
      </button>
      <button
        type="button"
        role="tab"
        id="tab-attendance"
        aria-controls="panel-attendance"
        aria-selected="false"
        tabindex="-1"
      >
        Attendance
      </button>
      <button
        type="button"
        role="tab"
        id="tab-members"
        aria-controls="panel-members"
        aria-selected="false"
        tabindex="-1"
        hidden
      >
        Members
      </button>
      <button
        type="button"
        role="tab"
        id="tab-log"
        aria-controls="panel-log"
        aria-selected="false"
        tabindex="-1"
        hidden
      >
        Log
      </button>
      <button
        type="button"
        role="tab"
        id="tab-moderation"
        aria-controls="panel-moderation"
        aria-selected="false"
        tabindex="-1"
        hidden
      >
        Moderation
      </button>
    </div>

    <section id="panel-events" role="tabpanel" aria-labelledby="tab-events" tabindex="0">
      <div class="chamber-pair">
        <form id="event-form" class="chamber form">
          <h2 class="chamber-title">Plan a night</h2>
          <fieldset>
            <legend id="event-form-legend">New event</legend>
            <p class="aside" id="e-series-aside" hidden>
              To change every week, edit the series below.
            </p>
            <div class="form-row">
              <div class="field">
                <label for="e-kind">Kind</label>
                <select id="e-kind" required></select>
              </div>
              <div class="field">
                <label for="e-title">Title</label>
                <input id="e-title" maxlength="80" required />
              </div>
              <div class="field">
                <label for="e-location">Location</label>
                <input id="e-location" maxlength="80" />
              </div>
              <div class="field">
                <label for="e-starts">Start</label>
                <input id="e-starts" type="datetime-local" required />
              </div>
              <div class="field">
                <label for="e-ends">End (optional)</label>
                <input id="e-ends" type="datetime-local" />
              </div>
              <div class="field">
                <label for="e-size">Size (optional)</label>
                <input id="e-size" type="number" min="1" max="40" />
              </div>
              <div class="field" id="e-status-field">
                <label for="e-status">Status</label>
                <select id="e-status">
                  <option value="scheduled">Scheduled</option>
                  <option value="cancelled">Cancelled</option>
                  <option value="completed">Completed</option>
                </select>
              </div>
              <div class="field" id="e-repeats-field">
                <label for="e-repeats">Repeats</label>
                <select id="e-repeats">
                  <option value="">Doesn't repeat</option>
                  <option value="1">Weekly</option>
                  <option value="2">Every 2 weeks</option>
                </select>
              </div>
              <div class="field" id="e-until-field" hidden>
                <label for="e-until">Until (optional)</label>
                <input id="e-until" type="date" />
              </div>
              <div class="field">
                <label for="e-ep">EP</label>
                <input id="e-ep" type="number" min="0" step="1" inputmode="numeric" />
              </div>
            </div>
            <fieldset class="weekday-toggles" id="e-weekdays-fieldset" hidden>
              <legend class="caps">Repeat on</legend>
              <div class="weekday-toggle-grid" id="e-weekday-grid"></div>
            </fieldset>
            <div class="field">
              <label for="e-notes">Notes</label>
              <textarea id="e-notes" rows="2" maxlength="500"></textarea>
            </div>
          </fieldset>
          <div class="form-actions">
            <button type="submit" class="btn" id="event-save">
              Save event
            </button>
            <button type="button" class="btn-quiet" id="event-reset">
              New event
            </button>
            <button type="button" class="btn-quiet btn-danger" id="event-delete" hidden>
              Cancel &amp; delete event
            </button>
          </div>
          <p class="status" id="event-form-status" role="status" aria-live="polite"></p>
          <p class="aside">
            Events are mirrored to the Discord server's Events. Changes here show up in Discord within about 15 seconds;
            events made or edited in Discord appear here too, starting out with kind "Other" until set here. Deleting an
            event in Discord cancels it here and keeps the sign-ups.
          </p>
        </form>
        <div class="chamber">
          <h2 class="chamber-title">Quest board</h2>
          <h3 class="sub-title">Events</h3>
          <ul class="quest-log" id="officer-event-list" aria-label="Existing events"></ul>
          <h3 class="sub-title">Repeating</h3>
          <ul class="quest-log" id="officer-series-list" aria-label="Repeating events"></ul>
        </div>
      </div>
    </section>

    <section id="panel-addons" role="tabpanel" aria-labelledby="tab-addons" tabindex="0" hidden>
      <div class="chamber-pair">
        <form id="addon-form" class="chamber form">
          <h2 class="chamber-title">Addon workshop</h2>
          <fieldset>
            <legend id="addon-form-legend">New addon</legend>
            <div class="form-row">
              <div class="field">
                <label for="a-name">Name</label>
                <input id="a-name" maxlength="80" required />
              </div>
              <div class="field">
                <label for="a-slug">Slug</label>
                <input id="a-slug" pattern="[a-z0-9-]+" maxlength="80" required />
              </div>
              <div class="field">
                <label for="a-version">Version</label>
                <input id="a-version" maxlength="40" required />
              </div>
              <div class="field">
                <label for="a-download">Download URL</label>
                <input id="a-download" type="url" required />
              </div>
              <div class="field">
                <label for="a-homepage">Homepage URL</label>
                <input id="a-homepage" type="url" />
              </div>
              <div class="field">
                <label for="a-origin">Who made it</label>
                <select id="a-origin" required>
                  <option value="guild">Made by SideQuest</option>
                  <option value="community">Community pick</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="a-summary">Summary</label>
              <textarea id="a-summary" rows="2" maxlength="280" required></textarea>
            </div>
          </fieldset>
          <div class="form-actions">
            <button type="submit" class="btn" id="addon-save">
              Save addon
            </button>
            <button type="button" class="btn-quiet" id="addon-reset">
              New addon
            </button>
            <button type="button" class="btn-quiet btn-danger" id="addon-delete" hidden>
              Delete addon
            </button>
          </div>
          <p class="status" id="addon-form-status" role="status" aria-live="polite"></p>
        </form>
        <div class="chamber">
          <h2 class="chamber-title">Addon crate</h2>
          <ul class="item-list" id="officer-addon-list" aria-label="Existing addons"></ul>
        </div>
      </div>
    </section>

    <section id="panel-recruiting" role="tabpanel" aria-labelledby="tab-recruiting" tabindex="0" hidden>
      <form id="recruiting-form" class="chamber form">
        <h2 class="chamber-title">Recruiting needs</h2>
        <p class="aside">
          Pick the roles and classes the guild is looking for. Checked items show on the homepage and in the guild's
          welcome message for new guests, until unchecked here.
        </p>
        <div class="recruit-columns">
          <fieldset>
            <legend class="caps">Roles</legend>
            <ul class="recruit-list" id="recruiting-role-list"></ul>
          </fieldset>
          <fieldset>
            <legend class="caps">Classes</legend>
            <ul class="recruit-list" id="recruiting-class-list"></ul>
          </fieldset>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn" id="recruiting-save">
            Save
          </button>
        </div>
        <p class="status" id="recruiting-form-status" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section id="panel-attendance" role="tabpanel" aria-labelledby="tab-attendance" tabindex="0" hidden>
      <div class="chamber-pair">
        <div class="chamber">
          <h2 class="chamber-title">Past events</h2>
          <p class="aside">
            Events that have happened. A gold quest mark shows the ones still waiting on attendance; a dim one means
            attendance is done.
          </p>
          <ul class="quest-log" id="attendance-event-list" aria-label="Past events"></ul>
        </div>
        <div class="chamber">
          <h2 class="chamber-title">Mark attendance</h2>
          <p class="aside" id="attendance-empty">
            Select an event to take attendance.
          </p>
          <form id="attendance-form" hidden>
            <p class="aside">
              Signed-up members default to Came; tentative and absent members default to not marked, unless they spent
              at least half an hour in voice chat during the event.
            </p>
            <ul class="roster-list" id="attendance-signup-list" aria-label="Sign-ups"></ul>
            <fieldset>
              <legend class="caps">Walk-in</legend>
              <div class="form-row">
                <div class="field">
                  <label for="attendance-walkin-member">Member</label>
                  <select id="attendance-walkin-member"></select>
                </div>
                <div class="field" id="attendance-walkin-character-field" hidden>
                  <label for="attendance-walkin-character">Character</label>
                  <input id="attendance-walkin-character" maxlength="24" />
                </div>
                <div class="field" id="attendance-walkin-class-field" hidden>
                  <label for="attendance-walkin-class">Class</label>
                  <select id="attendance-walkin-class"></select>
                </div>
                <div class="field" id="attendance-walkin-role-field" hidden>
                  <label for="attendance-walkin-role">Role</label>
                  <select id="attendance-walkin-role"></select>
                </div>
              </div>
              <button type="button" class="btn-quiet" id="attendance-walkin-add">
                Add walk-in
              </button>
            </fieldset>
            <ul class="roster-list" id="attendance-walkin-list" aria-label="Walk-ins to add this save"></ul>
            <div class="form-actions">
              <button type="submit" class="btn" id="attendance-save">
                Save attendance
              </button>
            </div>
            <p class="status" id="attendance-form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>

      <div class="chamber" id="attendance-report" hidden>
        <h2 class="chamber-title">Attendance report</h2>
        <p class="aside">Only Quest Masters see this report.</p>
        <div class="tabs" role="tablist" aria-label="Report range" id="attendance-range-tabs">
          <button type="button" role="tab" data-range="last_30" aria-selected="true" tabindex="0">
            Last 30 days
          </button>
          <button type="button" role="tab" data-range="season" aria-selected="false" tabindex="-1">
            This season
          </button>
          <button type="button" role="tab" data-range="all_time" aria-selected="false" tabindex="-1">
            All time
          </button>
        </div>
        <label class="attendance-raids-only">
          <input type="checkbox" id="attendance-raids-only" />
          Raids only
        </label>
        <h3 class="sub-title">Weekly trend</h3>
        <div
          id="attendance-trend-chart"
          class="attendance-trend-chart"
          role="img"
          aria-label="Weekly attendance trend"
        ></div>
        <h3 class="sub-title">By member</h3>
        <div class="attendance-table-wrap">
          <table class="attendance-table" id="attendance-report-table">
            <thead>
              <tr>
                <th scope="col">Member</th>
                <th scope="col" data-sort="signed_up">
                  Signed up
                </th>
                <th scope="col" data-sort="came">
                  Came
                </th>
                <th scope="col" data-sort="no_shows">
                  No-shows
                </th>
                <th scope="col" data-sort="walk_ins">
                  Walk-ins
                </th>
                <th scope="col" data-sort="attendance_rate">
                  Rate
                </th>
                <th scope="col" data-sort="last_attended">
                  Last attended
                </th>
              </tr>
            </thead>
            <tbody id="attendance-report-rows"></tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="panel-members" role="tabpanel" aria-labelledby="tab-members" tabindex="0" hidden>
      <div class="chamber-pair">
        <div class="chamber">
          <h2 class="chamber-title">Roster</h2>
          <p class="aside">
            Match each linked BattleTag against the in-game guild roster, then confirm them: Discord gives them New
            Arrival and opens the member channels within a minute. Until then they only see the Guest Hall.
          </p>
          <div class="field">
            <label for="m-search">Search</label>
            <input id="m-search" type="search" placeholder="Name, username or BattleTag" />
          </div>
          <div class="tabs" role="tablist" aria-label="Filter roster" id="member-filter-tabs">
            <button type="button" role="tab" data-filter="all" aria-selected="true" tabindex="0">
              All
            </button>
            <button type="button" role="tab" data-filter="guests" aria-selected="false" tabindex="-1">
              Guests
            </button>
            <button type="button" role="tab" data-filter="roster" aria-selected="false" tabindex="-1">
              On the roster
            </button>
            <button type="button" role="tab" data-filter="officers" aria-selected="false" tabindex="-1">
              Officers
            </button>
            <button type="button" role="tab" data-filter="linked" aria-selected="false" tabindex="-1">
              Battle.net linked
            </button>
            <button type="button" role="tab" data-filter="unlinked-discord" aria-selected="false" tabindex="-1">
              Not in Discord
            </button>
          </div>
          <p class="count" id="member-count"></p>
          <ul class="roster-list" id="officer-member-list" aria-label="Members"></ul>
        </div>
        <div class="chamber">
          <h2 class="chamber-title">Character sheet</h2>
          <p class="member-detail-empty" id="member-detail-empty">
            Select a member to see their chart.
          </p>
          <div id="member-detail-body" hidden></div>
        </div>
      </div>
    </section>

    <section id="panel-log" role="tabpanel" aria-labelledby="tab-log" tabindex="0" hidden>
      <div class="chamber">
        <h2 class="chamber-title">Guild log</h2>
        <div class="tabs" role="tablist" aria-label="Filter log" id="log-filter-tabs">
          <button type="button" role="tab" data-kind="" aria-selected="true" tabindex="0">
            All
          </button>
          <button type="button" role="tab" data-kind="signup" aria-selected="false" tabindex="-1">
            Sign-ups
          </button>
          <button type="button" role="tab" data-kind="sign_in" aria-selected="false" tabindex="-1">
            Sign-ins
          </button>
          <button type="button" role="tab" data-kind="battlenet" aria-selected="false" tabindex="-1">
            Battle.net
          </button>
          <button type="button" role="tab" data-kind="officer" aria-selected="false" tabindex="-1">
            Officer actions
          </button>
          <button type="button" role="tab" data-kind="moderation" aria-selected="false" tabindex="-1">
            Moderation
          </button>
        </div>
        <div id="log-timeline"></div>
        <p class="chamber-note">
          <button type="button" class="btn-quiet" id="log-load-more" hidden>
            Load older
          </button>
        </p>
      </div>
    </section>

    <section id="panel-moderation" role="tabpanel" aria-labelledby="tab-moderation" tabindex="0" hidden>
      <div class="chamber">
        <h2 class="chamber-title">Moderation cases</h2>
        <ul class="case-list" id="officer-case-list" aria-label="Moderation cases"></ul>
      </div>
    </section>
  </div>

  <noscript>
    <p class="aside">Enable JavaScript to use the officer console.</p>
  </noscript>
</Room>

<script>
  import {
    ApiError,
    apiFetch,
    capitalize,
    fetchMe,
    escapeHtml,
    requireElement,
    statusMessage,
    EVENT_KINDS,
    EVENT_KIND_EP,
    EVENT_KIND_LABELS,
    MAX_EVENT_EP,
    ROLE_KINDS,
    ADDON_ORIGIN_LABELS,
    CLASSES,
    ROLES,
    type Addon,
    type AddonOrigin,
    type EventKind,
    type EventSeriesSummary,
    type EventSummary,
    type GmCase,
    type GmMember,
    type GmMemberDetail,
    type GmSignup,
    type LogEntry,
    type LogPage,
    type Me,
    type Recruiting,
    type RecruitingPriority,
    type Role,
    type CharClass,
    type RoleTag,
    type AttendanceDetail,
    type AttendanceEventSummary,
    type AttendanceMark,
    type AttendanceRange,
    type AttendanceReport,
    type AttendanceSignup,
    type AttendanceTrendPoint,
    type AttendanceTrends,
    type MemberAttendanceRow,
    type WalkInCreate,
  } from "../../scripts/api";
  import { onPage } from "../../scripts/page";
  import { seriesRuleText, weekdayPhrase, WEEKDAY_SHORT_LABELS } from "../../scripts/series";

  function avatarMarkup(name: string, avatarUrl: string | null, size: number): string {
    if (avatarUrl) {
      return `<img class="avatar" width="${size}" height="${size}" style="width:${size}px;height:${size}px" src="${escapeHtml(avatarUrl)}" alt="" />`;
    }
    const initial = escapeHtml(name.trim().charAt(0).toUpperCase() || "?");
    const fontSize = Math.round(size * 0.45);
    return `<span class="avatar" style="width:${size}px;height:${size}px;font-size:${fontSize}px" aria-hidden="true">${initial}</span>`;
  }
  // Generic roving-tabindex tablist: click or arrow-key between the visible tabs, Home/End jump to the ends.
  function setupTablist(
    container: HTMLElement,
    onActivate: (tab: HTMLButtonElement) => void,
  ): { select: (tab: HTMLButtonElement, opts?: { focus?: boolean }) => void } {
    const allTabs = (): HTMLButtonElement[] =>
      Array.from(container.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

    function select(tab: HTMLButtonElement, { focus = false }: { focus?: boolean } = {}): void {
      for (const t of allTabs()) {
        const selected = t === tab;
        t.setAttribute("aria-selected", String(selected));
        t.tabIndex = selected ? 0 : -1;
      }
      if (focus) {
        tab.focus();
      }
      onActivate(tab);
    }

    for (const tab of allTabs()) {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (ev) => {
        const visible = allTabs().filter((t) => !t.hidden);
        const i = visible.indexOf(tab);
        let next = -1;
        if (ev.key === "ArrowRight") {
          next = (i + 1) % visible.length;
        } else if (ev.key === "ArrowLeft") {
          next = (i - 1 + visible.length) % visible.length;
        } else if (ev.key === "Home") {
          next = 0;
        } else if (ev.key === "End") {
          next = visible.length - 1;
        } else {
          return;
        }
        ev.preventDefault();
        select(visible[next], { focus: true });
      });
    }

    return { select };
  }
  function pad(n: number): string {
    return String(n).padStart(2, "0");
  }
  // Quest-giver marks: a gold "!" for an event still open to sign-ups, a dim "?" once it has run.
  function questMark(event: EventSummary): string {
    const open = event.status === "scheduled" && new Date(event.starts_at).getTime() > Date.now();
    return `<svg class="ico ico-quest${open ? "" : " is-done"}" aria-hidden="true"><use href="#${open ? "i-quest" : "i-quest-done"}"></use></svg>`;
  }
  function officerSeriesRow(s: EventSeriesSummary): string {
    const ruleText = seriesRuleText(s.rule, s.next_starts_at);
    const nextText = s.next_starts_at ? new Date(s.next_starts_at).toLocaleDateString() : "No upcoming night";
    return `
      <li class="row-pair">
        <button type="button" class="quest quest-btn" data-edit-series="${s.id}">
          <svg class="ico ico-quest" aria-hidden="true"><use href="#i-quest"></use></svg>
          <span>
            <span class="quest-name">${escapeHtml(EVENT_KIND_LABELS[s.kind])} · ${escapeHtml(ruleText)}</span>
            <span class="quest-meta">${escapeHtml([s.location, `${s.ep} EP`].filter(Boolean).join(" · "))}</span>
          </span>
          <span class="quest-when">${escapeHtml(nextText)}</span>
        </button>
        <button type="button" class="btn-quiet btn-small" data-end-series="${s.id}">End series</button>
      </li>`;
  }
  function officerAddonRow(a: Addon): string {
    return `
      <li>
        <button type="button" class="item-row" data-edit-addon="${a.id}">
          <span class="item-title">${escapeHtml(a.name)}</span>
          <span class="item-meta">v${escapeHtml(a.version)} · ${escapeHtml(a.slug)} · ${escapeHtml(ADDON_ORIGIN_LABELS[a.origin])}</span>
        </button>
      </li>`;
  }
  function roleChips(roles: RoleTag[]): string {
    if (roles.length === 0) {
      return `<span class="role-chip">No Discord roles</span>`;
    }
    return roles
      .slice(0, 3)
      .map(
        (r) => `
      <span class="role-chip">
        <span class="role-dot" style="${r.color ? `background:${escapeHtml(r.color)}` : ""}" aria-hidden="true"></span>
        ${escapeHtml(r.name)}
      </span>`,
      )
      .join("");
  }
  function memberTags(m: GmMember): string {
    return [
      m.is_gm ? "Quest Master" : m.is_officer ? "Officer" : null,
      m.is_guild_member ? null : "Not in Discord",
      m.roster_confirmed_at ? "On the roster" : "Guest",
    ]
      .filter(Boolean)
      .join(" · ");
  }
  function signupStatusLabel(s: GmSignup["status"]): string {
    return s === "signed" ? "Going" : s === "tentative" ? "Maybe" : "Can't make it";
  }
  function caseQuality(action: string): "common" | "uncommon" | "rare" | "epic" {
    const a = action.toLowerCase();
    if (a.includes("ban")) {
      return "epic";
    }
    if (a.includes("kick")) {
      return "rare";
    }
    if (a.includes("mute") || a.includes("timeout")) {
      return "uncommon";
    }
    return "common";
  }
  function durationText(seconds: number | null): string {
    if (seconds === null) {
      return "";
    }
    if (seconds >= 86400) {
      return `${Math.round(seconds / 86400)}d`;
    }
    if (seconds >= 3600) {
      return `${Math.round(seconds / 3600)}h`;
    }
    if (seconds >= 60) {
      return `${Math.round(seconds / 60)}m`;
    }
    return `${seconds}s`;
  }
  function memberStat(label: string, value: string): string {
    return `<div class="member-stat"><span class="member-stat-label">${escapeHtml(label)}</span><span class="member-stat-value">${escapeHtml(value)}</span></div>`;
  }
  function parseHash(): { tab: string; memberId: number | null } {
    const raw = location.hash.slice(1);
    const [tab, query] = raw.split("?");
    let memberId: number | null = null;
    if (query) {
      const value = new URLSearchParams(query).get("member");
      if (value && /^\d+$/.test(value)) {
        memberId = Number(value);
      }
    }
    return { tab: tab ?? "", memberId };
  }
  function localDateTimeInput(iso: string): string {
    const d = new Date(iso);
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  function addMinutesToLocalDateTime(dateStr: string, timeStr: string, minutes: number): string {
    const [y, m, d] = dateStr.split("-").map(Number);
    const [hh, mm] = timeStr.split(":").map(Number);
    const dt = new Date(y ?? 1970, (m ?? 1) - 1, d ?? 1, hh ?? 0, (mm ?? 0) + minutes);
    return `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}T${pad(dt.getHours())}:${pad(dt.getMinutes())}`;
  }
  function recruitRow(kind: "role" | "class", value: string, label: string, colorClass: string): string {
    return `
      <li class="recruit-row">
        <label class="recruit-check">
          <input type="checkbox" data-${kind}="${value}" />
          <span class="${colorClass}">${escapeHtml(label)}</span>
        </label>
        <select data-${kind}-priority="${value}" disabled>
          <option value="normal">Normal</option>
          <option value="high">High priority</option>
        </select>
        <input type="text" data-${kind}-note="${value}" maxlength="140" placeholder="Note (optional)" disabled />
      </li>`;
  }
  function signupStateValue(s: AttendanceSignup): string {
    if (s.attended !== null) {
      return s.attended ? "came" : "no_show";
    }
    return s.suggested_attended ? "came" : "";
  }
  function pendingWalkInRow(w: WalkInCreate & { display_name: string }, index: number): string {
