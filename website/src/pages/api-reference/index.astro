---
// The API reference. Every other inner page opens with a full-bleed painting (src/layouts/Room.astro); a
// technical reference is read, not looked at, and visitors come back to it over and over, so it skips the
// painting and uses the site's own compact header (PageHeader, the same one Room nests under its art) straight
// away, sticky on this page only, so the reference below is never more than a scroll away from the header.
import PageHeader from "../../components/PageHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Site from "../../layouts/Site.astro";
---

<Site
  title="API reference · SideQuest"
  description="The SideQuest API: every route the site, the Discord bot and the in-game addon use, generated from the API's own OpenAPI document."
  ground={false}
>
  <div class="room api-reference-room">
    <PageHeader />
    <main id="top" tabindex="-1" class="room-body wrap api-reference-body">
      <div class="heading">
        <span class="rule" aria-hidden="true"></span>
        <h1>API</h1>
        <span class="rule flip" aria-hidden="true"></span>
      </div>
      <p class="chamber-intro api-reference-intro">
        This is the API behind the SideQuest site, the Discord bot and the in-game addon. Most routes need a signed-in
        Discord session (the cookie you get from the <a href="/account/">account page</a>) or the bot's shared key, sent
        as an <code>X-API-Key</code> header. A few routes, like event listings, are open to anyone. The reference below
        is built from the API's own description, which you can download as{" "}
        <a href="/schema/openapi.json">
          <code>/schema/openapi.json</code>
        </a>
        .
      </p>
      <div id="api-reference-mount" aria-busy="true"></div>
      <p id="api-reference-fallback" class="chamber-intro api-reference-intro" hidden>
        The API reference could not load. Reload the page, or read the raw
        <a href="/schema/openapi.json">OpenAPI document</a>.
      </p>
    </main>
    <SiteFooter />
  </div>
</Site>

<script>
  import "../../scripts/api-reference";
</script>

<style>
  /* This page is long and read in place, so its header stays put instead of scrolling away with the room (every
     other room's header is painted over its art and scrolls with it). `.page-header` is PageHeader's markup, outside
     this page's scoped styles, hence :global; the .api-reference-room parent keeps it to this page. */
  .api-reference-room :global(.page-header) {
    position: sticky;
    top: 0;
    z-index: 20;
    background: linear-gradient(180deg, rgba(10, 15, 26, 0.97), rgba(10, 15, 26, 0.94));
    backdrop-filter: blur(8px);
  }
  .api-reference-room {
    min-height: 100vh;
    background:
      radial-gradient(90rem 50rem at 50% 18rem, rgba(58, 88, 150, 0.2), rgba(58, 88, 150, 0) 70%),
      linear-gradient(180deg, rgba(10, 15, 26, 0.94) 0, rgba(10, 15, 26, 0.86) 55%, rgba(12, 14, 20, 0.92) 100%);
  }
  .api-reference-intro {
    max-width: 60em;
  }
  /* Scalar draws its own three-pane layout and needs the full chamber width, not the prose measure above. */
  #api-reference-mount {
    min-height: 70vh;
    border: 1px solid var(--stone);
  }
  #api-reference-mount:empty::before {
    content: "Loading the reference…";
    display: block;
    padding: clamp(44px, 6vw, 72px) clamp(20px, 3.4vw, 56px);
    color: var(--mist);
    font-size: var(--body);
    text-align: center;
  }
</style>
