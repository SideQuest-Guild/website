---
// The API reference. Every other inner page opens with a full-bleed painting (src/layouts/Room.astro); a
// technical reference is read, not looked at, and visitors come back to it over and over, so it skips the
// painting and uses the site's own compact nav (SiteNav, the same one Room nests under its art) straight
// away, sticky on this page only, so the reference below is never more than a scroll away from the nav.
//
// Scalar draws its own intro, sidebar, content and code columns; this page gives it the full viewport width
// under the nav instead of the site's usual centered `.wrap` measure, and skips the site's own title/intro
// paragraph (Scalar reads its intro from the OpenAPI document's own `info.description`, which
// api/src/sidequest_api/app.py sets). A visually hidden h1 keeps the page accessible and gives it a title
// landmark without drawing one on screen.
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Site from "../../layouts/Site.astro";
---

<Site
  title="API reference · SideQuest"
  description="The SideQuest API: every route the site, the Discord bot and the in-game addon use, generated from the API's own OpenAPI document."
  ground={false}
>
  <div class="room api-reference-room">
    <SiteNav />
    <main id="top" tabindex="-1" class="room-body api-reference-body">
      <h1 class="sr-only">API reference</h1>
      <div id="api-reference-mount" aria-busy="true"></div>
      <p id="api-reference-fallback" class="chamber-intro api-reference-intro" hidden>
        The API reference could not load. Reload the page, or read the raw
        <a href="/schema/openapi.json">OpenAPI document</a>.
      </p>
    </main>
    <SiteFooter />
  </div>
</Site>

<script>
  import "../../scripts/api-reference";
</script>

<style>
  /* This page is long and read in place, so its nav stays put instead of scrolling away with the room (every
     other room's nav is painted over its art and scrolls with it). `.site-nav` is SiteNav's markup, outside
     this page's scoped styles, hence :global; the .api-reference-room parent keeps it to this page. */
  .api-reference-room :global(.site-nav) {
    position: sticky;
    top: 0;
    z-index: 20;
    background: linear-gradient(180deg, rgba(10, 15, 26, 0.97), rgba(10, 15, 26, 0.94));
    backdrop-filter: blur(8px);
  }
  .api-reference-room {
    min-height: 100vh;
    background:
      radial-gradient(90rem 50rem at 50% 18rem, rgba(58, 88, 150, 0.2), rgba(58, 88, 150, 0) 70%),
      linear-gradient(180deg, rgba(10, 15, 26, 0.94) 0, rgba(10, 15, 26, 0.86) 55%, rgba(12, 14, 20, 0.92) 100%);
  }
  /* No `.wrap`: Scalar draws its own three-pane layout and needs the full viewport width, sidebar flush left,
     not the site's centered prose measure. `.room-body`'s own top/bottom rhythm (padding, gap) still applies. */
  .api-reference-body {
    padding-left: 0;
    padding-right: 0;
  }
  .api-reference-intro {
    max-width: 60em;
    margin-inline: clamp(20px, 3.4vw, 56px);
  }
  #api-reference-mount:empty::before {
    content: "Loading the reference…";
    display: block;
    padding: clamp(44px, 6vw, 72px) clamp(20px, 3.4vw, 56px);
    color: var(--mist);
    font-size: var(--body);
    text-align: center;
  }
</style>
