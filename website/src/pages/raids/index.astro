---
import Charter from "../../layouts/Charter.astro";
import Article from "../../components/Article.astro";
import raidHall from "../../../assets/rooms/raid-hall.webp";

const articles = [
  { id: "upcoming", title: "Upcoming raids" },
  { id: "signup", title: "How to sign up" },
  { id: "two-kinds", title: "Two kinds of raid night" },
  { id: "loot", title: "Loot: SQL" },
  { id: "council", title: "The loot council" },
  { id: "trials", title: "Trials and main changes" },
  { id: "casual-loot", title: "Loot: casual and alt nights" },
  { id: "alts", title: "Alts" },
  { id: "attendance", title: "Attendance and Renown" },
  { id: "chart", title: "The raid chart" },
  { id: "before-pull", title: "Before the pull" },
  { id: "faq", title: "FAQ" },
];
---

<Charter
  title="Raiding · SideQuest"
  description="How raiding works at SideQuest: signing up, the two kinds of raid night, SQL (our EPGP and loot council mix), soft reserve, attendance and Renown, the raid chart, and what to bring to the pull."
  heading="RAIDING"
  lede="How raid nights work, from signing up to the loot you walk away with."
  art={raidHall}
  artPosition="50% 55%"
  current="raids"
  chamberTitle="How Raiding Works"
  articles={articles}
>
  <script is:inline slot="head">
    const link = document.createElement("link");
    Object.assign(link, {
      rel: "preload",
      as: "fetch",
      href: "/api/events?when=upcoming&kind=raid",
      crossOrigin: "anonymous",
    });
    document.head.append(link);
  </script>

  <Article id="upcoming" n={1} title="Upcoming raids">
    <ul class="quest-log" id="raids-upcoming" aria-live="polite"></ul>
    <p class="chamber-note aside" id="raids-signup-hint">
      Sign in with Discord on the <a href="/account/">account page</a> to see rosters and sign up.
    </p>
    <noscript>
      <p class="aside">Enable JavaScript to see the upcoming raid schedule here, or check the Discord.</p>
    </noscript>
  </Article>

  <Article id="signup" n={2} title="How to sign up">
    <p>You can sign up for a raid two ways:</p>
    <ul>
      <li>
        On the raid's own page on the site: click through from the <a href="/raids/#upcoming">upcoming list</a> above or
        the <a href="/events/?kind=raid">events page</a> and set your status.
      </li>
      <li>With the Going / Maybe / Can't buttons on the raid's post in the Discord events forum.</li>
    </ul>
    <p>
      Raids need your character, class and role when you sign up. If your plans change, switch to Can't so your spot can
      be filled.
    </p>
    <p>
      Planning to be away? Add the dates on your <a href="/account/">account page</a> and you'll get the Away on a Quest
      role; officers can see who's away right on the raid's event page.
    </p>
    <p>
      Once you're signed up, a private calendar link on your <a href="/account/">account page</a> puts your events and
      sign-ups into Google or Apple Calendar.
    </p>
  </Article>

  <Article id="two-kinds" n={3} title="Two kinds of raid night">
    <ul>
      <li>
        <b>Progression.</b> One 20-player roster raids Hyjal Summit, then splits into two Barrow Deeps 10s. Your sign-up
        picks your Barrow night, and officers balance the two groups by role. Progression is for mains, and its loot
        runs on <a href="/raids/#loot">SQL</a>.
      </li>
      <li>
        <b>Casual and alt nights.</b> Onyxia, alt runs and other casual runs are open to the guild and use
        <a href="/raids/#casual-loot">soft reserve</a>. A future 40-player raid that drops progression gear joins SQL
        instead.
      </li>
    </ul>
    <p>No raid nights are scheduled yet. They go up once enough members have leveled, here and in the Discord.</p>
  </Article>

  <Article id="loot" n={4} title="Loot: SQL">
    <p>
      Progression loot runs on <b>SQL</b>, short for SideQuest Loot and pronounced "
      <a class="easter-egg" href="https://www.youtube.com/shorts/z5p-aMyfT98" target="_blank" rel="noopener noreferrer">
        squeel
      </a>
      ". It's EPGP with a loot council for the biggest drops. You earn EP by showing up, you pay GP when you take gear,
      and your priority is your EP divided by your GP. Everyone starts at 100 GP, and GP never drops below 100.
    </p>
    <p>
      <b>Earning EP</b>
    </p>
    <ul>
      <li>Boss kill: 10.</li>
      <li>A night spent wiping on a boss the group hasn't killed yet: 10, once per boss per night.</li>
      <li>On time at invite: 5.</li>
      <li>Stayed to the end: 5.</li>
      <li>Standby: the same as the raid, as long as you're signed up, online, and can be in within 10 minutes.</li>
    </ul>
    <p>
      <b>Spending GP</b> (main spec; off spec pays 10%)
    </p>
    <ul>
      <li>Head, chest, legs: 100.</li>
      <li>Shoulders, hands, waist, feet: 75.</li>
      <li>Neck, wrist, back, ring, off-hand, shield: 55.</li>
      <li>Trinket: 125.</li>
      <li>One-handed weapon: 150.</li>
      <li>Two-handed weapon or main caster weapon: 200.</li>
      <li>Ranged, wand, relic: 50.</li>
      <li>Tier token: the cost of its slot.</li>
      <li>Chase item: its slot's cost × 1.5.</li>
      <li>Legendary piece: 300.</li>
    </ul>
    <p>
      <b>Who gets each drop</b>
    </p>
    <ul>
      <li>
        Chase items, legendary pieces and crafted tier go to the <a href="/raids/#council">loot council</a>.
      </li>
      <li>Everything else goes to the highest priority among main-spec bids.</li>
      <li>No main-spec bids: the highest priority among off-spec bids, for 10% of the GP.</li>
      <li>No bids at all: an alt filling a slot can take it for free.</li>
      <li>Nobody wants it: it's disenchanted, and the Essence goes to the guild bank for crafted tier.</li>
    </ul>
    <p>
      EP and GP both drop 15% at every weekly reset, so a new raider catches up in about five or six weeks. Ties go to
      the higher EP, then a roll. In week one everyone starts level, so it plays out as main spec, off spec, then rolls;
      priority starts sorting people from week two.
    </p>
    <p>
      Officers record every award and correction with the SideQuest addon, in game, and sync it to the site after the
      raid. Corrections keep their history instead of erasing it.
    </p>
    <p class="chamber-note aside">
      The <a href="/ledger/">Ledger</a> has the live standings, the current loot rules (EP values, GP by slot, decay,
      base GP and off-spec price), recent loot and raid progression.
    </p>
  </Article>

  <Article id="council" n={5} title="The loot council">
    <p>
      The council decides only chase items (each boss has one), legendary pieces and crafted tier. Whoever it picks
      still pays the GP. For crafted tier it checks who can still equip one: you start with one crafted piece allowed,
      and Guardians of Hyjal reputation raises the limit.
    </p>
    <p>
      The council is the raid leader, two officers and one rotating raider. Anyone who wants the item sits that vote
      out, and every decision is posted in #loot-log with a one-line reason.
    </p>
  </Article>

  <Article id="trials" n={6} title="Trials and main changes">
    <ul>
      <li>
        <b>Trials</b> earn EP from their first night. For their first two raid weeks, a full raider's main-spec bid
        beats theirs. After that they're full raiders and keep the EP they earned.
      </li>
      <li>
        <b>Changing your main</b> needs an officer's OK, once per tier unless the officers ask you to. You keep your EP,
        and your GP resets to 100.
      </li>
    </ul>
  </Article>

  <Article id="casual-loot" n={7} title="Loot: casual and alt nights">
    <p>
      Casual and alt nights use soft reserve and never touch SQL. You get one reserve per raid. Every week you reserve
      the same item, show up and miss it, you get +10 on your roll for it. The bonus resets when you win the item or
      skip a week.
    </p>
    <p>
      Progression raiders can't reserve tier on these nights, so nobody gets tier around SQL. Items nobody reserved go
      main spec, then off spec, by roll, and the rest is disenchanted.
    </p>
  </Article>

  <Article id="alts" n={8} title="Alts">
    <p>
      Progression is for mains. An alt can fill a short slot on a progression night: it only gets items no main in the
      raid wants, for free, and your main earns the EP for that night. Bring your alts to alt runs, which use soft
      reserve.
    </p>
  </Article>

  <Article id="attendance" n={9} title="Attendance and Renown">
    <p>
      <b>Renown</b> is the guild's points for showing up to anything, and it's separate from SQL. It's shown on the
      <a href="/heroes/">Hall of Heroes</a> and feeds its leaderboard and badges, not your loot. A raid is worth 10, a
      dungeon 5, leveling 3, PvP 3, a social night 2, transmog 2, and anything else 2. Officers can set a different
      value for a specific event.
    </p>
    <p>
      For attendance itself: officers mark who came, and the bot counts the minutes you spent in the guild's voice
      channels during the event — 30 minutes or more pre-ticks "came" for an officer to confirm. If attendance isn't
      taken for an event, a "Going" sign-up counts as attended.
    </p>
  </Article>

  <Article id="chart" n={10} title="The raid chart">
    <p>
      Officers place everyone who's signed up into groups 1 through 8, or the bench, right on the raid's event page,
      starting from a suggested balanced layout. Check the chart before the pull — you may not be in the group you
      expect.
    </p>
  </Article>

  <Article id="before-pull" n={11} title="Before the pull">
    <p>Show up ready:</p>
    <ul>
      <li>On time.</li>
      <li>Repaired.</li>
      <li>Stocked on consumables.</li>
      <li>
        Running the addons the group asked for — see the <a href="/addons/">addons page</a>.
      </li>
      <li>
        With your lockout free: don't pug Hyjal or Barrow on your main before the guild's run that week, because a pug
        uses up your lockout.
      </li>
    </ul>
  </Article>

  <Article id="faq" n={12} title="FAQ">
    <p>
      <b>Why SQL and not plain EPGP or loot council?</b>
    </p>
    <p>
      EPGP keeps almost every drop mechanical and earned by showing up, so nobody has to trust anyone's judgment. The
      council only handles the few items where one choice moves the whole raid forward.
    </p>

    <p>
      <b>I can't make a raid I signed up for. What do I do?</b>
    </p>
    <p>
      Switch your status to Can't as soon as you know, on the raid's page or in the Discord, so your spot can be filled.
    </p>

    <p>
      <b>What does it mean if I'm on the bench?</b>
    </p>
    <p>
      You're signed up and ready to come in. Standby earns the same EP as the raid, as long as you're online and can be
      in within 10 minutes.
    </p>

    <p>
      <b>Do I need the raid addon to raid?</b>
    </p>
    <p>No. Nobody needs it to raid — it just adds convenience.</p>

    <p>
      <b>Can I bring an alt to progression night?</b>
    </p>
    <p>Only to fill a short slot. The alt takes items no main wants, for free, and your main earns the night's EP.</p>

    <p>
      <b>Where do I see my SQL standing?</b>
    </p>
    <p>
      On the <a href="/ledger/">Ledger</a>, alongside everyone else's.
    </p>

    <p>
      <b>Where do I see my Renown?</b>
    </p>
    <p>
      On the <a href="/heroes/">Hall of Heroes</a>, alongside your badges.
    </p>

    <p>
      <b>What does Maybe mean when I sign up?</b>
    </p>
    <p>You're not committed either way yet. Switch to Going or Can't once you know, so officers can plan around it.</p>

    <p>
      <b>How is attendance decided if I didn't get marked?</b>
    </p>
    <p>
      The bot counts your voice-channel minutes during the event; 30 minutes or more pre-ticks "came" for an officer to
      confirm. If the event's attendance was never taken, your "Going" sign-up counts as attended on its own.
    </p>

    <p>
      <b>Do casual and alt raids use SQL?</b>
    </p>
    <p>No. They use soft reserve and never change your SQL standing.</p>

    <p>
      <b>What if the game has no master loot?</b>
    </p>
    <p>
      If loot can be traded, one designated looter takes everything and trades it out by SQL. If it can't, every raid
      runs on soft reserve until there's a way to hand out loot.
    </p>

    <p>
      <b>Who decides the raid chart?</b>
    </p>
    <p>
      Officers do, starting from a suggested balanced layout and placing everyone into groups 1-8 or the bench on the
      event page.
    </p>
  </Article>
</Charter>

<script>
  import {
    apiFetch,
    fetchMe,
    onFreshData,
    escapeHtml,
    requireElement,
    statusMessage,
    type EventSummary,
  } from "../../scripts/api";
  import { onPage } from "../../scripts/page";
  import { weekdayPhrase } from "../../scripts/series";

  const RAIDS_PATH = "/api/events?when=upcoming&kind=raid";

  // Quest-giver marks: a gold "!" for an event still open to sign-ups, a dim "?" once it has run.
  function questMark(event: EventSummary): string {
    const open = event.status === "scheduled" && new Date(event.starts_at).getTime() > Date.now();
    return `<svg class="ico ico-quest${open ? "" : " is-done"}" aria-hidden="true"><use href="#${open ? "i-quest" : "i-quest-done"}"></use></svg>`;
  }

  onPage("#raids-upcoming", () => {
    // Only signed-out visitors need telling how to sign up.
    fetchMe().then(
      () => requireElement("raids-signup-hint").setAttribute("hidden", ""),
      () => undefined,
    );

    const dayFormat = new Intl.DateTimeFormat(undefined, { weekday: "short", month: "short", day: "numeric" });
    const timeFormat = new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" });

    function raidRow(event: EventSummary): string {
      const start = new Date(event.starts_at);
      const counts = (() => {
        if (!event.counts) {
          return "";
        }
        const signupCounts = `${event.counts.tank}T · ${event.counts.healer}H · ${event.counts.dps}D${
          event.counts.tentative > 0 ? ` · ${event.counts.tentative} tentative` : ""
        }`;
        return event.counts.interested > 0
          ? `${signupCounts} · ${event.counts.interested} interested on Discord`
          : signupCounts;
      })();
      const statusSuffix =
        event.status === "scheduled" ? "" : ` · ${event.status === "cancelled" ? "Cancelled" : "Completed"}`;
      const seriesText = event.series ? weekdayPhrase(event.series.weekdays, event.series.interval_weeks) : "";
      const meta = [event.location, seriesText, counts].filter(Boolean).join(" · ");
      return `
      <li>
        <a class="quest" href="/events/detail/?id=${event.id}">
          ${questMark(event)}
          <span>
            <span class="quest-name">${escapeHtml(event.title)}${escapeHtml(statusSuffix)}</span>
            <span class="quest-meta">${escapeHtml(meta)}</span>
          </span>
          <span class="quest-when">${escapeHtml(timeFormat.format(start))}<small>${escapeHtml(dayFormat.format(start))}</small></span>
        </a>
      </li>`;
    }

    async function loadRaids(): Promise<void> {
      const list = requireElement("raids-upcoming");
      try {
        const raids = await apiFetch<EventSummary[]>(RAIDS_PATH);
        list.innerHTML =
          raids.length > 0
            ? raids.map(raidRow).join("")
            : `<li class="quest-empty">Nothing scheduled yet. Raid nights go up once enough members have leveled — check back here or in the Discord, and add the <a href="/account/">calendar link</a> so you don't miss the post.</li>`;
      } catch (err) {
        list.innerHTML = `<li class="quest-empty">${escapeHtml(statusMessage(err))}</li>`;
      }
    }

    onFreshData(RAIDS_PATH, () => void loadRaids());
    void loadRaids();
  });
</script>
