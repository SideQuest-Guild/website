      d="M12 3l2.5 6.1 6.5.5-5 4.3 1.6 6.3L12 16.9 6.4 20.2 8 13.9l-5-4.3 6.5-.5z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
  </symbol>

  <!-- The nav panel's sigils: one small gold line mark per Raids/Guild entry, same 1.5px stroke as the role marks. -->
  <symbol id="i-nav-raids" viewBox="0 0 24 24">
    <path
      d="M4 5.5c2.4-1.3 5-1.3 8 0 3-1.3 5.6-1.3 8 0v13c-2.4-1.3-5-1.3-8 0-3-1.3-5.6-1.3-8 0z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
    <path d="M12 5.5v13" fill="none" stroke="currentColor" stroke-width="1.5"></path>
  </symbol>
  <symbol id="i-nav-ledger" viewBox="0 0 24 24">
    <ellipse cx="12" cy="7" rx="7" ry="3" fill="none" stroke="currentColor" stroke-width="1.5"></ellipse>
    <path
      d="M5 7v5c0 1.7 3.1 3 7 3s7-1.3 7-3V7M5 12v5c0 1.7 3.1 3 7 3s7-1.3 7-3v-5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    ></path>
  </symbol>
  <symbol id="i-nav-calendar" viewBox="0 0 24 24">
    <rect x="3.5" y="5" width="17" height="15" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
    <path
      d="M3.5 9.5h17M8 3v4M16 3v4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    ></path>
  </symbol>
  <symbol id="i-nav-heroes" viewBox="0 0 24 24">
    <path
      d="M12 3l2.1 4.4 4.9.6-3.5 3.4.9 4.8-4.4-2.3-4.4 2.3.9-4.8-3.5-3.4 4.9-.6z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
  </symbol>
  <symbol id="i-nav-roster" viewBox="0 0 24 24">
    <circle cx="9" cy="8" r="2.6" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <circle cx="16.5" cy="9.5" r="2.1" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="M3.8 20c.5-3.6 2.8-5.6 5.2-5.6s4.4 1.8 5 4.6M14.3 20c.3-2.6 1.8-4.2 3.6-4.2 1.7 0 3.1 1.3 3.6 3.4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    ></path>
  </symbol>
  <symbol id="i-nav-play" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="8.2" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="M15.2 8.8l-2 5-4.6 1.6 2-5z"
      fill="currentColor"
      stroke="currentColor"
      stroke-width="1"
      stroke-linejoin="round"
    ></path>
  </symbol>
  <symbol id="i-nav-rules" viewBox="0 0 24 24">
    <path d="M6 4h9l4 4v12H6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
    <path d="M15 4v4h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
    <path
      d="M8.5 11h7M8.5 14h7M8.5 17h4.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    ></path>
  </symbol>
  <!-- Discord's own mark ("Clyde"), for the nav's external link to the server; solid like a brand mark, not a line icon. -->
  <symbol id="i-discord" viewBox="0 0 24 24">
    <path
      d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286ZM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189Zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
      fill="currentColor"
    ></path>
