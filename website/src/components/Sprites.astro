---
// The site's few drawn marks, referenced with <svg class="ico"><use href="#i-…" /></svg>. Role marks share one
// 1.5px stroke; quest marks are solid like the ones floating over a quest giver.
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <symbol id="i-quest" viewBox="0 0 24 24">
    <path
      d="M9.6 2.5h4.8l-1 12.2h-2.8z"
      fill="currentColor"
      stroke="#1a1306"
      stroke-width="1"
      stroke-linejoin="round"
    ></path>
    <path
      d="M12 16.6l2.4 2.4-2.4 2.4-2.4-2.4z"
      fill="currentColor"
      stroke="#1a1306"
      stroke-width="1"
      stroke-linejoin="round"
    ></path>
  </symbol>
  <symbol id="i-quest-done" viewBox="0 0 24 24">
    <path
      d="M7.2 8.2c0-3.2 2.3-5.6 5.3-5.6 2.9 0 4.9 2 4.9 4.6 0 2.3-1.4 3.4-2.7 4.4-1 .8-1.4 1.3-1.4 2.6v.7h-3.2v-1c0-2.1.9-3.2 2.2-4.2 1-.8 1.7-1.3 1.7-2.4 0-1-.7-1.8-1.6-1.8-1.1 0-1.8.9-1.9 2.7z"
      fill="currentColor"
      stroke="#1a1306"
      stroke-width="1"
      stroke-linejoin="round"
    ></path>
    <path
      d="M11.7 16.8l2.3 2.3-2.3 2.3-2.3-2.3z"
      fill="currentColor"
      stroke="#1a1306"
      stroke-width="1"
      stroke-linejoin="round"
    ></path>
  </symbol>
  <symbol id="i-tank" viewBox="0 0 24 24">
    <path
      d="M12 2.8l7.6 2.6v6c0 4.6-3.2 8-7.6 9.8-4.4-1.8-7.6-5.2-7.6-9.8v-6z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
    <path d="M12 3v18.2M4.6 9.6h14.8" fill="none" stroke="currentColor" stroke-width="1.5"></path>
  </symbol>
  <symbol id="i-healer" viewBox="0 0 24 24">
    <path
      d="M9.5 3.5h5v6h6v5h-6v6h-5v-6h-6v-5h6z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
  </symbol>
  <symbol id="i-dps" viewBox="0 0 24 24">
    <path
      d="M4 3.5l4 .5 11 11M3.5 4l.5 4 11 11M15.5 19.5l4-4M17.5 17.5l2.6 2.6M20 3.5l-4 .5-4.2 4.2M20.5 4l-.5 4-4.2 4.2M8.5 19.5l-4-4M6.5 17.5l-2.6 2.6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </symbol>
  <symbol id="i-badge-first-steps" viewBox="0 0 24 24">
    <ellipse
      cx="8"
      cy="15.5"
      rx="2.6"
      ry="4.6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      transform="rotate(-18 8 15.5)"
    ></ellipse>
    <ellipse
      cx="16"
      cy="8.5"
      rx="2.6"
      ry="4.6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      transform="rotate(18 16 8.5)"
    ></ellipse>
  </symbol>
  <symbol id="i-badge-first-raid" viewBox="0 0 24 24">
    <path
      d="M5 19L19 5M7 19.5l-2.5-2.5M16.5 4.5L19 7"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <path
      d="M19 19L5 5M17 19.5l2.5-2.5M7.5 4.5L5 7"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </symbol>
  <symbol id="i-badge-raid-regular" viewBox="0 0 24 24">
    <path
      d="M12 2.8l7.6 2.6v6c0 4.6-3.2 8-7.6 9.8-4.4-1.8-7.6-5.2-7.6-9.8v-6z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
  </symbol>
  <symbol id="i-badge-raid-veteran" viewBox="0 0 24 24">
    <path
      d="M12 2.8l7.6 2.6v6c0 4.6-3.2 8-7.6 9.8-4.4-1.8-7.6-5.2-7.6-9.8v-6z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
    <path
      d="M12 9l1.4 2.9 3.2.5-2.3 2.2.5 3.2-2.8-1.5-2.8 1.5.5-3.2-2.3-2.2 3.2-.5z"
      fill="currentColor"
      stroke="currentColor"
      stroke-width="0.6"
      stroke-linejoin="round"
    ></path>
  </symbol>
  <symbol id="i-badge-perfect-month" viewBox="0 0 24 24">
    <path
      d="M14.5 3.5a8.5 8.5 0 1 0 6 14.5 7 7 0 0 1-6-14.5z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
  </symbol>
  <symbol id="i-badge-founding-member" viewBox="0 0 24 24">
    <path
      d="M4 21V9h2.5V6.5H9V9h1.5V5H13.5V9H15V6.5h2.5V9H20v12z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
    <path d="M9 21v-6h6v6" fill="none" stroke="currentColor" stroke-width="1.5"></path>
  </symbol>
  <symbol id="i-badge-chatterbox" viewBox="0 0 24 24">
    <path
      d="M4 5h16v11H9l-4 4v-4H4z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
    <path d="M8 9.5h8M8 13h5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
  </symbol>
  <symbol id="i-badge-top-helper" viewBox="0 0 24 24">
    <path
      d="M12 3l2.5 6.1 6.5.5-5 4.3 1.6 6.3L12 16.9 6.4 20.2 8 13.9l-5-4.3 6.5-.5z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
  </symbol>
</svg>
