---
import { Image } from "astro:assets";
import { DISCORD_INVITE } from "../config";
import guildLogo from "../../assets/brand/sidequest-logo.png";

interface Props {
  current?: "events" | "heroes" | "ledger" | "addons" | "officers" | "account" | "raids" | "guild";
}

const { current } = Astro.props;
---

<header class="page-header">
  <a class="page-brand" href="/#top">
    <Image src={guildLogo} width={160} alt="" loading="eager" />
    <span class="wordmark">SIDEQUEST</span>
  </a>
  <nav aria-label="Main">
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="page-nav-list" data-nav-toggle>
      <span class="nav-toggle-bars" aria-hidden="true"></span>
      <span data-nav-label>Menu</span>
    </button>
    <ul class="page-nav" id="page-nav-list">
      <li>
        <a href="/events/" aria-current={current === "events" ? "page" : undefined}>
          Events
        </a>
      </li>
      <li>
        <a href="/raids/" aria-current={current === "raids" ? "page" : undefined}>
          Raids
        </a>
      </li>
      <li>
        <a href="/heroes/" aria-current={current === "heroes" ? "page" : undefined}>
          Heroes
        </a>
      </li>
      <li>
        <a href="/guild/" aria-current={current === "guild" ? "page" : undefined}>
          Guild
        </a>
      </li>
      <li>
        <a href="/ledger/" aria-current={current === "ledger" ? "page" : undefined}>
          Ledger
        </a>
      </li>
      <li>
        <a href="/addons/" aria-current={current === "addons" ? "page" : undefined}>
          Addons
        </a>
      </li>
      <li data-officer-nav>
        <a href="/officers/" aria-current={current === "officers" ? "page" : undefined}>
          Officers
        </a>
      </li>
      <li>
        <a href={DISCORD_INVITE}>Discord</a>
      </li>
      <li>
        <a href="/account/" aria-current={current === "account" ? "page" : undefined}>
          Account
        </a>
      </li>
    </ul>
  </nav>
</header>
