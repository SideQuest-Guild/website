{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": { "browser": true, "es2024": true },
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css",
          "**/scripts/site-chrome",
          "**/scripts/raid-gate",
          "**/scripts/discord-live",
          "**/scripts/charter"
        ]
      }
    ]
  },
  "ignorePatterns": [".impeccable/**", "dist/**", ".astro/**"]
}
