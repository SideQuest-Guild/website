{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": { "browser": true, "es2024": true },
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css",
          "**/scripts/site-chrome",
          "**/scripts/raid-gate",
          "**/scripts/discord-live",
          "**/scripts/discord-online",
          "**/scripts/recruiting-band",
          "**/scripts/charter"
        ]
      }
    ]
  },
  "ignorePatterns": [".impeccable/**", "dist/**", ".astro/**", "test-results/**", "playwright-report/**"],
  "overrides": [
    {
      "files": ["e2e/**", "playwright.config.ts"],
      "env": { "node": true },
      "rules": { "no-await-in-loop": "off" }
    }
  ]
}
