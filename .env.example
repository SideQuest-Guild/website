# --- Discord (prefix DISCORD_)
# Bot token for the "Game Master" application. Locally you can leave this unset and let
# `make bot` read it from the macOS Keychain (service "discord-mcp").
DISCORD_TOKEN=
# Optional: sync slash commands to this guild instantly (SideQuest) instead of globally.
DISCORD_GUILD_ID=1564671275316543508

# --- API (prefix API_)
# Shared secret; the bot sends it as X-API-Key. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me
API_URL=http://localhost:8000
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false

# --- Database (prefix DB_)
DB_URL=postgresql+asyncpg://sidequest:sidequest@localhost:5432/sidequest
DB_ECHO=false

# --- Member hub / website (prefix WEB_)
# Public origin; the Discord OAuth redirect URI is {WEB_BASE_URL}/auth/discord/callback.
WEB_BASE_URL=http://localhost:8000
# 32+ char secret for the encrypted session cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random per-process secret is used (sessions won't survive a restart) and a warning is logged.
WEB_SESSION_SECRET=
# Discord OAuth *app* credentials (separate from DISCORD_TOKEN above). Without both, /auth/discord/login
# returns 503 but the rest of the API still works. Create an app at https://discord.com/developers/applications
# with redirect URI {WEB_BASE_URL}/auth/discord/callback and scopes "identify guilds.members.read".
WEB_DISCORD_CLIENT_ID=
WEB_DISCORD_CLIENT_SECRET=
# Battle.net API client (https://develop.battle.net/access/clients) so members can link their BattleTag.
# Redirect URL: {WEB_BASE_URL}/auth/battlenet/callback. Without both, the "Link Battle.net" button explains it's off.
WEB_BATTLENET_CLIENT_ID=
WEB_BATTLENET_CLIENT_SECRET=
# Guild to check membership/roles against.
WEB_GUILD_ID=1564671275316543508
# Discord role ids (JSON array) whose holders can manage raids/addons, e.g. WEB_OFFICER_ROLE_IDS=[123,456]
WEB_OFFICER_ROLE_IDS=[]
# Set true in production behind HTTPS so the session cookie requires it.
WEB_COOKIE_SECURE=false
